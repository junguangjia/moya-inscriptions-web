# Only synthetic localhost development with compose.dev.yml; not real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
MOYA_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
CMS_INTERNAL_URL=http://127.0.0.1:3002
MOYA_ALLOWED_DEV_ORIGINS=
MOYA_CONTENT_SOURCE=payload
DATABASE_URL=postgresql://yoyi_dev_public:synthetic-local-public-only@127.0.0.1:54330/yoyi_dev
CMS_DATABASE_URL=postgresql://yoyi_dev_payload:synthetic-local-payload-only@127.0.0.1:54330/yoyi_dev
# Community V1 App role (DML-only on the community schema; read by the Backend composition root only)
# and the migration-privileged role used solely by `pnpm db:migrate:community` / `dev:migrate`.
APP_DATABASE_URL=postgresql://yoyi_dev_app:synthetic-local-app-only@127.0.0.1:54330/yoyi_dev
APP_MIGRATION_DATABASE_URL=postgresql://yoyi_dev_owner:synthetic-local-owner-only@127.0.0.1:54330/yoyi_dev
# Local-only credentials for the Owner's community moderation surface in Payload
# Admin. The base URL is dedicated and must stay loopback; the token is
# synthetic. Never reuse either in a shared environment.
COMMUNITY_OPERATOR_BASE_URL=http://127.0.0.1:3001
COMMUNITY_OPERATOR_TOKEN=synthetic-local-community-operator-token-value
OPERATOR_AI_BASE_TOKEN=synthetic-local-operator-ai-base-token-value
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=10000
# No TLS on the loopback-only local container. Optional CA files are unset.
# DATABASE_SSL_CA_FILE=
# CMS_DATABASE_SSL_CA_FILE=
CMS_SECRET=synthetic-local-secret-replace-before-sharing
CMS_ENVIRONMENT=synthetic
CMS_PUBLIC_URL=http://127.0.0.1:3002
CMS_PREVIEW_WEB_URL=http://127.0.0.1:3000
CMS_STORAGE_MODE=local
# Admin and Backend start two directories below the repository root.
CMS_MEDIA_DIR=../../.local/media
PUBLIC_MEDIA_BASE_URL=http://127.0.0.1:3002
# TEST_DATABASE_URL is intentionally absent: never reuse development data for tests.
# Local mode requires no COS_* or CMS_COS_* credentials.
