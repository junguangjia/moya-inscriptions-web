# Include within nginx http {}. All names/paths below are fictional examples.
# Render/validate this template only during separately authorized deployment.
# Fixed classifications omit raw paths/query strings, cookies, tokens and UA text.
limit_req_zone $binary_remote_addr zone=yoyi_analytics:1m rate=30r/m;
map $uri $yoyi_route_class {
    default other;
    / page;
    ~^/admin/analytics-workspace(?:/|$) analytics-workspace;
    ~^/admin(?:/|$) admin;
    ~^/api/community/analytics$ analytics-collection;
    ~^/api/community/notifications/stream$ notification-stream;
    ~^/api/community/notifications(?:/|$) notifications;
    ~^/api/community/auth(?:/|$) authentication;
    ~^/api/community/publishing(?:/|$) publishing;
    ~^/api/community(?:/|$) community;
    ~^/api/catalog(?:/|$) catalog;
    ~^/api/catalog-search$ search;
    ~^/api/ admin-api;
    ~^/(?:_next|admin-assets)(?:/|$) assets;
    ~^/mcp(?:/|$) machine-api;
}
map $http_user_agent $yoyi_client_class {
    default other;
    "" empty;
    ~*(?:playwright|headless|puppeteer) test-like;
    ~*(?:curl|wget|python|node|undici|axios) script-like;
    ~*(?:bot|spider|crawler) crawler-like;
    ~*mozilla browser-like;
}
map $http_cookie $yoyi_device_excluded {
    default 0;
    "~*(^|;[[:space:]]*)moya-analytics-excluded=1(;|$)" 1;
}
# Client class is a heuristic, not proof of the human or AI operator.
# Install the accompanying 7-day logrotate policy before enabling this format.
log_format yoyi_status escape=json '{"at":"$time_iso8601","status":$status,"duration":$request_time,"bytes":$body_bytes_sent,"method":"$request_method","route":"$yoyi_route_class","client":"$yoyi_client_class","device_excluded":$yoyi_device_excluded,"ip":"$remote_addr"}';
# Upload timing (upload-timing-instrumentation-v1): end time, outcome, sizes
# and durations only; never a URI, host, address, header or cookie.
log_format yoyi_upload '$time_iso8601 $msec $status $request_completion $request_length $bytes_sent $request_time $upstream_status $upstream_connect_time $upstream_header_time $upstream_response_time';

upstream yoyi_web { server 127.0.0.1:3000; }
upstream yoyi_backend { server 127.0.0.1:3001; }
upstream yoyi_admin { server 127.0.0.1:3002; }
upstream yoyi_article_authorization { server 127.0.0.1:3003; }

server {
    listen 80 default_server;
    server_name _;
    access_log /var/log/nginx/yoyi-access.log yoyi_status;
    return 404;
}

server {
    listen 443 ssl;
    server_name catalog.example.invalid;
    ssl_certificate /etc/yoyi/tls/fullchain.pem;
    ssl_certificate_key /etc/yoyi/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    if ($host != catalog.example.invalid) { return 421; }
    access_log /var/log/nginx/yoyi-access.log yoyi_status;
    # Request URIs can contain private search text or media capabilities.
    error_log /dev/null;
    add_header Referrer-Policy no-referrer always;

    proxy_http_version 1.1;
    proxy_set_header Host catalog.example.invalid;
    proxy_set_header X-Forwarded-Host catalog.example.invalid;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    # Public clients cannot supply trusted source or relay admission headers.
    proxy_set_header X-Moya-Auth-Ingress "";
    proxy_set_header X-Moya-Client-Ip "";
    proxy_set_header X-Moya-Auth-Relay "";
    proxy_set_header X-Moya-Auth-Source "";
    proxy_set_header X-Moya-Analytics-Ingress "";
    proxy_set_header X-Moya-Analytics-Relay "";
    proxy_set_header X-Moya-Analytics-Source "";
    proxy_set_header X-Moya-Analytics-Excluded "";
    proxy_set_header Forwarded "";
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    # Keep ordinary request bodies bounded; only the named upload/document paths differ.
    client_max_body_size 1m;

    # Only the configured Article audience reaches Backend; internal/operator
    # and generic Admin agent paths remain unexposed.
    location = /mcp/article-authoring {
        proxy_buffering off;
        proxy_cache off;
        proxy_next_upstream off;
        client_max_body_size 1040k;
        proxy_pass http://yoyi_backend;
    }
    location = /.well-known/oauth-protected-resource/mcp/article-authoring {
        proxy_cache off;
        proxy_pass http://yoyi_backend;
    }
    # Shared hostname preserves the existing host-only Payload preview cookie.
    # Preserve native RSC/hash inputs before Payload's separate Next server
    # normalizes them; the Owner-gated proxy restores this fixed header set.
    location ^~ /admin/analytics-workspace {
        proxy_set_header Host catalog.example.invalid;
        proxy_set_header X-Forwarded-Host catalog.example.invalid;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_set_header X-Moya-Umami-Rsc $http_rsc;
        proxy_set_header X-Moya-Umami-Next-Router-State-Tree $http_next_router_state_tree;
        proxy_set_header X-Moya-Umami-Next-Router-Prefetch $http_next_router_prefetch;
        proxy_set_header X-Moya-Umami-Next-Router-Segment-Prefetch $http_next_router_segment_prefetch;
        proxy_set_header X-Moya-Umami-Next-Url $http_next_url;
        proxy_set_header X-Moya-Umami-Rsc-Query $arg__rsc;
        proxy_set_header Rsc "";
        proxy_set_header Next-Router-State-Tree "";
        proxy_set_header Next-Router-Prefetch "";
        proxy_set_header Next-Router-Segment-Prefetch "";
        proxy_set_header Next-Url "";
        proxy_set_header Forwarded "";
        proxy_pass http://yoyi_admin;
    }
    location = /admin { proxy_pass http://yoyi_admin; }
    location ^~ /admin/ { proxy_pass http://yoyi_admin; }
    # The Admin build uses assetPrefix=/admin-assets; preserve Web's /_next assets.
    location ^~ /admin-assets/_next/static/ {
        proxy_pass http://yoyi_admin/_next/static/;
    }
    # Payload owns its native management/preview/media APIs and authorizes access.
    location /api/ {
        client_max_body_size 50m;
        proxy_pass http://yoyi_admin;
    }
    # The approved Web retains all existing Public API forwarding routes.
    location = /api/catalog { proxy_pass http://yoyi_web; }
    location ^~ /api/catalog/ { proxy_pass http://yoyi_web; }
    location = /api/catalog-search { proxy_pass http://yoyi_web; }
    # Dedicated Nginx -> Web proof; only this auth family receives it. Render
    # the marker from protected AUTH_INGRESS_TOKEN during authorized deployment.
    location ^~ /api/community/auth/ {
        proxy_set_header Host catalog.example.invalid;
        proxy_set_header X-Forwarded-Host catalog.example.invalid;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Moya-Auth-Ingress "__AUTH_INGRESS_TOKEN__";
        proxy_set_header X-Moya-Client-Ip $remote_addr;
        proxy_set_header X-Moya-Auth-Relay "";
        proxy_set_header X-Moya-Auth-Source "";
        proxy_set_header X-Moya-Analytics-Ingress "";
        proxy_set_header X-Moya-Analytics-Relay "";
        proxy_set_header X-Moya-Analytics-Source "";
        proxy_set_header X-Moya-Analytics-Excluded "";
        proxy_pass http://yoyi_web;
    }
    # Dedicated analytics ingress proof. Render from private configuration;
    # Web validates it and independently authenticates its Backend relay.
    location = /api/community/analytics {
        limit_req zone=yoyi_analytics burst=10 nodelay;
        limit_req_status 429;
        client_max_body_size 32k;
        proxy_set_header Host catalog.example.invalid;
        proxy_set_header X-Forwarded-Host catalog.example.invalid;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Moya-Auth-Ingress "";
        proxy_set_header X-Moya-Auth-Relay "";
        proxy_set_header X-Moya-Auth-Source "";
        proxy_set_header X-Moya-Analytics-Ingress "__ANALYTICS_INGRESS_TOKEN__";
        proxy_set_header X-Moya-Client-Ip $remote_addr;
        proxy_set_header X-Moya-Analytics-Relay "";
        proxy_set_header X-Moya-Analytics-Source "";
        proxy_set_header X-Moya-Analytics-Excluded "";
        proxy_cache off;
        proxy_read_timeout 5s;
        proxy_pass http://yoyi_web;
    }
    # Profile/avatar/background PNG upload: matches the existing 4 MiB Web/Backend limit.
    location = /api/community/media {
        client_max_body_size 4m;
        proxy_pass http://yoyi_web;
    }
    # Human Article JSON: 1 MiB document plus the existing 16 KiB command envelope.
    location = /api/community/article-authoring {
        client_max_body_size 1040k;
        proxy_pass http://yoyi_web;
    }
    location ^~ /api/community/article-authoring/ {
        client_max_body_size 1040k;
        proxy_pass http://yoyi_web;
    }
    # Notification SSE uses the Web session relay; stream without proxy buffering.
    # Backend keepalives occur every 15 seconds within the existing read timeout.
    location = /api/community/notifications/stream {
        proxy_buffering off;
        proxy_cache off;
        proxy_pass http://yoyi_web;
    }
    # Existing business and auth relays belong to Web, never Payload.
    # Raw component bytes alone use the existing 8 GiB component ceiling. An
    # ordinary prefix (not ^~) lets these exact bounded regex routes win.
    location ~ "^/api/community/publishing/uploads/media-component-[0-9a-f]{32}$" {
        client_max_body_size 8g;
        client_body_timeout 130s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_next_upstream off;
        proxy_send_timeout 130s;
        proxy_read_timeout 75s;
        # A location access_log replaces the server's: keep the status line.
        access_log /var/log/nginx/yoyi-access.log yoyi_status;
        access_log /var/log/nginx/yoyi-upload.log yoyi_upload;
        proxy_pass http://yoyi_web;
    }
    # Private derivative bytes keep Range/status/headers and stream to the viewer.
    location ~ "^/api/community/publishing/media/media-item-[0-9a-f]{32}/(thumb|display|full|cover|motion)/(base|[0-9a-f]{32})$" {
        proxy_buffering off;
        proxy_cache off;
        proxy_next_upstream off;
        proxy_read_timeout 75s;
        proxy_pass http://yoyi_web;
    }
    location /api/community/ { proxy_pass http://yoyi_web; }
    # Includes /editorial-preview/:id and Web assets; draft fetches use loopback CMS_INTERNAL_URL.
    location / { proxy_pass http://yoyi_web; }
}

# Separate cookie host for the existing Article OAuth issuer. Forwarding headers
# are overwritten here; the loopback issuer refuses missing/mismatched values.
server {
    listen 443 ssl;
    server_name article-auth.example.invalid;
    ssl_certificate /etc/yoyi/tls/article-fullchain.pem;
    ssl_certificate_key /etc/yoyi/tls/article-privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    if ($host != article-auth.example.invalid) { return 421; }
    access_log /var/log/nginx/yoyi-article-status.log yoyi_status;
    error_log /dev/null;
    add_header Referrer-Policy no-referrer always;
    client_max_body_size 64k;
    location / {
        proxy_http_version 1.1;
        proxy_set_header Host article-auth.example.invalid;
        proxy_set_header X-Forwarded-Host article-auth.example.invalid;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Moya-Auth-Ingress "";
        proxy_set_header X-Moya-Client-Ip "";
        proxy_set_header X-Moya-Auth-Relay "";
        proxy_set_header X-Moya-Auth-Source "";
        proxy_set_header X-Moya-Analytics-Ingress "";
        proxy_set_header X-Moya-Analytics-Relay "";
        proxy_set_header X-Moya-Analytics-Source "";
        proxy_set_header X-Moya-Analytics-Excluded "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_buffering off;
        proxy_cache off;
        proxy_next_upstream off;
        proxy_pass http://yoyi_article_authorization;
    }
}
