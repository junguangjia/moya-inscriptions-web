# Private copy: /etc/yoyi/backend.env (root-owned, 0600); all provider values fictional.
NODE_ENV=production
# Dedicated Web-to-Backend source admission, separate from Admin/operator keys.
AUTH_SOURCE_RELAY_TOKEN=REPLACE_ME_AUTH_SOURCE_RELAY_TOKEN
HOST=127.0.0.1
PORT=3001
MOYA_CONTENT_SOURCE=payload
DATABASE_URL=postgresql://REPLACE_ME_PUBLIC_READ_ROLE:REPLACE_ME_PASSWORD@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=10000
# Community V1 App role: DML-only on the community schema, distinct from the public read and CMS roles.
# Community migrations run separately with a migration-privileged role (APP_MIGRATION_DATABASE_URL), never at startup.
APP_DATABASE_URL=postgresql://REPLACE_ME_APP_ROLE:REPLACE_ME_PASSWORD@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
# Owner moderation boundary: 32-512 characters, shared only with admin.env and
# rotated together. Leaving it unset keeps the loopback-only /internal/community/*
# subpath closed, so a missing value fails safe.
COMMUNITY_OPERATOR_TOKEN=REPLACE_ME_COMMUNITY_OPERATOR_TOKEN
# Optional custom CA; when omitted TLS uses system CAs. Never disable CA validation.
# DATABASE_SSL_CA_FILE=/etc/yoyi/ca/database-ca.pem
# APP_DATABASE_SSL_CA_FILE=/etc/yoyi/ca/database-ca.pem
CMS_STORAGE_MODE=cos
COS_BUCKET=REPLACE_ME_PRIVATE_BUCKET
COS_REGION=REPLACE_ME_REGION
# Verified custom HTTPS media domain; bind and validate at Stage B.
COS_MEDIA_ORIGIN=https://media.example.invalid
COS_SECRET_ID=REPLACE_ME_BACKEND_READ_SECRET_ID
COS_SECRET_KEY=REPLACE_ME_BACKEND_READ_SECRET_KEY
# Optional short-lived credentials are configured together when used.
# COS_SECURITY_TOKEN=REPLACE_ME_SESSION_TOKEN
# COS_CREDENTIAL_EXPIRES_AT=REPLACE_ME_EXPIRY
COS_SIGNED_URL_TTL_SECONDS=300
COS_REQUEST_TIMEOUT_MS=5000

# Product access (docs/production/closed-beta-access-v1.md). Production must
# name its mode; a missing or unknown value refuses startup instead of opening
# the product. closed-beta admits only the accounts in the allowlist file.
PRODUCT_ACCESS_MODE=closed-beta
# Private JSON owned by the Backend service user, mode 0600, never a symlink:
# {"version":1,"accounts":[{"id":"user-<32 hex>","label":"optional note"}]}.
# Replacing the file takes effect without a restart; while it is missing or
# invalid every account is denied.
PRODUCT_ACCESS_ALLOWLIST_FILE=/etc/yoyi/product-access.json

# Password-only Production profile: no OTP transports or delivery credentials.
# Operator-provisioned handles use normal password login and Sessions.
# To enable a separately authorized delivery profile later, select email-first
# and configure its real provider. Never leave delivery values in password-only.
AUTH_PUBLIC_ENABLED=true
AUTH_PROFILE=password-only
AUTH_EMAIL_PROVIDER=disabled
AUTH_PHONE_PROVIDER=disabled
AUTH_KEY_VERSION=1
AUTH_LOOKUP_KEY=REPLACE_ME_DISTINCT_32_BYTE_BASE64_LOOKUP_KEY
AUTH_ENCRYPTION_KEY=REPLACE_ME_DISTINCT_32_BYTE_BASE64_ENCRYPTION_KEY
AUTH_OTP_KEY=REPLACE_ME_DISTINCT_32_BYTE_BASE64_OTP_KEY
# TENCENT_SES_ENDPOINT=https://ses.tencentcloudapi.com/
# TENCENT_SES_REGION=ap-guangzhou
# TENCENT_SES_FROM=REPLACE_ME_VERIFIED_SENDER@example.invalid
# TENCENT_SES_TEMPLATE_ID=REPLACE_ME_APPROVED_TEMPLATE_ID
# TENCENT_SES_SECRET_ID=REPLACE_ME_SES_SECRET_ID
# TENCENT_SES_SECRET_KEY=REPLACE_ME_SES_SECRET_KEY
# Missing file disables registration only; supplied invalid/private-unreadable material refuses startup.
# Private approved JSON: {"version":"...","title":"...","body":"..."}; not a shipped Development draft.
# AUTH_REGISTRATION_AGREEMENT_FILE=/etc/yoyi/registration-agreement.json
# Optional Aliyun service; enable AUTH_PHONE_PROVIDER=aliyun-dypns only with all approved settings.
# ALIYUN_ACCESS_KEY_ID=REPLACE_ME_DYPNS_ACCESS_KEY_ID
# ALIYUN_ACCESS_KEY_SECRET=REPLACE_ME_DYPNS_ACCESS_KEY_SECRET
# ALIYUN_SMS_SIGN_NAME=REPLACE_ME_APPROVED_SIGN_NAME
# ALIYUN_SMS_TEMPLATE_CODE=REPLACE_ME_APPROVED_TEMPLATE_CODE
# ALIYUN_SMS_SCHEME_NAME=REPLACE_ME_APPROVED_SCHEME_NAME

# B's required private UGC COS namespace. Never use Catalog's read credential here.
WORK_MEDIA_COS_BUCKET=REPLACE_ME_PRIVATE_UGC_BUCKET-1234567890
WORK_MEDIA_COS_REGION=REPLACE_ME_REGION
WORK_MEDIA_COS_PREFIX=ugc/publishing/REPLACE_ME_NAMESPACE/
WORK_MEDIA_COS_SECRET_ID=REPLACE_ME_UGC_SECRET_ID
WORK_MEDIA_COS_SECRET_KEY=REPLACE_ME_UGC_SECRET_KEY
WORK_MEDIA_COS_REQUEST_TIMEOUT_MS=30000
# Temporary COS credentials must include both token and Unix-second expiry (>now+30s).
# WORK_MEDIA_COS_SECURITY_TOKEN=REPLACE_ME_UGC_SECURITY_TOKEN
# WORK_MEDIA_COS_CREDENTIAL_EXPIRES_AT=REPLACE_ME_UNIX_SECONDS
# Media is processed by the separate media worker (media-worker.env); the
# Production Backend opens only the store above and refuses `embedded`.
WORK_MEDIA_WORKER=external
# Rollback-retained: the previous release processes media in the Backend and
# requires these three keys (with its own unit and daemon access); this
# release ignores them.
WORK_MEDIA_TOOLS_IMAGE=REPLACE_ME_LOCAL_REVIEWED_IMAGE:REPLACE_ME_PINNED_TAG
WORK_MEDIA_WORK_DIR=/var/lib/yoyi-backend/publishing-work
WORK_MEDIA_WORKER_CONCURRENCY=1
# WORK_MEDIA_STORE_DIR must be absent. Only the Backend claims staging sweeps.

# Formal Article AI/MCP uses the existing protocol provider and human Session.
ARTICLE_AUTHORING_ENABLED=true
ARTICLE_AUTHORING_ISSUER=https://article-auth.example.invalid
ARTICLE_AUTHORING_RESOURCE=https://catalog.example.invalid/mcp/article-authoring
ARTICLE_AUTHORING_CONSENT_ORIGIN=https://catalog.example.invalid
ARTICLE_AUTHORIZATION_PORT=3003
ARTICLE_AUTHORING_CLIENTS=REPLACE_ME_REVIEWED_EXISTING_CLIENT_REGISTRY_JSON
ARTICLE_AUTHORING_CONTROL_DATABASE_URL=postgresql://REPLACE_ME_ARTICLE_CONTROL_ROLE:REPLACE_ME_PASSWORD@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
# ARTICLE_AUTHORING_CONTROL_DATABASE_SSL_CA_FILE=/etc/yoyi/ca/database-ca.pem
ARTICLE_AUTHORIZATION_DATABASE_TARGET=postgresql://REPLACE_ME_ARTICLE_ISSUER_ROLE@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
CMS_DATABASE_TARGET=postgresql://REPLACE_ME_CMS_ROLE@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
ARTICLE_AUTHORING_WRAPPER_INDEX_KEY=REPLACE_ME_DISTINCT_32_BYTE_BASE64_WRAPPER_INDEX_KEY
ARTICLE_AUTHORING_WRAPPER_SEAL_KEY=REPLACE_ME_DISTINCT_32_BYTE_BASE64_WRAPPER_SEAL_KEY
# Backend receives no issuer DB credential, provider-store key or private signing JWKS.
