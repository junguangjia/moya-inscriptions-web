# Private copy: /etc/yoyi/web.env (root-owned, 0600). Example paths are fictional.
NODE_ENV=production
MOYA_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
CMS_INTERNAL_URL=http://127.0.0.1:3002
# Distinct server-only random base64url credentials (32 or more random bytes).
# Render the first into the protected Nginx ingress header; never Git/log it.
AUTH_INGRESS_TOKEN=REPLACE_ME_AUTH_INGRESS_TOKEN
# Matches Backend AUTH_SOURCE_RELAY_TOKEN; never matches ingress/operator keys.
AUTH_SOURCE_RELAY_TOKEN=REPLACE_ME_AUTH_SOURCE_RELAY_TOKEN
# Web receives HTTP origins and only these narrow ingress credentials;
# never database, CMS signing, operator or COS credentials.
