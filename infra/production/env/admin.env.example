# Private copy: /etc/yoyi/admin.env (root-owned, 0600); all provider values fictional.
NODE_ENV=production
MOYA_CONTENT_SOURCE=payload
CMS_DATABASE_URL=postgresql://REPLACE_ME_CMS_RUNTIME_ROLE:REPLACE_ME_PASSWORD@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
DATABASE_IDLE_TIMEOUT_MS=10000
# Payload keeps its fixed maximum of 5 connections.
# CMS_DATABASE_SSL_CA_FILE=/etc/yoyi/ca/database-ca.pem
CMS_SECRET=REPLACE_ME_WITH_INDEPENDENT_RANDOM_CMS_SECRET
CMS_ENVIRONMENT=production
CMS_PUBLIC_URL=https://catalog.example.invalid
CMS_PREVIEW_WEB_URL=https://catalog.example.invalid
CMS_STORAGE_MODE=cos
CMS_MEDIA_DIR=/var/lib/yoyi-admin/media
# Community V1 moderation: Admin calls the Backend operator boundary over
# loopback and holds the shared operator credential server-side only. The base
# URL is dedicated and must stay loopback; the token matches backend.env and is
# rotated with it. Never expose either to a browser or a public ingress.
COMMUNITY_OPERATOR_BASE_URL=http://127.0.0.1:3001
COMMUNITY_OPERATOR_TOKEN=REPLACE_ME_COMMUNITY_OPERATOR_TOKEN
CMS_COS_ENDPOINT=https://cos.example.invalid
CMS_COS_REGION=REPLACE_ME_REGION
CMS_COS_BUCKET=REPLACE_ME_PRIVATE_BUCKET
CMS_COS_ACCESS_KEY_ID=REPLACE_ME_ADMIN_WRITE_ACCESS_KEY_ID
CMS_COS_SECRET_ACCESS_KEY=REPLACE_ME_ADMIN_WRITE_SECRET_ACCESS_KEY
# Catalog original ingest (catalog-scale-v1 increment 2). off (or absent or
# empty): the /api/editorial/media-ingest/* routes are not composed and answer
# 404; any other value than on (ON, true, a typo) refuses to load the Admin's
# configuration, so neither the Admin nor `payload migrate` starts. Turn on
# only after the Owner steps in infra/production/README.md (S0 checks, CAM
# statement, staging dry run, lifecycle). The upload endpoint is the https origin of the
# public COS API endpoint the staging PUT URLs are signed for (the bucket
# becomes its first host label); verification and the copy use
# CMS_COS_ENDPOINT. It is read only when ingest is on, as are the two on|off
# settings below: server SHA-256 (D9; on, the default; off checks MD5/ETag,
# header and tail only and registers the client's SHA-256 as the
# content-addressed key, so a mismatch found at render leaves the mediaId and
# its editorial/ object occupied: keep it on unless S0 shows a public COS host
# and the Owner accepts that risk, see infra/production/README.md) and the
# staging tag (D8; off, the default, is lifecycle L2; on is L1).
CMS_CATALOG_INGEST=off
# CMS_CATALOG_INGEST_UPLOAD_ENDPOINT=https://cos.REPLACE_ME_REGION.example.invalid
# CMS_CATALOG_INGEST_SERVER_SHA256=on
# CMS_CATALOG_INGEST_STAGING_TAG=off

# Catalog direct publish: off (the default; absent or empty is off) keeps the
# delivery preparation guard, so publishing a record whose editorial/ image has
# no complete published rendition set answers 409
# CATALOG_DELIVERY_PREPARATION_REQUIRED; on publishes it at once, the worker
# renders the published images and the public answer leaves them out until
# they are ready. Any other value refuses to load. A stopgap until the Admin
# has prepare and release controls; Production runs it on from the first
# release whose Admin carries the guard (see infra/production/README.md).
CMS_CATALOG_DIRECT_PUBLISH=off

# Private Umami workspace; dedicated non-admin read-only account, server-side only.
UMAMI_ORIGIN=http://127.0.0.1:3010
UMAMI_WEBSITE_ID=
# ID returned by bootstrap's province/city Board; no fallback to the world map.
UMAMI_BOARD_ID=
UMAMI_VIEWER_USERNAME=
UMAMI_VIEWER_PASSWORD=
