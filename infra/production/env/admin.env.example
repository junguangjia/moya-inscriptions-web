# Private copy: /etc/yoyi/admin.env (root-owned, 0600); all provider values fictional.
NODE_ENV=production
MOYA_CONTENT_SOURCE=payload
CMS_DATABASE_URL=postgresql://REPLACE_ME_CMS_RUNTIME_ROLE:REPLACE_ME_PASSWORD@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
DATABASE_IDLE_TIMEOUT_MS=10000
# Payload keeps its fixed maximum of 5 connections.
# CMS_DATABASE_SSL_CA_FILE=/etc/yoyi/ca/database-ca.pem
CMS_SECRET=REPLACE_ME_WITH_INDEPENDENT_RANDOM_CMS_SECRET
CMS_ENVIRONMENT=production
# Also the one origin /api/mcp accepts when a request carries Origin, and the one
# every login door allow, deny and disconnect is checked against. The MCP key door
# adds no setting here; the Owner issues keys in the Admin. The login door's
# settings are in their own block below.
CMS_PUBLIC_URL=https://catalog.example.invalid
CMS_PREVIEW_WEB_URL=https://catalog.example.invalid
CMS_STORAGE_MODE=cos
CMS_MEDIA_DIR=/var/lib/yoyi-admin/media
# Community V1 moderation: Admin calls the Backend operator boundary over
# loopback and holds the shared operator credential server-side only. The base
# URL is dedicated and must stay loopback; the token matches backend.env and is
# rotated with it. Never expose either to a browser or a public ingress.
COMMUNITY_OPERATOR_BASE_URL=http://127.0.0.1:3001
COMMUNITY_OPERATOR_TOKEN=REPLACE_ME_COMMUNITY_OPERATOR_TOKEN
# Admin MCP's own credential for Catalog thumbnails, Catalog masters and analytics.
# It matches backend.env and is rotated with it. Place it at deployment only once
# the policy text is live. Unset, those tools answer AI_CREDENTIAL_NOT_CONFIGURED;
# they never fall back to the Owner's token above.
# OPERATOR_AI_BASE_TOKEN=REPLACE_ME_OPERATOR_AI_BASE_TOKEN
# Admin MCP's own credential for community routes. It matches backend.env, is rotated
# with it, and is placed only after the Owner has confirmed the policy text is live.
# Unset, community tools answer AI_CREDENTIAL_NOT_CONFIGURED.
# COMMUNITY_OPERATOR_AI_TOKEN=REPLACE_ME_COMMUNITY_OPERATOR_AI_TOKEN
# Admin MCP login door (amendment 2026-11-05): an administrator connects a tool by
# signing in here; the issuer is its own unit with admin-authorization.env. true
# composes the discovery documents, the consent pages and the door for connection
# tokens; false closes the door (and systemctl disable --now the issuer, so a
# reboot does not start it again). A bad value refuses by a bare code on the
# first request that loads the configuration, not at start. Issuer,
# resource, client list and the two wrapper keys equal admin-authorization.env's,
# byte for byte, and the resource is CMS_PUBLIC_URL plus /api/mcp. No
# AGENT_AUTHORIZATION_ENVIRONMENT here: CMS_ENVIRONMENT=production names this
# deployment. AGENT_CONNECTIONS_ENABLED stays unset: that path is Development only.
ADMIN_MCP_OAUTH_ENABLED=true
AGENT_AUTHORIZATION_ISSUER=https://admin-auth.example.invalid
AGENT_AUTHORIZATION_RESOURCE=https://catalog.example.invalid/api/mcp
AGENT_AUTHORIZATION_CLIENTS=[{"clientId":"https://claude.ai/oauth/mcp-oauth-client-metadata","family":"claude","label":"Claude","callbackPolicy":"hosted-https","redirectUris":["https://claude.ai/api/mcp/auth_callback"]},{"clientId":"https://claude.ai/oauth/claude-code-client-metadata","family":"claude-code","label":"Claude Code","callbackPolicy":"loopback-host","redirectUris":["http://localhost:49152/callback","http://127.0.0.1:49152/callback"]},{"clientId":"https://chatgpt.com/oauth/codex/client.json","family":"codex","label":"Codex","callbackPolicy":"loopback-host","redirectUris":["http://127.0.0.1:49152/callback","http://localhost:49152/callback"]},{"clientId":"https://chatgpt.com/oauth/client.json","family":"chatgpt","label":"ChatGPT","callbackPolicy":"hosted-https","redirectUris":["https://chatgpt.com/connector_platform_oauth_redirect"]},{"clientId":"https://cursor.com/oauth/mcp-client.json","family":"cursor","label":"Cursor","callbackPolicy":"loopback-host","redirectUris":["http://localhost:8787/callback","http://127.0.0.1:8787/callback"]}]
# Two roles of the Admin's own for the door, each URL ending in exactly
# ?sslmode=verify-full, and the CA file both pools need: unset, they refuse.
AGENT_CONSENT_DATABASE_URL=postgresql://REPLACE_ME_ADMIN_CONSENT_ROLE:REPLACE_ME_PASSWORD@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
AGENT_RESOURCE_DATABASE_URL=postgresql://REPLACE_ME_ADMIN_RESOURCE_ROLE:REPLACE_ME_PASSWORD@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
AGENT_DATABASE_SSL_CA_FILE=/etc/yoyi/ca/database-ca.pem
AGENT_CONNECTION_WRAPPER_INDEX_KEY=REPLACE_ME_ADMIN_SHARED_32_BYTE_BASE64_WRAPPER_INDEX_KEY
AGENT_CONNECTION_WRAPPER_SEAL_KEY=REPLACE_ME_ADMIN_SHARED_32_BYTE_BASE64_WRAPPER_SEAL_KEY
CMS_COS_ENDPOINT=https://cos.example.invalid
CMS_COS_REGION=REPLACE_ME_REGION
CMS_COS_BUCKET=REPLACE_ME_PRIVATE_BUCKET
CMS_COS_ACCESS_KEY_ID=REPLACE_ME_ADMIN_WRITE_ACCESS_KEY_ID
CMS_COS_SECRET_ACCESS_KEY=REPLACE_ME_ADMIN_WRITE_SECRET_ACCESS_KEY
# Catalog original ingest (catalog-scale-v1 increment 2). off (or absent or
# empty): the /api/editorial/media-ingest/* routes are not composed and answer
# 404; any other value than on (ON, true, a typo) refuses to load the Admin's
# configuration, so neither the Admin nor `payload migrate` starts. Turn on
# only after the Owner steps in infra/production/README.md (S0 checks, CAM
# statement, staging dry run, lifecycle). The upload endpoint is the https origin of the
# public COS API endpoint the staging PUT URLs are signed for (the bucket
# becomes its first host label); verification and the copy use
# CMS_COS_ENDPOINT. It is read only when ingest is on, as are the two on|off
# settings below: server SHA-256 (D9; on, the default; off checks MD5/ETag,
# header and tail only and registers the client's SHA-256 as the
# content-addressed key, so a mismatch found at render leaves the mediaId and
# its editorial/ object occupied: keep it on unless S0 shows a public COS host
# and the Owner accepts that risk, see infra/production/README.md) and the
# staging tag (D8; off, the default, is lifecycle L2; on is L1).
CMS_CATALOG_INGEST=off
# CMS_CATALOG_INGEST_UPLOAD_ENDPOINT=https://cos.REPLACE_ME_REGION.example.invalid
# CMS_CATALOG_INGEST_SERVER_SHA256=on
# CMS_CATALOG_INGEST_STAGING_TAG=off

# Catalog direct publish: off (the default; absent or empty is off) keeps the
# delivery preparation guard, so publishing a record whose editorial/ image has
# no complete published rendition set answers 409
# CATALOG_DELIVERY_PREPARATION_REQUIRED; on publishes it at once, the worker
# renders the published images and the public answer leaves them out until
# they are ready. Any other value refuses to load. A stopgap until the Admin
# has prepare and release controls; Production runs it on from the first
# release whose Admin carries the guard (see infra/production/README.md).
CMS_CATALOG_DIRECT_PUBLISH=off

# Private Umami workspace; dedicated non-admin read-only account, server-side only.
UMAMI_ORIGIN=http://127.0.0.1:3010
UMAMI_WEBSITE_ID=
# ID returned by bootstrap's province/city Board; no fallback to the world map.
UMAMI_BOARD_ID=
UMAMI_VIEWER_USERNAME=
UMAMI_VIEWER_PASSWORD=
