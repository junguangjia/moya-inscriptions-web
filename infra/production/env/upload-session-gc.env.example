# Dedicated root-owned 0600 maintenance configuration; fictional values only.
# Same PostgreSQL DATABASE as Admin, so transaction advisory locks coordinate.
# The role needs CONNECT and the existing advisory-lock functions, no business writes.
CMS_DATABASE_URL=postgresql://REPLACE_ME_MAINTENANCE_ROLE:REPLACE_ME_PASSWORD@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
# CMS_DATABASE_SSL_CA_FILE=/etc/yoyi/ca/database-ca.pem
CMS_MEDIA_DIR=/var/lib/yoyi-admin/media
