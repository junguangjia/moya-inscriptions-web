# Private copy /etc/yoyi/article-authorization.env; root-owned0600. Fictional only.
NODE_ENV=production
ARTICLE_AUTHORING_ENABLED=true
ARTICLE_AUTHORING_ISSUER=https://article-auth.example.invalid
ARTICLE_AUTHORING_RESOURCE=https://catalog.example.invalid/mcp/article-authoring
ARTICLE_AUTHORING_CONSENT_ORIGIN=https://catalog.example.invalid
ARTICLE_AUTHORIZATION_PORT=3003
ARTICLE_AUTHORING_CLIENTS=REPLACE_ME_REVIEWED_EXISTING_CLIENT_REGISTRY_JSON
ARTICLE_AUTHORIZATION_DATABASE_URL=postgresql://REPLACE_ME_ARTICLE_ISSUER_ROLE:REPLACE_ME_PASSWORD@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
# ARTICLE_AUTHORIZATION_DATABASE_SSL_CA_FILE=/etc/yoyi/ca/database-ca.pem
# Metadata has no password and provides no SQL authority. All five roles distinct, same DB.
ARTICLE_AUTHORING_CONTROL_DATABASE_TARGET=postgresql://REPLACE_ME_ARTICLE_CONTROL_ROLE@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
ARTICLE_AUTHORING_RESOURCE_DATABASE_TARGET=postgresql://REPLACE_ME_APP_ROLE@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
CMS_DATABASE_TARGET=postgresql://REPLACE_ME_CMS_ROLE@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
DATABASE_TARGET=postgresql://REPLACE_ME_PUBLIC_READ_ROLE@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
ARTICLE_AUTHORING_PROVIDER_INDEX_KEY=REPLACE_ME_DISTINCT_32_BYTE_BASE64_PROVIDER_INDEX_KEY
ARTICLE_AUTHORING_PROVIDER_SEAL_KEY=REPLACE_ME_DISTINCT_32_BYTE_BASE64_PROVIDER_SEAL_KEY
ARTICLE_AUTHORING_WRAPPER_INDEX_KEY=REPLACE_ME_DISTINCT_32_BYTE_BASE64_WRAPPER_INDEX_KEY
ARTICLE_AUTHORING_WRAPPER_SEAL_KEY=REPLACE_ME_DISTINCT_32_BYTE_BASE64_WRAPPER_SEAL_KEY
ARTICLE_AUTHORING_COOKIE_KEY=REPLACE_ME_DISTINCT_32_BYTE_BASE64URL_COOKIE_KEY
# Dedicated private JWKS, regular nonsymlink file, service-readable0600; never in Git/Web/Backend.
ARTICLE_AUTHORIZATION_SIGNING_JWKS_FILE=/etc/yoyi/article-signing.jwks.json
# Generic Admin agent authorization remains disabled; no Admin keys or DB URL here.
AGENT_AUTHORIZATION_ENABLED=false
