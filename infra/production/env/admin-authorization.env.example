# Private copy /etc/yoyi/admin-authorization.env; root-owned 0600. Fictional only.
# Admin MCP login door issuer (amendment 2026-11-05). Every secret is new for this
# issuer, generated at release, never printed, and equal to no Article value.
# Staged copies get the same change. No Article setting belongs here.
NODE_ENV=production
ADMIN_MCP_OAUTH_ENABLED=true
# A host of its own: never the Article issuer's host, never CMS_PUBLIC_URL's.
AGENT_AUTHORIZATION_ISSUER=https://admin-auth.example.invalid
# CMS_PUBLIC_URL plus /api/mcp, the same value admin.env holds: a tool connects only then.
AGENT_AUTHORIZATION_RESOURCE=https://catalog.example.invalid/api/mcp
# The origin of CMS_PUBLIC_URL: the Admin checks every allow, deny and disconnect against it.
AGENT_AUTHORIZATION_CONSENT_URL=https://catalog.example.invalid
AGENT_AUTHORIZATION_PORT=3004
# Production refuses any other name, so admin.env carries no copy of it.
AGENT_AUTHORIZATION_ENVIRONMENT=production
# The closed list on one line, byte-identical to admin.env. Claude, Claude Code,
# Codex, ChatGPT and Cursor (desktop only), as read from the vendors' documents; a
# loopback entry's port is only what the parser requires.
AGENT_AUTHORIZATION_CLIENTS=[{"clientId":"https://claude.ai/oauth/mcp-oauth-client-metadata","family":"claude","label":"Claude","callbackPolicy":"hosted-https","redirectUris":["https://claude.ai/api/mcp/auth_callback"]},{"clientId":"https://claude.ai/oauth/claude-code-client-metadata","family":"claude-code","label":"Claude Code","callbackPolicy":"loopback-host","redirectUris":["http://localhost:49152/callback","http://127.0.0.1:49152/callback"]},{"clientId":"https://chatgpt.com/oauth/codex/client.json","family":"codex","label":"Codex","callbackPolicy":"loopback-host","redirectUris":["http://127.0.0.1:49152/callback","http://localhost:49152/callback"]},{"clientId":"https://chatgpt.com/oauth/client.json","family":"chatgpt","label":"ChatGPT","callbackPolicy":"hosted-https","redirectUris":["https://chatgpt.com/connector_platform_oauth_redirect"]},{"clientId":"https://cursor.com/oauth/mcp-client.json","family":"cursor","label":"Cursor","callbackPolicy":"loopback-host","redirectUris":["http://localhost:8787/callback","http://127.0.0.1:8787/callback"]}]
AGENT_AUTHORIZATION_DATABASE_URL=postgresql://REPLACE_ME_ADMIN_ISSUER_ROLE:REPLACE_ME_PASSWORD@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
AGENT_AUTHORIZATION_DATABASE_SSL_CA_FILE=/etc/yoyi/ca/database-ca.pem
# Metadata has no password and provides no SQL authority. All five roles distinct, same DB.
AGENT_CONSENT_DATABASE_TARGET=postgresql://REPLACE_ME_ADMIN_CONSENT_ROLE@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
AGENT_RESOURCE_DATABASE_TARGET=postgresql://REPLACE_ME_ADMIN_RESOURCE_ROLE@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
CMS_DATABASE_TARGET=postgresql://REPLACE_ME_CMS_RUNTIME_ROLE@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
DATABASE_TARGET=postgresql://REPLACE_ME_PUBLIC_READ_ROLE@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
AGENT_CONNECTION_PROVIDER_INDEX_KEY=REPLACE_ME_ADMIN_ISSUER_32_BYTE_BASE64_PROVIDER_INDEX_KEY
AGENT_CONNECTION_PROVIDER_SEAL_KEY=REPLACE_ME_ADMIN_ISSUER_32_BYTE_BASE64_PROVIDER_SEAL_KEY
# The same two values in admin.env: the Admin reads the wrappers this issuer seals.
AGENT_CONNECTION_WRAPPER_INDEX_KEY=REPLACE_ME_ADMIN_SHARED_32_BYTE_BASE64_WRAPPER_INDEX_KEY
AGENT_CONNECTION_WRAPPER_SEAL_KEY=REPLACE_ME_ADMIN_SHARED_32_BYTE_BASE64_WRAPPER_SEAL_KEY
AGENT_AUTHORIZATION_COOKIE_KEY=REPLACE_ME_ADMIN_ISSUER_32_BYTE_BASE64URL_COOKIE_KEY
# Dedicated private JWKS, regular nonsymlink single-link file, mode 0600, owned by
# yoyi-admin-authorization; never in Git/Web/Backend/Admin or the Article issuer.
AGENT_AUTHORIZATION_SIGNING_JWKS_FILE=/etc/yoyi/admin-signing.jwks.json
# What /healthz names; the release writes its pinned commit.
AGENT_AUTHORIZATION_BUILD_ID=REPLACE_ME_RELEASE_COMMIT
