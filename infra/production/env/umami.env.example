# Private /etc/yoyi/umami.env, root-owned mode 0600. Never source or print it.
# Default: standalone on the existing Node24, no Docker daemon on this host.
# Optional container unit only: inspected immutable ID after off-host image load.
# UMAMI_IMAGE=sha256:REPLACE_ME_REVIEWED_64_HEX_LOCAL_IMAGE_ID
NODE_ENV=production
BASE_PATH=/admin/analytics-workspace
# Existing external PostgreSQL; dedicated Umami database and role, never the CMS
# or community role. The migration image is an explicit separate operation.
DATABASE_TYPE=postgresql
DATABASE_URL=postgresql://REPLACE_ME_UMAMI_ROLE:REPLACE_ME_PASSWORD@database.example.invalid:5432/REPLACE_ME_UMAMI_DATABASE?sslmode=verify-full
APP_SECRET=REPLACE_ME_DISTINCT_UMAMI_APP_SECRET
# Canonical worker is the only collector; public proxy blocks all collection.
# Backend overwrites this header before trusted loopback forwarding.
CLIENT_IP_HEADER=x-moya-analytics-ip
DISABLE_TELEMETRY=1
DISABLE_UPDATES=1
# Native bot filtering stays enabled; Backend additionally rejects internal/test traffic.
NEXT_TELEMETRY_DISABLED=1
NODE_OPTIONS=--max-old-space-size=512
# No DATABASE_REPLICA_URL (pool3 total), CLOUD_MODE, CLICKHOUSE_URL, REDIS_URL,
# UMAMI_SELF_TRACK or UMAMI_SELF_RECORD.
# Same-origin iframe is already allowed by native CSP frame-ancestors 'self'.
# Bootstrap admin/viewer credentials belong in a separate temporary private
# bootstrap config; they must not be inherited by this serving container.
