# Private copy: /etc/yoyi/media-worker.env (root-owned, 0600); all provider values fictional.
NODE_ENV=production
# A: the media worker never publishes new public copies during Closed Beta.
# Missing mode also fails closed for publication; intentional public activation is separate.
PRODUCT_ACCESS_MODE=closed-beta
MEDIA_PUBLICATION=off
MEDIA_PUBLIC_DELIVERY=relay
# Configure only after approved published-bucket/zone/role access is available.
# MEDIA_PUBLISHED_ORIGIN=https://images.example.invalid
# MEDIA_PUBLISHED_COS_BUCKET=REPLACE_ME_PUBLISHED_BUCKET-1234567890
# MEDIA_PUBLISHED_COS_REGION=ap-example
# MEDIA_PUBLISHER_ROLE_ARN=qcs::cam::uin/1234567890:roleName/REPLACE_ME_PUBLISHER_ROLE
# MEDIA_EDGE_ZONE_ID=zone-REPLACE_ME
# MEDIA_EDGE_VERIFY_CONNECT_HOST=REPLACE_ME.edge.example.invalid
# Community V1 App role (the Backend's): leases jobs and records renditions.
APP_DATABASE_URL=postgresql://REPLACE_ME_APP_ROLE:REPLACE_ME_PASSWORD@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
# Public read role (the Backend's): reads the published Catalog media list only.
DATABASE_URL=postgresql://REPLACE_ME_PUBLIC_READ_ROLE:REPLACE_ME_PASSWORD@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
# Each pool holds at most this many connections.
DATABASE_POOL_MAX=3
DATABASE_IDLE_TIMEOUT_MS=10000
# Optional custom CA; when omitted TLS uses system CAs. Never disable CA validation.
# DATABASE_SSL_CA_FILE=/etc/yoyi/ca/database-ca.pem
# APP_DATABASE_SSL_CA_FILE=/etc/yoyi/ca/database-ca.pem

# The same private UGC COS namespace and identity as backend.env.
WORK_MEDIA_COS_BUCKET=REPLACE_ME_PRIVATE_UGC_BUCKET-1234567890
WORK_MEDIA_COS_REGION=REPLACE_ME_REGION
WORK_MEDIA_COS_PREFIX=ugc/publishing/REPLACE_ME_NAMESPACE/
WORK_MEDIA_COS_SECRET_ID=REPLACE_ME_UGC_SECRET_ID
WORK_MEDIA_COS_SECRET_KEY=REPLACE_ME_UGC_SECRET_KEY
WORK_MEDIA_COS_REQUEST_TIMEOUT_MS=30000
# Temporary COS credentials must include both token and Unix-second expiry (>now+30s).
# WORK_MEDIA_COS_SECURITY_TOKEN=REPLACE_ME_UGC_SECURITY_TOKEN
# WORK_MEDIA_COS_CREDENTIAL_EXPIRES_AT=REPLACE_ME_UNIX_SECONDS

# The local, reviewed media sandbox image (never pulled; loaded into the
# yoyi-media daemon) and its private job workspace (owned by yoyi-media,
# 0700, outside temporary storage; the Backend user cannot enter it).
WORK_MEDIA_TOOLS_IMAGE=sha256:REPLACE_ME_64_HEX_LOCAL_IMAGE_ID
WORK_MEDIA_WORK_DIR=/var/lib/yoyi-media/publishing-work
WORK_MEDIA_WORKER_CONCURRENCY=1
# WORK_MEDIA_STORE_DIR must be absent.

# Catalog source reads use the Backend's existing Catalog read identity over
# the COS API endpoint of the bucket's region. Leaving all four keys out turns
# Catalog rendering off; a partial set refuses startup.
COS_BUCKET=REPLACE_ME_PRIVATE_BUCKET
COS_REGION=REPLACE_ME_REGION
COS_SECRET_ID=REPLACE_ME_BACKEND_READ_SECRET_ID
COS_SECRET_KEY=REPLACE_ME_BACKEND_READ_SECRET_KEY
# COS_SECURITY_TOKEN=REPLACE_ME_SESSION_TOKEN
# COS_CREDENTIAL_EXPIRES_AT=REPLACE_ME_EXPIRY
COS_REQUEST_TIMEOUT_MS=5000

# The rootless container daemon of the dedicated yoyi-media user. Its socket
# belongs to that user, so the Backend (another user) cannot connect to it.
DOCKER_HOST=unix:///run/user/REPLACE_ME_MEDIA_UID/docker.sock
