@@ -0,0 +1,75 @@
+import { DatabaseSync } from 'node:sqlite';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { createSession } from './createSession';
+
+let database: DatabaseSync;
+vi.mock('@/lib/prisma', () => ({
+  default: {
+    writeRawQuery: async (sql: string, values: Record<string, any>) => {
+      const keys: string[] = [];
+      const bound = sql.replace(/\{\{([A-Za-z0-9_]+)\}\}/g, (_, key) => {
+        keys.push(key);
+        return '?';
+      });
+      return database.prepare(bound).run(...keys.map(key => {
+        const value = values[key];
+        return value instanceof Date ? value.toISOString() : typeof value === 'boolean' ? Number(value) : value;
+      }));
+    },
+  },
+}));
+
+const input = (changes: Record<string, any> = {}) => ({
+  id: '10000000-0000-4000-8000-000000000001',
+  websiteId: '10000000-0000-4000-8000-000000000002',
+  distinctId: 'synthetic-distinct-visitor',
+  country: 'CN',
+  region: null,
+  city: null,
+  browser: 'chrome',
+  os: 'Mac OS',
+  device: 'desktop',
+  screen: '1200x800',
+  language: 'zh-CN',
+  createdAt: new Date('2026-10-20T01:02:03Z'),
+  ...changes,
+});
+const row = () => ({ ...database.prepare('select * from session').get() });
+
+beforeEach(() => {
+  database = new DatabaseSync(':memory:');
+  database.exec('create table session(session_id text primary key, website_id text, browser text, os text, device text, screen text, language text, country text, region text, city text, distinct_id text, created_at text)');
+});
+afterEach(() => database.close());
+
+describe('revisited native sessions fill only an unknown China province', () => {
+  it('fills the province while keeping every identity and previously stored field', async () => {
+    await createSession(input());
+    const before = row();
+    await createSession(input({ region: 'CN-JS', browser: 'firefox', device: 'phone', createdAt: new Date('2026-10-25T03:04:05Z') }));
+    expect(row()).toEqual({ ...before, region: 'CN-JS' });
+  });
+  it('also fills empty strings without filling the city', async () => {
+    await createSession(input({ region: '', city: '' }));
+    const before = row();
+    await createSession(input({ region: 'CN-GD', city: 'Guangzhou' }));
+    expect(row()).toEqual({ ...before, region: 'CN-GD' });
+  });
+  it.each([
+    [{ region: 'CN-SH' }, { region: 'CN-JS' }],
+    [{ city: 'Shanghai' }, { region: 'CN-JS' }],
+    [{ country: 'US' }, { region: 'CN-JS' }],
+    [{}, { country: 'US', region: 'CN-JS' }],
+    [{}, { country: 'CNA', region: 'CN-JS' }],
+    [{}, { region: 'CN-UNKNOWN' }],
+    [{}, { region: 'US-CA' }],
+    [{}, { region: null }],
+    [{}, { region: 'CN-JS', distinctId: 'different-synthetic-visitor' }],
+    [{}, { region: 'CN-JS', websiteId: '10000000-0000-4000-8000-000000000003' }],
+  ])('preserves known geography and rejects conflicting or invalid fill input (%j / %j)', async (stored, incoming) => {
+    await createSession(input(stored));
+    const before = row();
+    await createSession(input(incoming));
+    expect(row()).toEqual(before);
+  });
+});
