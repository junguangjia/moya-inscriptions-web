+import path from 'node:path';
+import { isIP } from 'node:net';
+import {
+  IPv4, IPv6, loadVectorIndexFromFile, newWithVectorIndex, verifyFromFile,
+} from './ip2region/index.js';
+
+const provinces = Object.fromEntries([
+  ['北京市', 'BJ'], ['天津市', 'TJ'], ['河北省', 'HE'], ['山西省', 'SX'],
+  ['内蒙古', 'NM'], ['辽宁省', 'LN'], ['吉林省', 'JL'], ['黑龙江省', 'HL'],
+  ['上海市', 'SH'], ['江苏省', 'JS'], ['浙江省', 'ZJ'], ['安徽省', 'AH'],
+  ['福建省', 'FJ'], ['江西省', 'JX'], ['山东省', 'SD'], ['河南省', 'HA'],
+  ['湖北省', 'HB'], ['湖南省', 'HN'], ['广东省', 'GD'], ['广西', 'GX'],
+  ['海南省', 'HI'], ['重庆市', 'CQ'], ['四川省', 'SC'], ['贵州省', 'GZ'],
+  ['云南省', 'YN'], ['西藏', 'XZ'], ['陕西省', 'SN'], ['甘肃省', 'GS'],
+  ['青海省', 'QH'], ['宁夏', 'NX'], ['新疆', 'XJ'], ['台湾省', 'TW'],
+  ['香港特别行政区', 'HK'], ['澳门特别行政区', 'MO'],
+]);
+const provinceKeys = new Set(Object.values(provinces).map(value => `CN-${value}`));
+const readers = new Map();
+
+export function isCnProvince(value) {
+  return provinceKeys.has(value);
+}
+
+// Internal statistics only. Preserve known geography and never infer a city.
+export async function fillMissingCnProvince(ip, country, region, city, directory = path.join(process.cwd(), 'geo')) {
+  if (country !== 'CN' || region || city) return region;
+  const family = isIP(ip);
+  if (!family) return region;
+  const filename = path.join(directory, `ip2region_v${family}.xdb`);
+  try {
+    if (!readers.has(filename)) {
+      verifyFromFile(filename);
+      readers.set(filename, newWithVectorIndex(
+        family === 4 ? IPv4 : IPv6, filename, loadVectorIndexFromFile(filename),
+      ));
+    }
+    const reader = readers.get(filename);
+    if (!reader) return region;
+    const fields = (await reader.search(ip)).split('|');
+    if (fields.length !== 5 || fields[0] !== '中国' || fields[4] !== 'CN') return region;
+    return provinces[fields[1]] || region;
+  } catch {
+    // Missing/unreadable data must not fail collection or expose the input IP.
+    readers.set(filename, null);
+    return region;
+  }
+}
