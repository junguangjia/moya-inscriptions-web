+  it('preserves non-China results and existing city context', async () => {
+    expect(await fillMissingCnProvince('223.5.5.5', 'US', undefined, undefined, '/missing-data')).toBeUndefined();
+    expect(await fillMissingCnProvince('223.5.5.5', 'CN', undefined, 'Shanghai', '/missing-data')).toBeUndefined();
+  });
+  it('looks up both pinned IPv4 and IPv6 files', async () => {
+    expect(await fillMissingCnProvince('223.5.5.5', 'CN', undefined, undefined)).toBe('ZJ');
+    expect(await fillMissingCnProvince('2400:3200::1', 'CN', undefined, undefined)).toBe('ZJ');
+  });
+  it('rejects invalid IPs, reserved data and conflicting countries', async () => {
+    for (const ip of ['invalid', '0.0.0.0', '8.8.8.8']) {
+      expect(await fillMissingCnProvince(ip, 'CN', undefined, undefined)).toBeUndefined();
+    }
+  });
+  it('keeps collection available when the optional database is missing', async () => {
+    expect(await fillMissingCnProvince('223.5.5.5', 'CN', undefined, undefined, '/missing-data')).toBeUndefined();
+  });
+  it('fills a country-only MMDB fixture through the actual collector resolver', async () => {
+    const result = await getLocation('114.114.114.114', new Headers(), true);
+    expect(result).toEqual({ country: 'CN', region: 'CN-JS', city: undefined });
+  });
+  it('keeps the existing MMDB province and city through the actual resolver', async () => {
+    expect(await getLocation('223.5.5.5', new Headers(), true)).toEqual({ country: 'CN', region: 'CN-ZJ', city: 'Hangzhou' });
+  });
+});
