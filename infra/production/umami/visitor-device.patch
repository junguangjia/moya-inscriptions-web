+import { DATA_TYPE } from '@/lib/constants';
+import { uuid } from '@/lib/crypto';
+import prisma from '@/lib/prisma';
+export const MOYA_DEVICE_CONFLICT = '__moya_conflict__';
+
+/** Descriptive session metadata is never allowed to overwrite conflicting positive evidence. */
+export async function saveMoyaDeviceData({
+  websiteId,
+  sessionId,
+  vendor,
+  model,
+  createdAt,
+}: {
+  websiteId: string;
+  sessionId: string;
+  vendor?: string;
+  model?: string;
+  createdAt: Date;
+}) {
+  for (const [dataKey, stringValue] of [
+    ['moyaDeviceVendor', vendor],
+    ['moyaDeviceModel', model],
+  ]) {
+    if (!stringValue) continue;
+    await prisma.writeRawQuery(
+      `
+      insert into session_data (session_data_id, website_id, session_id, data_key, data_type, string_value, created_at)
+      values ({{id::uuid}}, {{websiteId::uuid}}, {{sessionId::uuid}}, {{dataKey}}, {{dataType}}, {{stringValue}}, {{createdAt}})
+      on conflict (session_id, data_key) do update set string_value =
+        case when session_data.string_value is null or session_data.string_value = '' then excluded.string_value
+          when session_data.string_value = excluded.string_value then session_data.string_value
+          else '__moya_conflict__' end
+      where session_data.website_id = excluded.website_id
+        and session_data.string_value is distinct from excluded.string_value
+    `,
+      {
+        id: uuid(),
+        websiteId,
+        sessionId,
+        dataKey,
+        dataType: DATA_TYPE.string,
+        stringValue,
+        createdAt,
+      },
+      'saveMoyaDeviceData',
+    );
+  }
+}
