+import { UAParser } from 'ua-parser-js';
+
+export interface MoyaClientHints {
+  brands?: { brand: string; version: string }[];
+  platform?: string;
+  platformVersion?: string;
+  mobile?: boolean;
+  model?: string;
+}
+const clean = (value: unknown, max: number) =>
+  typeof value === 'string' && value.length <= max && !/[\u0000-\u001f\u007f]/u.test(value)
+    ? value.trim()
+    : '';
+const shells: [RegExp, string][] = [
+  [/MicroMessenger(?:[ /;]|$)/iu, 'wechat'],
+  [/(?:MQQBrowser|QQBrowser)(?:[ /;]|$)/iu, 'qqbrowser'],
+  [/(?:HuaweiBrowser|HWBROWSER)(?:[ /;]|$)/iu, 'huawei'],
+  [/MiuiBrowser(?:[ /;]|$)/iu, 'miui'],
+  [/VivoBrowser(?:[ /;]|$)/iu, 'vivo'],
+  [/(?:HeyTapBrowser|OppoBrowser)(?:[ /;]|$)/iu, 'oppo'],
+  [/SamsungBrowser(?:[ /;]|$)/iu, 'samsung'],
+  [/(?:UCBrowser|UCWEB)(?:[ /;]|$)/iu, 'uc'],
+  [/Quark(?:[ /;]|$)/iu, 'quark'],
+  [/(?:baidubrowser|baiduboxapp)(?:[ /;]|$)/iu, 'baidu'],
+  [/AlipayClient(?:[ /;]|$)/iu, 'alipay'],
+  [/DingTalk(?:[ /;]|$)/iu, 'dingtalk'],
+];
+
+export function clientHintHeaders(value: unknown): Record<string, string> {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return {};
+  const input = value as MoyaClientHints;
+  const headers: Record<string, string> = {};
+  for (const [field, header, max] of [
+    ['platform', 'sec-ch-ua-platform', 32],
+    ['platformVersion', 'sec-ch-ua-platform-version', 64],
+    ['model', 'sec-ch-ua-model', 128],
+  ] as const) {
+    const text = clean(input[field], max);
+    if (text) headers[header] = JSON.stringify(text);
+  }
+  if (typeof input.mobile === 'boolean') headers['sec-ch-ua-mobile'] = input.mobile ? '?1' : '?0';
+  if (Array.isArray(input.brands) && input.brands.length <= 8) {
+    const brands = input.brands.flatMap(item => {
+      const brand = clean(item?.brand, 64),
+        version = clean(item?.version, 32);
+      return brand && version ? [`${JSON.stringify(brand)};v=${JSON.stringify(version)}`] : [];
+    });
+    if (brands.length) headers['sec-ch-ua'] = brands.join(', ');
+  }
+  return headers;
+}
+
+/** Labels only. Neither UA nor hints ever supply a visitor/account identifier. */
+export async function deriveDeviceInfo(
+  userAgent: string,
+  hints?: unknown,
+  fallbackBrowser?: string,
+) {
+  const ua = typeof userAgent === 'string' ? userAgent.slice(0, 512) : '';
+  const headers = clientHintHeaders(hints);
+  const parsed = await new UAParser(ua, headers).getResult().withClientHints();
+  const shell = shells.find(([pattern]) => pattern.test(ua))?.[1];
+  const parsedBrowsers: Record<string, string> = {
+    Chrome: 'chrome',
+    'Mobile Chrome': 'chrome',
+    Chromium: 'chrome',
+    Edge: 'edge-chromium',
+    Firefox: 'firefox',
+    Safari: 'safari',
+    'Mobile Safari': 'ios',
+    'Samsung Internet': 'samsung',
+    'MIUI Browser': 'miui',
+    'Huawei Browser': 'huawei',
+    'Vivo Browser': 'vivo',
+    'OPPO Browser': 'oppo',
+    QQBrowser: 'qqbrowser',
+    'UC Browser': 'uc',
+    WeChat: 'wechat',
+  };
+  const fallback = clean(fallbackBrowser, 20);
+  const parsedBrowser = parsedBrowsers[parsed.browser.name ?? ''];
+  const genericFallback = !fallback || ['chrome', 'browser', 'chromium-webview'].includes(fallback);
+  const browser =
+    shell ||
+    (genericFallback ? parsedBrowser : undefined) ||
+    fallback ||
+    parsedBrowser ||
+    'browser';
+  const candidateModel = clean(parsed.device.model, 128);
+  const model = /^(?:k|unknown|generic|device|android|mobile|tablet|desktop)$/iu.test(
+    candidateModel,
+  )
+    ? ''
+    : candidateModel;
+  // Vendor comes from the UA/model parser, never from a browser brand such as HuaweiBrowser.
+  const vendor = clean(parsed.device.vendor, 64);
+  const type = parsed.device.type;
+  return {
+    browser,
+    vendor,
+    model,
+    device: type === 'mobile' || type === 'tablet' ? type : undefined,
+  };
+}
