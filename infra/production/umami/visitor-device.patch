+/** Per-event first-party keys; native session/visit identities remain unchanged. */
+export const moyaVisitorJoin = `
+  left join lateral (
+    select
+      case when count(*) filter (where d.data_key = 'moyaBrowserId') = 1
+        and min(d.string_value) filter (where d.data_key = 'moyaBrowserId') ~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
+        then lower(min(d.string_value) filter (where d.data_key = 'moyaBrowserId')) end as browser_key,
+      case when count(*) filter (where d.data_key = 'moyaAccountId') = 1
+        and min(d.string_value) filter (where d.data_key = 'moyaAccountId') ~ '^[0-9a-f]{40}$'
+        then min(d.string_value) filter (where d.data_key = 'moyaAccountId') end as account_key
+    from event_data d
+    where d.website_id = website_event.website_id
+      and d.website_event_id = website_event.event_id
+      and d.data_key in ('moyaBrowserId', 'moyaAccountId')
+  ) moya_visitor on true`;
+
+export const moyaBrowserKey = `coalesce(moya_visitor.browser_key, 'legacy:' || website_event.session_id::text)`;
+export const moyaVisitorKeys = `jsonb_agg(distinct ${moyaBrowserKey}) filter (where website_event.event_type NOT IN (2, 5))`;
+export const moyaAccountKeys = `jsonb_agg(distinct moya_visitor.account_key) filter (where website_event.event_type NOT IN (2, 5) and moya_visitor.account_key is not null)`;
+
+/** Flatten only key arrays, independently of native visit/PV/bounce/time aggregates. */
+export function moyaCountKeys(column: string) {
+  if (!/^[a-z_]+\.[a-z_]+$/u.test(column)) throw new Error('INVALID_VISITOR_KEY_COLUMN');
+  return `(select count(distinct moya_key.value)
+    from jsonb_array_elements_text(jsonb_path_query_array(
+      coalesce(jsonb_agg(${column}), '[]'::jsonb), '$[*][*]')) moya_key(value))`;
+}
