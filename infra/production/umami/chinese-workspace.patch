+test('the real map produces bounded province-shaped SVG fills, never the world-sized complement rectangle', async () => {
+  const original = JSON.parse(await readFile('public/maps/china-provinces.json', 'utf8'));
+  const before = JSON.stringify(original);
+  vi.stubGlobal('fetch', vi.fn().mockResolvedValue({ ok: true, json: async () => original }));
+  const { container } = render(<WorldMap websiteId="synthetic-website" />);
+  await waitFor(() => expect(container.querySelectorAll('path[data-province]')).toHaveLength(34));
+  const prepared = prepareChinaMapGeometry(original);
+  const path = geoPath(
+    geoMercator()
+      .translate([CHINA_MAP.width / 2, CHINA_MAP.height / 2])
+      .center(CHINA_MAP.center)
+      .scale(CHINA_MAP.scale),
+  );
+  let totalArea = 0;
+  for (const element of container.querySelectorAll('path[data-province]')) {
+    const feature = prepared.features.find(
+      (item: any) =>
+        provinceForGeometry(item.properties.adcode)?.[1] === element.getAttribute('data-province'),
+    );
+    const d = element.getAttribute('d') ?? '';
+    expect(d).toBe(path(feature));
+    // Mercator emits M/L/Z polygons. Check the actual SVG coordinates and signed
+    // fill area, rather than merely counting paths or distinct fill attributes.
+    expect(d).not.toMatch(/[ACHQSTV]/u);
+    let area = 0;
+    for (const ring of d.split('Z').filter(Boolean)) {
+      const values = (ring.match(/[-+]?(?:\d*\.\d+|\d+)(?:e[-+]?\d+)?/giu) ?? []).map(Number);
+      const points = Array.from({ length: values.length / 2 }, (_, i) => [
+        values[i * 2],
+        values[i * 2 + 1],
+      ]);
+      for (
+        let current = 0, previous = points.length - 1;
+        current < points.length;
+        previous = current++
+      ) {
+        const [x, y] = points[current];
+        expect(x).toBeGreaterThanOrEqual(29.99);
+        expect(x).toBeLessThanOrEqual(CHINA_MAP.width - 29.99);
+        expect(y).toBeGreaterThanOrEqual(29.99);
+        expect(y).toBeLessThanOrEqual(CHINA_MAP.height - 29.99);
+        area += points[previous][0] * y - x * points[previous][1];
+      }
+    }
+    area = Math.abs(area / 2);
+    expect(area).toBeCloseTo(path.area(feature), 6);
+    expect(area).toBeGreaterThan(0);
+    expect(area).toBeLessThan(CHINA_MAP.width * CHINA_MAP.height * 0.1);
+    totalArea += area;
+  }
+  expect(totalArea).toBeGreaterThan(50000);
+  expect(totalArea).toBeLessThan(CHINA_MAP.width * CHINA_MAP.height * 0.5);
+  expect(JSON.stringify(original)).toBe(before);
+});
