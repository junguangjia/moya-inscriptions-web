+}));
+
+import { WebsiteExpandedView } from './WebsiteExpandedView';
+
+afterEach(() => {
+  cleanup();
+  runtime.push.mockClear();
+});
+test('inline full analysis reuses all 26 native dimension routes in one labeled select and original table', () => {
+  const close = vi.fn();
+  const result = render(<WebsiteExpandedView websiteId="synthetic-site" inline onClose={close} />);
+  const select = screen.getByRole('combobox', { name: '统计维度' });
+  expect(screen.getAllByRole('option')).toHaveLength(26);
+  expect(screen.getByTestId('original-table')).toHaveAttribute('data-inline', 'true');
+  expect(result.container.querySelector('#metrics-expanded-menu')).toBeNull();
+  expect(result.container.querySelector('#expanded-mobile-menu-button')).toBeNull();
+  fireEvent.change(select, { target: { value: 'utmSource' } });
+  const url = new URL(runtime.push.mock.lastCall?.[0], 'http://localhost');
+  expect(url.searchParams.get('view')).toBe('utmSource');
+  expect(url.searchParams.get('country')).toBe('eq.CN');
+  expect(url.searchParams.get('startAt')).toBe('1000');
+  fireEvent.click(screen.getByRole('button', { name: '关闭' }));
+  expect(close).toHaveBeenCalledOnce();
+});
