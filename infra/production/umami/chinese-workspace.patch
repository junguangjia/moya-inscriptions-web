+  like: '点赞',
+  favorite: '收藏',
+  follow: '关注',
+});
+
+export function getChineseEventName(value: string): string {
+  return Object.hasOwn(CHINESE_EVENT_NAMES, value) ? CHINESE_EVENT_NAMES[value] : value;
+}
