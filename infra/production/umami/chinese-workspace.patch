+import navigation from '../data/archive-navigation.json';
+
+export const archiveAdminMode = process.env.basePath === '/admin/analytics-workspace';
+export const archiveNavigation = navigation;
+export const archiveAssets = {
+  theme: '62c0496afbbd07112fce0fe8127a640665d33fe9468a2500930651bc27341478',
+  navigation: 'ff1f9d243b15fb124103483cf14145a029c0c919fa68b26a9c9d12a46f09339c',
+  icons: '8d39d4a06bb7d863d2b954454b1d8e414e1d8a642245716f2e4343854b48f863',
+} as const;
+export const archiveIconsHref = `${process.env.basePath || ''}/archive-icons.svg?v=${archiveAssets.icons}`;
+
+/** This preference cookie has no authentication or authorization meaning. */
+export function readArchiveTheme(): 'light' | 'dark' | undefined {
+  if (typeof document === 'undefined') return undefined;
+  const name = `${archiveNavigation.themeCookieName}=`;
+  const value = document.cookie
+    .split(';')
+    .map(part => part.trim())
+    .find(part => part.startsWith(name))
+    ?.slice(name.length);
+  return value === 'light' || value === 'dark' ? value : undefined;
+}
+
+export function saveArchiveTheme(theme: 'light' | 'dark') {
+  // biome-ignore lint/suspicious/noDocumentCookie: Match Payload's existing non-authorizing theme preference.
+  document.cookie = `${archiveNavigation.themeCookieName}=${theme}; Max-Age=31536000; Path=/; SameSite=Lax`;
+}
+
+export function resolveArchiveTheme(): 'light' | 'dark' | undefined {
+  if (typeof window === 'undefined') return undefined;
+  return (
+    readArchiveTheme() ??
+    (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
+  );
+}
