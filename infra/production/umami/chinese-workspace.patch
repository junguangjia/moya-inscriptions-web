+vi.mock('@/lib/request', () => ({
+  parseRequest: async (request: Request, schema: { parse: (value: unknown) => unknown }) => ({
+    query: schema.parse(Object.fromEntries(new URL(request.url).searchParams)),
+    auth: {},
+  }),
+  getQueryFilters: async (query: Record<string, unknown>) => ({ ...query }),
+}));
+vi.mock('@/permissions', () => ({ canViewWebsiteSection: async () => true }));
+vi.mock('@/queries/sql', () => ({
+  getSessionMetrics: runtime.getSessionMetrics,
+  getSessionExpandedMetrics: runtime.getSessionExpandedMetrics,
+  getEventMetrics: async () => runtime.event,
+  getEventExpandedMetrics: async () => runtime.event,
+  getPageviewMetrics: async () => runtime.page,
+  getPageviewExpandedMetrics: async () => runtime.page,
+  getChannelMetrics: async () => [],
+  getChannelExpandedMetrics: async () => [],
+}));
+import { GET as metrics } from './route';
+import { GET as expanded } from './expanded/route';
+
+beforeEach(() => {
+  runtime.session = [];
+  runtime.event = [];
+  runtime.page = [];
+  runtime.getSessionMetrics.mockReset().mockImplementation(async () => runtime.session);
+  runtime.getSessionExpandedMetrics.mockReset().mockImplementation(async () => runtime.session);
+});
+const request = (type: string, search = '') =>
+  new Request(
+    `http://localhost/api/websites/synthetic/metrics?startAt=1&endAt=2&type=${type}${search}`,
+  );
+const context = { params: Promise.resolve({ websiteId: 'synthetic' }) };
+
+test.each([
+  ['metrics', metrics, 'x'],
+  ['expanded', expanded, 'name'],
+] as const)(
+  '%s adds optional Chinese city/province names while preserving raw keys and counts',
+  async (_label, handler, key) => {
+    runtime.session = [
+      {
+        [key]: 'Beijing',
+        country: 'CN',
+        region: 'CN-BJ',
+        y: 7,
+        visitors: 7,
+        visits: 8,
+        pageviews: 10,
+        bounces: 2,
+        totaltime: 30,
+      },
+      { [key]: 'UnmappedSyntheticTown', country: 'US', region: null, y: 3, visitors: 3 },
+    ];
+    const before = JSON.stringify(runtime.session);
+    const response = await handler(request('city'), context);
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual([
+      { ...runtime.session[0], displayName: '北京' },
+      runtime.session[1],
+    ]);
+    expect(JSON.stringify(runtime.session)).toBe(before);
+    runtime.session = [{ [key]: 'CN-TW', country: 'CN', y: 4, visitors: 4 }];
+    expect(await (await handler(request('region'), context)).json()).toEqual([
+      { ...runtime.session[0], displayName: '台湾省' },
+    ]);
+  },
+);
+
+test.each([
+  ['metrics', metrics, 'x'],
