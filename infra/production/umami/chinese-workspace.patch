+import { createElement, type ReactNode, useState } from 'react';
+import { cleanup, fireEvent, render, screen } from '@testing-library/react';
+import { afterEach, beforeEach, expect, test, vi } from 'vitest';
+const runtime = vi.hoisted(() => ({
+  query: {} as Record<string, string>,
+  requests: [] as any[],
+  rows: [] as any[],
+  expanded: [] as any[],
+}));
+vi.mock('@umami/react-zen', () => {
+  const Div = ({ children }: { children: ReactNode }) => <div>{children}</div>;
+  return {
+    Column: Div,
+    Row: Div,
+    Grid: Div,
+    Text: Div,
+    Button: ({ children, onPress, isDisabled }: any) => (
+      <button type="button" disabled={isDisabled} onClick={onPress}>
+        {children}
+      </button>
+    ),
+    Icon: Div,
+    SearchField: ({ value, onSearch }: any) => (
+      <input
+        aria-label="搜索"
+        value={value}
+        onChange={event => onSearch(event.currentTarget.value)}
+      />
+    ),
+    DataTable: ({ data }: any) => (
+      <ul>
+        {data.map((row: any) => (
+          <li key={row.label}>{row.label}</li>
+        ))}
+      </ul>
+    ),
+    DataColumn: () => null,
+  };
+});
+vi.mock('@/components/hooks', () => ({
+  useMessages: () => ({
+    t: (value: string) => value,
+    labels: { region: '省份', city: '城市', more: '更多' },
+  }),
+  useMobile: () => ({ isPhone: false }),
+  useNavigation: () => ({
+    boardId: 'synthetic-board',
+    query: runtime.query,
+    updateParams: () => '/synthetic',
+  }),
+  useDateParameters: () => ({ startAt: 1000, endAt: 9000 }),
+  useWebsiteMetricsQuery: (id: string, params: any) => {
+    runtime.requests.push({ id, params, expanded: false });
+    return { data: runtime.rows, isLoading: false, isFetching: false };
+  },
+  useWebsiteExpandedMetricsQuery: (id: string, params: any) => {
+    runtime.requests.push({ id, params, expanded: true });
+    const rows = runtime.expanded.filter(row => !params.search || row.name.includes(params.search));
+    return {
+      data: rows.slice(params.offset ?? 0, (params.offset ?? 0) + (params.limit ?? 500)),
+      isLoading: false,
+      isFetching: false,
+    };
+  },
+}));
+vi.mock('@/components/common/LoadingPanel', () => ({
+  LoadingPanel: ({ children }: any) => children,
+}));
+vi.mock('@/components/common/OverlayScrollArea', () => ({
+  OverlayScrollArea: ({ children }: any) => children,
+}));
+vi.mock('@/components/input/DownloadButton', () => ({ DownloadButton: () => null }));
+vi.mock('@/components/metrics/MetricLabel', () => ({
+  MetricLabel: ({ data }: any) => <span>{data.label}</span>,
+}));
+vi.mock('@/components/input/DialogButton', () => ({
+  DialogButton: ({ label, children }: any) => {
+    const [open, setOpen] = useState(false);
+    return (
+      <>
+        <button onClick={() => setOpen(true)}>{label}</button>
+        {open ? children({ close: () => setOpen(false) }) : null}
+      </>
+    );
+  },
+}));
+import { MetricsTable } from './MetricsTable';
+import { MetricsExpandedTable } from './MetricsExpandedTable';
+beforeEach(() => {
+  runtime.requests = [];
+  runtime.query = {};
+  runtime.rows = [];
+  runtime.expanded = [];
+});
+afterEach(cleanup);
+test('34 region rows reach the native table and a Board opens its actual expanded search view', () => {
+  runtime.rows = Array.from({ length: 34 }, (_, i) => ({
+    x: `synthetic-region-${i + 1}`,
+    y: i + 9,
+  }));
+  render(
+    <MetricsTable
+      websiteId="synthetic-website"
+      type="region"
+      limit={34}
+      showMore
+      defaultCountry="CN"
+      animate={false}
+    />,
+  );
+  expect(screen.getAllByText(/^synthetic-region-/)).toHaveLength(34);
+  expect(runtime.requests[0].params).toMatchObject({ type: 'region', limit: 34, country: 'eq.CN' });
+  fireEvent.click(screen.getByRole('button', { name: '展开与搜索省份' }));
+  expect(screen.getByRole('textbox', { name: '搜索' })).toBeDefined();
+  expect(runtime.requests.find(request => request.expanded).params).toMatchObject({
+    type: 'region',
+    limit: 500,
+    offset: 0,
+    country: 'eq.CN',
+  });
+});
+test('geography expansion pages beyond 100 and resets to the first page on search or filter changes', () => {
+  runtime.expanded = Array.from({ length: 137 }, (_, i) => ({
+    name: `synthetic-city-${i + 1}`,
+    visitors: i + 11,
