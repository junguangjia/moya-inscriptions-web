+import styles from '../../ArchiveShell.module.css';
+
+/** Reuse the authoritative native groups/routes; no second report inventory. */
+export function ArchiveReportNav({ websiteId }: { websiteId: string }) {
+  const id = useId();
+  const { router, pathname } = useNavigation();
+  const { items, selectedKey } = useWebsiteNavItems(websiteId);
+  const selected =
+    selectedKey ||
+    (pathname.includes('/sessions/')
+      ? 'sessions'
+      : pathname.includes('/replays/')
+        ? 'replays'
+        : 'overview');
+  return (
+    <nav className={styles.reportNavigation} aria-label="分析功能">
+      <label htmlFor={id}>分析页面</label>
+      <select
+        id={id}
+        aria-label="分析页面"
+        value={selected}
+        onChange={event => {
+          const item = items
+            .flatMap(group => group.items)
+            .find(item => item.id === event.currentTarget.value);
+          if (item) router.push(item.path);
+        }}
+      >
+        {items.map(group => (
+          <optgroup label={group.label} key={group.label}>
+            {group.items.map(item => (
+              <option key={item.id} value={item.id}>
+                {item.label}
+              </option>
+            ))}
+          </optgroup>
+        ))}
+      </select>
+    </nav>
+  );
+}
