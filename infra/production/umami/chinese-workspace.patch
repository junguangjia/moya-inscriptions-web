+import { cleanup, fireEvent, render, screen } from '@testing-library/react';
+import { afterEach, beforeEach, expect, test, vi } from 'vitest';
+import { LAST_TEAM_CONFIG } from '@/lib/constants';
+import { getItem, setItem } from '@/lib/storage';
+
+const team = '10000000-0000-4000-8000-000000000001';
+const site = '20000000-0000-4000-8000-000000000001';
+const state = vi.hoisted(() => ({
+  private: true,
+  pathname: '',
+  teamError: undefined as unknown,
+  pushed: [] as string[],
+}));
+const navigate = () => {
+  const [, teamId] = state.pathname.match(/\/teams\/([a-f0-9-]+)/) || [];
+  return {
+    pathname: state.pathname,
+    teamId,
+    router: {
+      push: (path: string) => {
+        state.pushed.push(path);
+        state.pathname = path;
+      },
+      replace: vi.fn(),
+    },
+    renderUrl: (path: string) => (teamId ? `/teams/${teamId}${path}` : path),
+  };
+};
+vi.mock('@/lib/archive-admin', () => ({
+  get archiveAdminMode() {
+    return state.private;
+  },
+}));
+vi.mock('@/components/hooks', () => ({
+  useNavigation: () => navigate(),
+  useLoginQuery: () => ({ user: { id: 'synthetic-reader' }, isLoading: false }),
+  useConfig: () => ({ cloudMode: false }),
+  useTeamQuery: () => ({ isLoading: false, error: state.teamError }),
+  useTwoFactorStatusQuery: () => ({ data: { isRequired: false, isEnabled: false } }),
+  useMessages: () => ({
+    t: (value: string) => value,
+    labels: {
+      dashboard: '仪表盘',
+      boards: '看板',
+      websites: '网站',
+      links: '链接',
+      pixels: '像素',
+    },
+  }),
+}));
+vi.mock('./ArchiveShell', async () => {
+  const { ArchiveContextNav } = await import('./ArchiveContextNav');
+  return {
+    ArchiveShell: ({ children, showAnalysisNavigation = true }: any) => (
+      <div>
+        {showAnalysisNavigation && <ArchiveContextNav />}
+        {children}
+      </div>
+    ),
+    ArchiveServiceError: () => <p role="alert">服务暂时不可用</p>,
+  };
+});
+vi.mock('@/app/(main)/SideNav', () => ({ SideNav: () => null }));
+vi.mock('@/app/(main)/TopNav', () => ({ TopNav: () => null }));
+vi.mock('@/app/(main)/MobileNav', () => ({ MobileNav: () => null }));
+vi.mock('./UpdateNotice', () => ({ UpdateNotice: () => null }));
+vi.mock('@/components/modals/TwoFactorSetupModal', () => ({ TwoFactorSetupModal: () => null }));
+vi.mock('next/script', () => ({ default: () => null }));
+import { App } from './App';
+
+beforeEach(() => {
+  localStorage.clear();
+  state.private = true;
+  state.pathname = `/teams/${team}/websites/${site}`;
+  state.teamError = undefined;
+  state.pushed = [];
+});
+afterEach(cleanup);
+const page = () => (
+  <App>
+    <p>原分析内容</p>
+  </App>
+);
+
+test.each(['websites', 'boards', 'links', 'pixels'])(
+  'same-session team → bare Dashboard → %s returns to the existing team',
+  target => {
+    const view = render(page());
