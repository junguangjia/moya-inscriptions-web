+import cities from '../data/geo-city.zh-CN.json';
+import regions from '../data/geo-region.zh-CN.json';
+import globalCities from '../data/geo-city-global.zh-CN.json';
+
+// Generated once at build time from the pinned public MMDB; never a per-visit lookup.
+const cityNames: Record<string, string> = cities;
+const regionNames: Record<string, string> = regions;
+const provinces: Record<string, string> = {
+  "CN-BJ": "北京市",
+  "CN-TJ": "天津市",
+  "CN-HE": "河北省",
+  "CN-SX": "山西省",
+  "CN-NM": "内蒙古自治区",
+  "CN-LN": "辽宁省",
+  "CN-JL": "吉林省",
+  "CN-HL": "黑龙江省",
+  "CN-SH": "上海市",
+  "CN-JS": "江苏省",
+  "CN-ZJ": "浙江省",
+  "CN-AH": "安徽省",
+  "CN-FJ": "福建省",
+  "CN-JX": "江西省",
+  "CN-SD": "山东省",
+  "CN-HA": "河南省",
+  "CN-HB": "湖北省",
+  "CN-HN": "湖南省",
+  "CN-GD": "广东省",
+  "CN-GX": "广西壮族自治区",
+  "CN-HI": "海南省",
+  "CN-CQ": "重庆市",
+  "CN-SC": "四川省",
+  "CN-GZ": "贵州省",
+  "CN-YN": "云南省",
+  "CN-XZ": "西藏自治区",
+  "CN-SN": "陕西省",
+  "CN-GS": "甘肃省",
+  "CN-QH": "青海省",
+  "CN-NX": "宁夏回族自治区",
+  "CN-XJ": "新疆维吾尔自治区",
+  "CN-HK": "香港特别行政区",
+  "CN-MO": "澳门特别行政区",
+  "CN-TW": "台湾省"
+};
+const globalCityNames: Record<string, string> = globalCities;
+const cityEntries = Object.entries(cityNames);
+
+export function getChineseRegionName(region: string): string | undefined {
+  if (region === 'CN-TW' || region?.startsWith('TW-')) return '台湾省';
+  return provinces[region] || regionNames[region];
+}
+
+export function getChineseCityName(city: string, country?: string): string | undefined {
+  if (!city) return undefined;
+  if (country) return cityNames[`${country}|${city}`];
+  return globalCityNames[city];
+}
+
+export function getChineseCityMatches(search: string): string[] {
+  if (!search || !/\p{Script=Han}/u.test(search)) return [];
+  const value = search.normalize('NFKC').trim();
+  if (!value) return [];
+  return [...new Set(cityEntries.filter(([, name]) => name.includes(value))
+    .map(([key]) => key.slice(key.indexOf('|') + 1)))];
+}
