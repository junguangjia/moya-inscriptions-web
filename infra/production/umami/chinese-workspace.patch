+  expect(screen.getAllByRole('listitem')).toHaveLength(100);
+  fireEvent.click(screen.getByRole('button', { name: '下一页' }));
+  expect(screen.getAllByRole('listitem')).toHaveLength(37);
+  expect(runtime.requests.at(-1).params.offset).toBe(0);
+  expect(runtime.requests.at(-1).params.limit).toBe(500);
+  fireEvent.change(screen.getByRole('textbox', { name: '搜索' }), {
+    target: { value: 'synthetic-city-137' },
+  });
+  expect(screen.getAllByRole('listitem')).toHaveLength(1);
+  expect(runtime.requests.at(-1).params.offset).toBe(0);
+  runtime.query = { region: 'eq.CN-HE' };
+  view.rerender(
+    createElement(MetricsExpandedTable, { websiteId: 'synthetic-website', type: 'city' }),
+  );
