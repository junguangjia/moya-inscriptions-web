+    .prepare('update website_event set url_path = ? where session_id != ?')
+    .run('/other', 'synthetic-path-hit');
+  const query = { path: 'eq./foo', match: 'any' } as const;
+  const original = await getSessionMetrics(
+    'synthetic-website',
+    { type: 'city' },
+    { ...filters, ...query, city: 'eq.Beijing' },
