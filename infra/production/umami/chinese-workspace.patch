+'use client';
+import { Dialog, Modal, useTheme } from '@umami/react-zen';
+import { type ReactNode, useRef, useState } from 'react';
+import { ControlledDialog } from '@/components/common/ControlledDialog';
+import { useNavigation } from '@/components/hooks';
+import { ArchiveContextNav } from './ArchiveContextNav';
+import { archiveIconsHref, archiveNavigation, saveArchiveTheme } from '@/lib/archive-admin';
+import styles from './ArchiveShell.module.css';
+
+export function ArchiveIcon({ name }: { name: string }) {
+  return (
+    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" className={styles.icon}>
+      <use href={`${archiveIconsHref}#${name}`} />
+    </svg>
+  );
+}
+
+function ShellNavigation({ onNavigate }: { onNavigate?: () => void }) {
+  return (
+    <>
+      <a
+        href={archiveNavigation.homeHref}
+        className={styles.brand}
+        onClick={onNavigate}
+        aria-label="由艺管理后台工作台"
+      >
+        <span
+          className={styles.brandMark}
+          style={{
+            maskImage: `url(${archiveNavigation.brandAssetHref})`,
+            WebkitMaskImage: `url(${archiveNavigation.brandAssetHref})`,
+          }}
+        />
+        <span>
+          {archiveNavigation.brandLabel}
+          <small>{archiveNavigation.caption}</small>
+        </span>
+      </a>
+      <nav aria-label="工作区" className={styles.links}>
+        {archiveNavigation.items.map(item => (
+          <a
+            key={item.id}
+            href={item.href}
+            className={styles.link}
+            aria-current={item.id === 'analytics' ? 'page' : undefined}
+            onClick={onNavigate}
+          >
+            <ArchiveIcon name={item.icon} />
+            <span>{item.label}</span>
+            {item.id === 'analytics' && <span className={styles.mark} aria-hidden="true" />}
+          </a>
+        ))}
+      </nav>
+    </>
+  );
+}
+
+export function ArchiveShell({
+  children,
+  showAnalysisNavigation = true,
+}: {
+  children: ReactNode;
+  showAnalysisNavigation?: boolean;
+}) {
+  const [menuOpen, setMenuOpen] = useState(false);
+  const { boardId, pathname } = useNavigation();
+  const activeDataHref =
+    boardId || /\/boards(?:\/|$)/u.test(pathname)
+      ? archiveNavigation.dataLinks.find(item => item.href.endsWith('/board'))?.href
+      : archiveNavigation.dataLinks[0]?.href;
+  const { theme, setTheme } = useTheme();
+  const menuButton = useRef<HTMLButtonElement>(null);
+  const changeMenu = (open: boolean) => {
+    setMenuOpen(open);
+    if (!open) requestAnimationFrame(() => menuButton.current?.focus());
+  };
+  const close = () => changeMenu(false);
+  const toggleTheme = () => {
+    const next = theme === 'dark' ? 'light' : 'dark';
+    saveArchiveTheme(next);
+    setTheme(next);
+  };
+  const footer = (
+    <div className={styles.footer}>
+      <a href={archiveNavigation.accountHref} className={styles.account}>
+        <ArchiveIcon name="user" />
+        <span>个人账号</span>
+      </a>
+      <button
+        type="button"
+        className={styles.iconButton}
+        onClick={toggleTheme}
+        aria-label={theme === 'dark' ? '切换浅色界面' : '切换深色界面'}
+        title={theme === 'dark' ? '切换浅色界面' : '切换深色界面'}
+      >
+        <ArchiveIcon name={theme === 'dark' ? 'theme-light' : 'theme-dark'} />
+      </button>
+    </div>
+  );
+  return (
+    <div className={styles.shell} data-archive-shell>
+      <a className={styles.skip} href="#archive-analysis-main">
+        跳到分析内容
+      </a>
+      <aside className={styles.sidebar} aria-label="管理后台导航">
+        <ShellNavigation />
+        {footer}
+      </aside>
+      <div className={styles.main}>
+        <header className={styles.bar}>
+          <button
+            type="button"
+            ref={menuButton}
+            className={`${styles.iconButton} ${styles.menuButton}`}
+            onClick={() => setMenuOpen(true)}
+            aria-label="打开管理后台导航"
+            title="打开管理后台导航"
+            aria-expanded={menuOpen}
+          >
+            <ArchiveIcon name="menu" />
+          </button>
+          <span className={styles.workspaceName}>
+            <ArchiveIcon name="layout-double" />
+            数据
+          </span>
+          <nav aria-label="数据页面" className={styles.dataLinks}>
+            {archiveNavigation.dataLinks.map(item => (
+              <a
+                href={item.href}
+                key={item.href}
+                aria-current={item.href === activeDataHref ? 'page' : undefined}
+              >
+                {item.label}
+              </a>
+            ))}
+          </nav>
+        </header>
+        <main id="archive-analysis-main" className={styles.content}>
+          {showAnalysisNavigation && <ArchiveContextNav />}
+          {children}
+        </main>
+      </div>
+      <ControlledDialog>
+        <Modal isOpen={menuOpen} onOpenChange={changeMenu} placement="fullscreen">
+          <Dialog title="管理后台导航" className={styles.mobileDialog}>
+            <div className={styles.mobileNav}>
+              <button
+                type="button"
+                className={`${styles.iconButton} ${styles.closeButton}`}
+                onClick={close}
+                aria-label="关闭管理后台导航"
+                title="关闭管理后台导航"
+              >
+                <ArchiveIcon name="close" />
+              </button>
+              <ShellNavigation onNavigate={close} />
+              {footer}
+            </div>
+          </Dialog>
+        </Modal>
