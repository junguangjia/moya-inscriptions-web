+test('the complete unchanged geometry fits the map viewport, including Taiwan and southern decoration', async () => {
+  const { readFile } = await import('node:fs/promises');
+  const geometry = JSON.parse(await readFile('public/maps/china-provinces.json', 'utf8'));
+  const points: number[][] = [];
+  const walk = (coordinates: any) => {
+    if (typeof coordinates?.[0] === 'number') points.push(coordinates);
+    else coordinates.forEach(walk);
+  };
+  geometry.features.forEach((feature: any) => {
+    walk(feature.geometry.coordinates);
+  });
+  expect(
+    geometry.features.filter((feature: any) => provinceForGeometry(feature.properties.adcode)),
+  ).toHaveLength(34);
+  const mercator = (latitude: number) =>
+    Math.log(Math.tan(Math.PI / 4 + (latitude * Math.PI) / 360));
+  for (const [longitude, latitude] of points) {
+    const x =
+      (((longitude - CHINA_MAP.center[0]) * Math.PI) / 180) * CHINA_MAP.scale + CHINA_MAP.width / 2;
+    const y =
+      (mercator(CHINA_MAP.center[1]) - mercator(latitude)) * CHINA_MAP.scale + CHINA_MAP.height / 2;
+    expect(x).toBeGreaterThanOrEqual(29.99);
+    expect(x).toBeLessThanOrEqual(CHINA_MAP.width - 29.99);
+    expect(y).toBeGreaterThanOrEqual(29.99);
