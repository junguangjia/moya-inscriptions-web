+'use client';
+import {
+  createContext,
+  type Dispatch,
+  type SetStateAction,
+  useContext,
+  useEffect,
+  useState,
+} from 'react';
+
+export type ArchiveAnalysisDisplay = {
+  leaf: string;
+  activeLeaf: string;
+  embedded: boolean;
+  values: Record<string, unknown>;
+  setValues: Dispatch<SetStateAction<Record<string, unknown>>>;
+};
+
+/** Private presentation scope; the native filters, queries and permissions remain authoritative. */
+export const ArchiveAnalysisContext = createContext<ArchiveAnalysisDisplay | null>(null);
+export const useArchiveAnalysis = () => useContext(ArchiveAnalysisContext);
+
+/** Keep a tool's entered options while its expensive canvas is collapsed. */
+export function useArchiveInput<T>(key: string, initial: T) {
+  const context = useArchiveAnalysis();
+  const [local, setLocal] = useState<T>(initial);
+  useEffect(() => {
+    if (context && !(key in context.values)) {
+      context.setValues(previous => (key in previous ? previous : { ...previous, [key]: local }));
+    }
+  }, [context?.setValues, context?.values, key, local]);
+  const value = context && key in context.values ? (context.values[key] as T) : local;
+  const setValue: Dispatch<SetStateAction<T>> = update => {
+    if (!context) return setLocal(update);
+    context.setValues(previous => ({
+      ...previous,
+      [key]:
+        typeof update === 'function'
+          ? (update as (previous: T) => T)(key in previous ? (previous[key] as T) : initial)
+          : update,
+    }));
+  };
+  return [value, setValue] as const;
+}
