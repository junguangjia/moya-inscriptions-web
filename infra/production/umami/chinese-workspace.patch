+export const CHINA_PROVINCES = [
+  [110000, 'CN-BJ', '北京市'],
+  [120000, 'CN-TJ', '天津市'],
+  [130000, 'CN-HE', '河北省'],
+  [140000, 'CN-SX', '山西省'],
+  [150000, 'CN-NM', '内蒙古自治区'],
+  [210000, 'CN-LN', '辽宁省'],
+  [220000, 'CN-JL', '吉林省'],
+  [230000, 'CN-HL', '黑龙江省'],
+  [310000, 'CN-SH', '上海市'],
+  [320000, 'CN-JS', '江苏省'],
+  [330000, 'CN-ZJ', '浙江省'],
+  [340000, 'CN-AH', '安徽省'],
+  [350000, 'CN-FJ', '福建省'],
+  [360000, 'CN-JX', '江西省'],
+  [370000, 'CN-SD', '山东省'],
+  [410000, 'CN-HA', '河南省'],
+  [420000, 'CN-HB', '湖北省'],
+  [430000, 'CN-HN', '湖南省'],
+  [440000, 'CN-GD', '广东省'],
+  [450000, 'CN-GX', '广西壮族自治区'],
+  [460000, 'CN-HI', '海南省'],
+  [500000, 'CN-CQ', '重庆市'],
+  [510000, 'CN-SC', '四川省'],
+  [520000, 'CN-GZ', '贵州省'],
+  [530000, 'CN-YN', '云南省'],
+  [540000, 'CN-XZ', '西藏自治区'],
+  [610000, 'CN-SN', '陕西省'],
+  [620000, 'CN-GS', '甘肃省'],
+  [630000, 'CN-QH', '青海省'],
+  [640000, 'CN-NX', '宁夏回族自治区'],
+  [650000, 'CN-XJ', '新疆维吾尔自治区'],
+  [710000, 'CN-TW', '台湾省'],
+  [810000, 'CN-HK', '香港特别行政区'],
+  [820000, 'CN-MO', '澳门特别行政区'],
+] as const;
+
+export const CHINA_MAP = {
+  path: '/maps/china-provinces.json?v=99adfeded5223848bbe37a0a12f8023e11ee12161c7800521c27db42fdeac275',
+  width: 800,
+  height: 640,
+  // Fitted to the entire unmodified source geometry, including its southern lines.
+  center: [104.2990125, 31.769817845138974] as [number, number],
+  scale: 551.356886295253,
+} as const;
+export const GEOGRAPHY_PAGE_SIZE = 100;
+export type GeographyMetric = { x: string; y: number; country?: string };
+export const chinaCountry = (country: string) => ['CN', 'TW', 'HK', 'MO'].includes(country);
+
+/**
+ * This fixed China asset uses counterclockwise exterior rings. D3's spherical
+ * renderer expects clockwise exteriors for these sub-hemisphere polygons.
+ * Rewind each exterior/hole independently, without changing the source asset.
+ * Its longitude bounds do not cross the antimeridian, so planar ring winding
+ * determines the required orientation here. Non-polygon geometry is untouched.
+ */
+export function prepareChinaMapGeometry(collection: any) {
+  const rewindPolygon = (rings: number[][][]) =>
+    rings.map((ring, index) => {
+      let area = 0;
+      for (
+        let current = 0, previous = ring.length - 1;
+        current < ring.length;
+        previous = current++
+      ) {
+        area += ring[previous][0] * ring[current][1] - ring[current][0] * ring[previous][1];
+      }
+      const reverse = index === 0 ? area > 0 : area < 0;
+      return reverse ? ring.slice().reverse() : ring;
+    });
+  return {
+    ...collection,
+    features: collection.features.map((feature: any) => {
+      const geometry = feature.geometry;
+      const coordinates =
+        geometry.type === 'Polygon'
+          ? rewindPolygon(geometry.coordinates)
+          : geometry.type === 'MultiPolygon'
+            ? geometry.coordinates.map(rewindPolygon)
+            : undefined;
+      return coordinates ? { ...feature, geometry: { ...geometry, coordinates } } : feature;
+    }),
+  };
+}
+
+export function chinaProvinceKey(value: unknown): string | undefined {
+  if (typeof value !== 'string') return undefined;
+  if (value === 'TW' || value.startsWith('TW-')) return 'CN-TW';
+  if (value === 'HK' || value.startsWith('HK-')) return 'CN-HK';
+  if (value === 'MO' || value.startsWith('MO-')) return 'CN-MO';
+  return CHINA_PROVINCES.some(([, key]) => key === value) ? value : undefined;
+}
+
+export function provinceForGeometry(adcode: unknown) {
+  return CHINA_PROVINCES.find(([code]) => String(code) === String(adcode));
+}
+
+export function provinceMetrics(rows: GeographyMetric[] = []): Map<string, number> {
+  const result = new Map<string, number>();
+  for (const row of rows) {
+    const key = chinaProvinceKey(row.x);
+    if (!key || !Number.isFinite(row.y) || row.y < 0) continue;
+    result.set(key, (result.get(key) ?? 0) + row.y);
+  }
+  return result;
+}
+
+const municipalities = [
+  ['CN-BJ', 'Beijing', '北京'],
+  ['CN-TJ', 'Tianjin', '天津'],
+  ['CN-SH', 'Shanghai', '上海'],
+  ['CN-CQ', 'Chongqing', '重庆'],
+] as const;
+
+/** An English token alone is not enough to override an ambiguous dictionary. */
+export function municipalityCityName(city: string, country?: string, region?: string) {
+  if (country !== 'CN') return undefined;
+  return municipalities.find(([key, sourceCity]) => key === region && sourceCity === city)?.[2];
+}
+
+export function chinaSearchCountry(filters: Record<string, unknown>): string | undefined {
+  if (typeof filters.country === 'string' && filters.country)
+    return filters.country === 'eq.CN' ? 'CN' : undefined;
+  const region = typeof filters.region === 'string' ? filters.region.replace(/^eq\./, '') : '';
+  return chinaProvinceKey(region) ? 'CN' : undefined;
+}
+
+export function municipalitySearchMatches(search: string) {
+  const query = search.normalize('NFKC').trim().replace(/市$/, '');
+  return query ? municipalities.filter(([, , name]) => name.includes(query)) : [];
+}
+
+export function municipalitySearchTokens(search: string, country?: string): string[] {
+  return country === 'CN' ? municipalitySearchMatches(search).map(([, token]) => token) : [];
+}
+
+export function clearGeographyFilters(query: Record<string, unknown>) {
+  return Object.fromEntries(
+    [
+      ...new Set([
+        'country',
+        'region',
+        'city',
+        ...Object.keys(query).filter(key => /^(country|region|city)\d*$/.test(key)),
+      ]),
+    ].map(key => [key, undefined]),
+  );
+}
+
+/** Keep a clicked native city bucket inside its source-country display scope. */
+export function cityFilterParameters(country: string | undefined, query: Record<string, string>) {
+  // Adding a country to an OR group broadens it; saved definitions may restore
+  // an OR match server-side even when the URL itself has no match parameter.
+  if (
+    (query.match !== undefined && query.match !== 'all') ||
+    query.segment !== undefined ||
+    query.cohort !== undefined
+  )
+    return {};
+  if (!country || !/^[A-Z]{2}$/.test(country)) return {};
+  const cleared = Object.fromEntries(
+    Object.keys(query)
+      .filter(key => /^(country|city)\d*$/.test(key))
+      .map(key => [key, undefined]),
+  );
+  const province = { TW: 'CN-TW', HK: 'CN-HK', MO: 'CN-MO' }[country];
+  return {
+    ...cleared,
+    country: `eq.${chinaCountry(country) ? 'CN' : country}`,
+    ...(province ? { region: `eq.${province}` } : {}),
+  };
+}
