+  const clicked = await getSessionMetrics(
+    'synthetic-website',
+    { type: 'city' },
+    { ...filters, ...query, ...cityFilterParameters('CN', query), city: 'eq.Beijing' },
+  );
+  expect(clicked).toEqual(original);
+  expect(clicked.find(row => row.x === 'Shanghai')).toMatchObject({ y: 1 });
