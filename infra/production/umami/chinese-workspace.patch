+import { CHINA_PROVINCES, municipalitySearchMatches } from './artvenn-china-map';
+import { getChineseCityMatches, getChineseRegionName } from './artvenn-geography';
+import regions from '../../public/iso-3166-2.json';
+
+/** Search is an additional AND constraint, never a replacement for a selected city/region. */
+export function geographySearchSql(type: string, column: string, filters: Record<string, any>) {
+  const search = typeof filters.search === 'string' ? filters.search.trim() : '';
+  const params: Record<string, string> = {};
+  if (!search || !['city', 'region'].includes(type)) return { clause: '', params };
+  const translated = /\p{Script=Han}/u.test(search)
+    ? type === 'city'
+      ? getChineseCityMatches(search).filter(
+          (value) => !['Beijing', 'Tianjin', 'Shanghai', 'Chongqing'].includes(value),
+        )
+      : [...new Set([...Object.keys(regions), ...CHINA_PROVINCES.map(([, key]) => key)])].filter(
+          (key) => getChineseRegionName(key)?.includes(search),
+        )
+    : [];
+  params.artvennSearch = `%${search}%`;
+  const choices = [`lower(${column}) like lower({{artvennSearch}})`];
+  if (translated.length) {
+    const keys = translated.map((value, index) => {
+      const key = `artvennSearch${index}`;
+      params[key] = value;
+      return `{{${key}}}`;
+    });
+    choices.push(`${column} in (${keys.join(', ')})`);
+  }
+  if (type === 'city' && /\p{Script=Han}/u.test(search)) {
+    for (const [index, [region, token]] of municipalitySearchMatches(search).entries()) {
+      const prefix = `artvennMunicipality${index}`;
+      params[`${prefix}Country`] = 'CN';
+      params[`${prefix}Region`] = region;
+      params[`${prefix}City`] = token;
+      choices.push(
+        `(session.country = {{${prefix}Country}} and session.region = {{${prefix}Region}} and session.city = {{${prefix}City}})`,
+      );
+    }
+  }
+  return { clause: `and (${choices.join(' or ')})`, params };
+}
