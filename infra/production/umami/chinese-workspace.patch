+    region: null,
+    displayName: `合成城市${index + 1}`,
+  }));
+  let captured: Blob | undefined;
+  const OriginalURL = URL;
+  class FixtureURL extends OriginalURL {
+    static createObjectURL(value: Blob | MediaSource): string {
+      if (!(value instanceof Blob)) throw new Error('EXPECTED_CSV_BLOB');
+      captured = value;
+      return 'blob:synthetic-download';
+    }
