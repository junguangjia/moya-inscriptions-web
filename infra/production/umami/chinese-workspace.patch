+'use client';
+import { type ReactNode, useEffect, useRef, useState } from 'react';
+import { Panel } from '@/components/common/Panel';
+import { useNavigation } from '@/components/hooks';
+import { ArchiveAnalysisContext } from '@/components/hooks/context/ArchiveAnalysisContext';
+import {
+  ANALYSIS_GROUPS,
+  type AnalysisCapability,
+  analysisCapability,
+  analysisGroup,
+  analysisNavigationParameters,
+  CAPABILITY_LABELS,
+  capabilityPath,
+} from '@/lib/archive-analysis';
+import { AttributionPage } from './(reports)/attribution/AttributionPage';
+import { BreakdownPage } from './(reports)/breakdown/BreakdownPage';
+import { FunnelsPage } from './(reports)/funnels/FunnelsPage';
+import { GoalsPage } from './(reports)/goals/GoalsPage';
+import { HeatmapsPage } from './(reports)/heatmaps/HeatmapsPage';
+import { JourneysPage } from './(reports)/journeys/JourneysPage';
+import { PerformancePage } from './(reports)/performance/PerformancePage';
+import { RetentionPage } from './(reports)/retention/RetentionPage';
+import { RevenuePage } from './(reports)/revenue/RevenuePage';
+import { UTMPage } from './(reports)/utm/UTMPage';
+import styles from './ArchiveAnalysis.module.css';
+import { CohortsPage } from './cohorts/CohortsPage';
+import { ComparePage } from './compare/ComparePage';
+import { EventsPage } from './events/EventsPage';
+import { RealtimePage } from './realtime/RealtimePage';
+import { ReplayModal } from './replays/ReplayModal';
+import { ReplaysPage } from './replays/ReplaysPage';
+import { SegmentsPage } from './segments/SegmentsPage';
+import { SessionModal } from './sessions/SessionModal';
+import { SessionsPage } from './sessions/SessionsPage';
+import { WebsiteControls } from './WebsiteControls';
+import { WebsiteExpandedView } from './WebsiteExpandedView';
+import { WebsitePage } from './WebsitePage';
+
+const LEAVES = {
+  overview: WebsitePage,
+  compare: ComparePage,
+  performance: PerformancePage,
+  breakdown: BreakdownPage,
+  sessions: SessionsPage,
+  realtime: RealtimePage,
+  replays: ReplaysPage,
+  segments: SegmentsPage,
+  cohorts: CohortsPage,
+  events: EventsPage,
+  heatmaps: HeatmapsPage,
+  goals: GoalsPage,
+  funnel: FunnelsPage,
+  journeys: JourneysPage,
+  retention: RetentionPage,
+  utm: UTMPage,
+  revenue: RevenuePage,
+  attribution: AttributionPage,
+};
+const HEAVY: readonly string[] = [
+  'compare',
+  'performance',
+  'breakdown',
+  'realtime',
+  'replays',
+  'heatmaps',
+  'journeys',
+  'retention',
+  'attribution',
+];
+
+/** Compose the existing report leaves; their native queries and detail routes stay intact. */
+export function ArchiveAnalysis({
+  websiteId,
+  children,
+}: {
+  websiteId: string;
+  children: ReactNode;
+}) {
+  const { pathname, query, renderUrl, router, updateParams } = useNavigation();
+  const capability = analysisCapability(pathname, websiteId);
+  const moreFocus = useRef<HTMLElement | null>(null);
+  const showMore = !!query.view && (capability !== 'compare' || query.analysisMore === '1');
+  useEffect(() => {
+    if (showMore) {
+      moreFocus.current =
+        document.activeElement instanceof HTMLElement ? document.activeElement : null;
+      document.getElementById('analysis-details-title')?.focus();
+      document.getElementById('analysis-details')?.scrollIntoView?.({ block: 'start' });
+    }
+  }, [showMore]);
+  const [values, setValues] = useState<Record<string, unknown>>({});
+  useEffect(() => {
+    setValues({});
+  }, [websiteId]);
+  useEffect(() => {
+    if (capability && capability !== analysisGroup(capability).capabilities[0]) {
+      document.getElementById(`analysis-${capability}`)?.scrollIntoView?.({ block: 'start' });
+    }
+  }, [capability]);
+  useEffect(() => {
+    const active = document.querySelector<HTMLElement>(
+      'nav[aria-label="分析板块"] a[aria-current="page"]',
+    );
+    if (active?.parentElement)
+      active.parentElement.scrollLeft = Math.max(
+        0,
+        active.offsetLeft - active.parentElement.offsetLeft,
+      );
+  }, [capability]);
+  if (!capability) return children;
+  const group = analysisGroup(capability);
+  const path = (id: AnalysisCapability) =>
+    renderUrl(`/websites/${websiteId}${capabilityPath(id)}`, {
+      ...analysisNavigationParameters(capability, id, query),
+    });
+  const navigate = (id: AnalysisCapability) => router.push(path(id), { scroll: false });
+  const isOpen = (id: AnalysisCapability) => !HEAVY.includes(id) || capability === id;
+  const section = (id: AnalysisCapability) => {
+    const Leaf = LEAVES[id];
+    const heavy = HEAVY.includes(id);
+    const open = isOpen(id);
+    return (
+      <section
+        key={id}
+        id={`analysis-${id}`}
+        className={styles.section}
+        data-analysis-capability={id}
+      >
+        {id !== 'overview' && (
+          <header className={styles.sectionHeader}>
+            {heavy ? (
+              <button
+                type="button"
+                aria-expanded={open}
+                aria-controls={`analysis-content-${id}`}
+                onClick={() => navigate(open ? group.capabilities[0] : id)}
+              >
+                <span>{CAPABILITY_LABELS[id]}</span>
+                <small>
+                  {open ? '收起' : '展开'} {open ? '−' : '+'}
+                </small>
+              </button>
+            ) : (
+              <h2>{CAPABILITY_LABELS[id]}</h2>
+            )}
+          </header>
+        )}
+        {open && (
+          <ArchiveAnalysisContext.Provider
+            value={{ leaf: id, activeLeaf: capability, embedded: true, values, setValues }}
+          >
+            <div id={`analysis-content-${id}`}>
+              {id === 'realtime' && (
+                <p className={styles.note}>
+                  实时动态采用原有实时统计窗口，不受上方日期及筛选影响。
+                </p>
+              )}
+              {id === 'retention' && <p className={styles.note}>回访情况按独立选择的月份统计。</p>}
+              <Leaf websiteId={websiteId} />
+            </div>
+          </ArchiveAnalysisContext.Provider>
+        )}
+      </section>
+    );
+  };
+  const content =
+    group.id === 'visitors' ? (
+      <>
+        {section('sessions')}
+        {section('realtime')}
+        {section('replays')}
+        <section className={styles.section}>
+          <h2>已保存的访客条件</h2>
+          <div className={styles.pair}>
+            {section('segments')}
+            {section('cohorts')}
+          </div>
+        </section>
+      </>
+    ) : group.id === 'goals' ? (
+      <>
+        <div className={styles.pair}>
+          {section('goals')}
+          {section('funnel')}
+        </div>
+        {section('journeys')}
+        {section('retention')}
+      </>
+    ) : (
+      group.capabilities.map(section)
+    );
+  const commonScope = {
+    leaf: group.id === 'interaction' ? 'events' : capability,
+    activeLeaf: capability,
+    embedded: false,
+    values,
+    setValues,
+  };
+  return (
+    <>
+      <div className={styles.toolbar}>
+        <nav className={styles.groups} aria-label="分析板块">
+          {ANALYSIS_GROUPS.map(item => (
+            <a
+              key={item.id}
+              href={path(item.capabilities[0])}
+              aria-current={item.id === group.id ? 'page' : undefined}
+              onClick={event => {
+                if (!event.metaKey && !event.ctrlKey && !event.shiftKey && event.button === 0) {
+                  event.preventDefault();
+                  navigate(item.capabilities[0]);
+                }
+              }}
+            >
+              {item.label}
+            </a>
+          ))}
+        </nav>
+        <div className={styles.controls}>
+          <ArchiveAnalysisContext.Provider value={commonScope}>
+            <WebsiteControls
+              websiteId={websiteId}
+              allowBounceFilter={group.id === 'overview'}
+              allowCompare={capability === 'compare'}
+            />
+          </ArchiveAnalysisContext.Provider>
+        </div>
+      </div>
+      <div className={styles.group} data-analysis-group={group.id}>
+        {content}
+      </div>
+      <ArchiveAnalysisContext.Provider value={{ ...commonScope, leaf: capability }}>
+        <SessionModal websiteId={websiteId} />
+        <ReplayModal websiteId={websiteId} />
+        {showMore && (
+          <Panel data-analysis-more id="analysis-details">
+            <h2 id="analysis-details-title" tabIndex={-1}>
+              详细分析
+            </h2>
+            <WebsiteExpandedView
+              websiteId={websiteId}
+              inline
+              onClose={() => {
+                router.push(updateParams({ view: undefined, analysisMore: undefined }), {
+                  scroll: false,
+                });
+                moreFocus.current?.focus();
+              }}
+            />
+          </Panel>
+        )}
+      </ArchiveAnalysisContext.Provider>
+    </>
+  );
+}
