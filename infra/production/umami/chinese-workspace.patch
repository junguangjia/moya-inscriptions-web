+'use client';
+import { useId } from 'react';
+import { useMessages, useNavigation } from '@/components/hooks';
+import { WebsiteSelect } from '@/components/input/WebsiteSelect';
+import { BoardSelect } from '@/components/input/BoardSelect';
+import { LinkSelect } from '@/components/input/LinkSelect';
+import { PixelSelect } from '@/components/input/PixelSelect';
+import { analysisPages } from '@/lib/analysis-navigation';
+import { archiveAdminMode } from '@/lib/archive-admin';
+import { LAST_TEAM_CONFIG } from '@/lib/constants';
+import { getItem } from '@/lib/storage';
+import { ArchiveReportNav } from './websites/[websiteId]/ArchiveReportNav';
+import styles from './ArchiveShell.module.css';
+
+export function ArchiveContextNav() {
+  const id = useId();
+  const { pathname, router, renderUrl, websiteId, boardId, linkId, pixelId, teamId } =
+    useNavigation();
+  const { t, labels } = useMessages();
+  const selected =
+    analysisPages.find(item => new RegExp(`/${item.id}(?:/|$)`).test(pathname))?.id || 'websites';
+  const analysisUrl = (path: string) => {
+    if (archiveAdminMode && !teamId) {
+      const previous = getItem(LAST_TEAM_CONFIG);
+      if (
+        typeof previous === 'string' &&
+        /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/iu.test(previous)
+      )
+        return `/teams/${previous.toLowerCase()}${path}`;
+    }
+    return renderUrl(path, false);
+  };
+  const navigate = (path: string, value: string | number | null) => {
+    if (value !== null && value !== undefined && value !== '')
+      router.push(analysisUrl(`${path}/${value}`));
+  };
+  const buttonProps = { style: { minWidth: 0, maxWidth: '100%' } };
+  return (
+    <nav className={styles.contextBar} aria-label="分析内容与数据范围">
+      <div className={styles.contextRow}>
+        <label htmlFor={id}>分析内容</label>
+        <select
+          id={id}
+          aria-label="分析内容"
+          value={selected}
+          onChange={event => {
+            const page = analysisPages.find(item => item.id === event.currentTarget.value);
+            if (page) router.push(page.id === 'dashboard' ? page.path : analysisUrl(page.path));
+          }}
+        >
+          {analysisPages.map(page => (
+            <option key={page.id} value={page.id}>
+              {t(labels[page.id])}
+            </option>
+          ))}
+        </select>
+        {websiteId && (
+          <div className={styles.scopeSelect}>
+            <WebsiteSelect
+              websiteId={websiteId}
+              teamId={teamId}
+              label="统计站点"
+              aria-label="统计站点"
+              buttonProps={buttonProps}
+              onChange={value => navigate('/websites', value)}
+            />
+          </div>
+        )}
+        {boardId && (
+          <div className={styles.scopeSelect}>
+            <BoardSelect
+              boardId={boardId}
+              teamId={teamId}
+              label="统计看板"
+              aria-label="统计看板"
+              buttonProps={buttonProps}
+              onChange={value => navigate('/boards', value)}
+            />
+          </div>
+        )}
+        {linkId && (
+          <div className={styles.scopeSelect}>
+            <LinkSelect
+              linkId={linkId}
+              teamId={teamId}
+              label="统计链接"
+              aria-label="统计链接"
+              buttonProps={buttonProps}
+              onChange={value => navigate('/links', value)}
+            />
+          </div>
+        )}
+        {pixelId && (
+          <div className={styles.scopeSelect}>
+            <PixelSelect
+              pixelId={pixelId}
+              teamId={teamId}
+              label="统计像素"
+              aria-label="统计像素"
+              buttonProps={buttonProps}
+              onChange={value => navigate('/pixels', value)}
+            />
+          </div>
+        )}
+        {websiteId && <ArchiveReportNav websiteId={websiteId} />}
+        <span className={styles.readOnly}>只读分析</span>
+      </div>
+    </nav>
+  );
+}
