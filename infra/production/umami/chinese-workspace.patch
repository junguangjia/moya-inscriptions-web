+/** Display-only PostgreSQL geography. Persisted GeoIP source values stay intact. */
+export function getArtVennGeographySql(column: string, table: 'session' | '' = 'session'): string {
+  const prefix = table ? `${table}.` : '';
+
+  if (column === 'country') {
+    return `(case when ${prefix}country in ('TW', 'HK', 'MO') then 'CN' else ${prefix}country end)`;
+  }
+
+  if (column === 'region') {
+    return `(case when ${prefix}country = 'TW' then 'CN-TW' when ${prefix}country = 'HK' then 'CN-HK' when ${prefix}country = 'MO' then 'CN-MO' else ${prefix}region end)`;
+  }
+
+  return `${prefix}${column}`;
+}
