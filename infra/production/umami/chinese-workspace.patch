+import { DatabaseSync } from 'node:sqlite';
+import { afterEach, beforeEach, expect, test, vi } from 'vitest';
+
+const runtime = vi.hoisted(() => ({ rawQuery: vi.fn() }));
+vi.mock('@/lib/db', () => ({
+  PRISMA: 'prisma',
+  CLICKHOUSE: 'clickhouse',
+  runQuery: (queries: Record<string, () => unknown>) => queries.prisma(),
+}));
+vi.mock('@/lib/clickhouse', () => ({ default: {} }));
+vi.mock('@/lib/prisma', () => ({
+  default: {
+    rawQuery: runtime.rawQuery,
+    getTimestampDiffSQL: () => '0',
+    parseFilters: (filters: Record<string, any>) => {
+      const queryParams = {};
+      const clauses = ['city', 'country', 'region', 'path']
+        .filter(key => filters[key])
+        .map(key => {
+          queryParams[`selected${key}`] = String(filters[key]).replace(/^eq\./, '');
+          const column =
+            key === 'country'
+              ? "(case when session.country in ('TW','HK','MO') then 'CN' else session.country end)"
+              : key === 'region'
+                ? "(case when session.country = 'TW' then 'CN-TW' when session.country = 'HK' then 'CN-HK' when session.country = 'MO' then 'CN-MO' else session.region end)"
+                : key === 'path'
+                  ? 'website_event.url_path'
+                  : 'session.city';
+          return `${column} = {{selected${key}}}`;
+        });
+      return {
+        filterQuery: clauses.length
+          ? `and (${clauses.join(filters.match === 'any' ? ' or ' : ' and ')})`
+          : '',
+        joinSessionQuery: 'join session on session.session_id = website_event.session_id',
+        cohortQuery: '',
+        excludeBounceQuery: '',
+        queryParams,
+      };
+    },
+  },
+}));
+import { getSessionMetrics } from './getSessionMetrics';
+import { getSessionExpandedMetrics } from './getSessionExpandedMetrics';
+import { municipalityCityName, cityFilterParameters } from '@/lib/artvenn-china-map';
+
+let database: DatabaseSync;
+beforeEach(() => {
+  database = new DatabaseSync(':memory:');
+  database.exec(
+    'create table session(session_id text, country text, region text, city text); create table website_event(website_id text, session_id text, visit_id text, created_at text, event_type integer, url_path text);',
+  );
+  runtime.rawQuery.mockImplementation((sql: string, params: Record<string, any>) => {
+    const values: string[] = [];
+    const bound = sql
+      .replaceAll('{{websiteId::uuid}}', "'synthetic-website'")
+      .replaceAll('{{startDate}}', "'2026-01-01'")
+      .replaceAll('{{endDate}}', "'2026-02-01'")
+      .replace(/\{\{([A-Za-z0-9_]+)(?:::[^}]+)?\}\}/g, (_, key) => {
+        values.push(params[key]);
+        return '?';
+      });
+    return database.prepare(bound).all(...values);
+  });
+});
+afterEach(() => database.close());
+const insert = (id: string, country: string, region: string | null, city: string) => {
+  database.prepare('insert into session values(?,?,?,?)').run(id, country, region, city);
+  database
+    .prepare(
+      'insert into website_event(website_id,session_id,visit_id,created_at,event_type) values(?,?,?,?,?)',
+    )
+    .run('synthetic-website', id, `${id}-visit`, '2026-01-07', 1);
+};
+const filters = { startDate: new Date('2026-01-01'), endDate: new Date('2026-02-01') };
+
+test('known municipal context supplies a Chinese alias while preserving the existing city/country visitor bucket', async () => {
+  insert('synthetic-a', 'CN', 'CN-BJ', 'Beijing');
+  insert('synthetic-b', 'CN', 'CN-BJ', 'Beijing');
+  const rows = await getSessionMetrics('synthetic-website', { type: 'city', limit: 100 }, filters);
+  expect(rows).toHaveLength(1);
+  expect(rows[0]).toMatchObject({ x: 'Beijing', y: 2, country: 'CN', region: 'CN-BJ' });
+  expect(municipalityCityName(rows[0].x, rows[0].country, rows[0].region)).toBe('北京');
+  const expanded = await getSessionExpandedMetrics(
+    'synthetic-website',
+    { type: 'city', limit: 100 },
+    filters,
+  );
+  expect(expanded[0]).toMatchObject({ name: 'Beijing', visitors: 2, region: 'CN-BJ' });
+});
+
+test.each(['CN-HE', null])(
+  'a mixed or missing region stays unassigned without splitting or relabeling the city bucket (%s)',
+  async region => {
+    insert('synthetic-a', 'CN', 'CN-BJ', 'Beijing');
+    insert('synthetic-b', 'CN', region, 'Beijing');
+    const rows = await getSessionMetrics(
+      'synthetic-website',
+      { type: 'city', limit: 100 },
+      filters,
+    );
+    expect(rows).toHaveLength(1);
+    expect(rows[0]).toMatchObject({ x: 'Beijing', y: 2, region: null });
+    expect(municipalityCityName(rows[0].x, rows[0].country, rows[0].region)).toBeUndefined();
+    const expanded = await getSessionExpandedMetrics(
+      'synthetic-website',
+      { type: 'city', limit: 100 },
+      filters,
+    );
+    expect(expanded[0]).toMatchObject({ name: 'Beijing', visitors: 2, region: null });
+  },
+);
+
+test('Taiwan, Hong Kong and Macau are display provinces; no raw geography field is rewritten', async () => {
+  insert('synthetic-tw', 'TW', 'TW-TPE', 'Taipei');
+  insert('synthetic-hk', 'HK', null, 'Hong Kong');
+  insert('synthetic-mo', 'MO', null, 'Macau');
+  const raw = database.prepare('select * from session order by session_id').all();
+  const rows = await getSessionMetrics(
+    'synthetic-website',
+    { type: 'region', limit: 100 },
+    filters,
+  );
+  expect(rows).toHaveLength(3);
+  expect(new Set(rows.map(row => row.x))).toEqual(new Set(['CN-TW', 'CN-HK', 'CN-MO']));
+  expect(rows.every(row => row.country === 'CN')).toBe(true);
+  const countries = await getSessionMetrics(
+    'synthetic-website',
+    { type: 'country', limit: 100 },
+    filters,
+  );
+  expect(countries).toEqual([{ x: 'CN', y: 3 }]);
+  expect(database.prepare('select * from session order by session_id').all()).toEqual(raw);
+});
+
+test('Chinese city search narrows the current date and selected city instead of replacing it', async () => {
+  insert('synthetic-a', 'CN', 'CN-BJ', 'Beijing');
+  insert('synthetic-b', 'CN', 'CN-GD', 'Guangzhou');
+  const found = await getSessionExpandedMetrics(
+    'synthetic-website',
+    { type: 'city', limit: 100 },
+    { ...filters, country: 'eq.CN', search: '北京' },
+  );
+  expect(found).toHaveLength(1);
+  expect(found[0]).toMatchObject({ name: 'Beijing', visitors: 1, region: 'CN-BJ' });
+  const excluded = await getSessionExpandedMetrics(
+    'synthetic-website',
+    { type: 'city', limit: 100 },
+    { ...filters, city: 'eq.Guangzhou', country: 'eq.CN', search: '北京' },
+  );
+  expect(excluded).toEqual([]);
+});
+
+test('municipal search without a country filter matches only the exact known place, never a foreign or different-region namesake', async () => {
+  insert('synthetic-capital', 'CN', 'CN-BJ', 'Beijing');
+  insert('synthetic-namesake', 'CN', 'CN-HE', 'Beijing');
+  insert('synthetic-foreign', 'US', 'US-WA', 'Beijing');
+  const rows = await getSessionExpandedMetrics(
+    'synthetic-website',
+    { type: 'city', limit: 100 },
+    { ...filters, search: '北京' },
+  );
+  expect(rows).toHaveLength(1);
+  expect(rows[0]).toMatchObject({ name: 'Beijing', visitors: 1, country: 'CN', region: 'CN-BJ' });
+});
+
+test('the selected city link country constrains the real metrics SELECT against a foreign namesake', async () => {
+  insert('synthetic-capital', 'CN', 'CN-BJ', 'Beijing');
+  insert('synthetic-foreign', 'US', 'US-WA', 'Beijing');
+  const before = database.prepare('select * from session order by session_id').all();
+  const selected = { ...filters, ...cityFilterParameters('CN', {}), city: 'eq.Beijing' };
+  const rows = await getSessionMetrics('synthetic-website', { type: 'city', limit: 100 }, selected);
+  expect(rows).toHaveLength(1);
+  expect(rows[0]).toMatchObject({ x: 'Beijing', y: 1, country: 'CN', region: 'CN-BJ' });
+  const expanded = await getSessionExpandedMetrics(
+    'synthetic-website',
+    { type: 'city', limit: 100 },
+    selected,
+  );
+  expect(expanded).toHaveLength(1);
+  expect(expanded[0]).toMatchObject({
+    name: 'Beijing',
+    visitors: 1,
+    country: 'CN',
+    region: 'CN-BJ',
+  });
+  expect(database.prepare('select * from session order by session_id').all()).toEqual(before);
+});
+
+test('a city click preserves original path OR city results without including country-only Shanghai rows', async () => {
+  insert('synthetic-path-hit', 'CN', 'CN-SH', 'Shanghai');
+  insert('synthetic-city-hit', 'CN', 'CN-BJ', 'Beijing');
+  insert('synthetic-country-only', 'CN', 'CN-SH', 'Shanghai');
+  insert('synthetic-foreign-name', 'US', 'US-WA', 'Beijing');
+  database
+    .prepare('update website_event set url_path = ? where session_id = ?')
+    .run('/foo', 'synthetic-path-hit');
