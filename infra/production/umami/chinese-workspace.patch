+'use client';
+import { Button, Heading, Tab, TabList, TabPanel, Tabs } from '@umami/react-zen';
+import { useState } from 'react';
+import { Panel } from '@/components/common/Panel';
+import { MetricsExpandedTable } from '@/components/metrics/MetricsExpandedTable';
+import { MetricsTable } from '@/components/metrics/MetricsTable';
+import { WorldMap } from '@/components/metrics/WorldMap';
+import styles from './ArchiveAnalysis.module.css';
+
+export function ArchiveGeography({ websiteId }: { websiteId: string }) {
+  const [tab, setTab] = useState('region');
+  const [expanded, setExpanded] = useState(false);
+  const items = [
+    { id: 'country', label: '国家与地区' },
+    { id: 'region', label: '省份' },
+    { id: 'city', label: '城市' },
+  ];
+  return (
+    <Panel minWidth="0">
+      <Heading size="xl">访问地域</Heading>
+      <div className={styles.geography}>
+        <WorldMap websiteId={websiteId} />
+        <div className={styles.geographyList}>
+          <Tabs
+            selectedKey={tab}
+            onSelectionChange={key => {
+              setTab(String(key));
+              setExpanded(false);
+            }}
+          >
+            <TabList>
+              {items.map(item => (
+                <Tab id={item.id} key={item.id}>
+                  {item.label}
+                </Tab>
+              ))}
+            </TabList>
+            {items.map(item => (
+              <TabPanel id={item.id} key={item.id}>
+                {expanded ? (
+                  <MetricsExpandedTable
+                    websiteId={websiteId}
+                    type={item.id}
+                    title={item.label}
+                    inline
+                  />
+                ) : (
+                  <MetricsTable
+                    websiteId={websiteId}
+                    type={item.id}
+                    title={item.label}
+                    limit={10}
+                    metric="访客"
+                    showMore={false}
+                  />
+                )}
+              </TabPanel>
+            ))}
+          </Tabs>
+          <Button variant="quiet" aria-expanded={expanded} onPress={() => setExpanded(!expanded)}>
+            {expanded ? '收起完整列表' : `展开全部${items.find(item => item.id === tab)?.label}`}
+          </Button>
+        </div>
+      </div>
+    </Panel>
+  );
+}
