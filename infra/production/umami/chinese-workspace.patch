+import { fireEvent, render, screen } from '@testing-library/react';
+import { useState } from 'react';
+import { expect, test, vi } from 'vitest';
+import { ArchiveAnalysisContext, useArchiveInput } from './context/ArchiveAnalysisContext';
+
+const fixture = vi.hoisted(() => ({
+  pathname:
+    '/teams/aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa/websites/bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb/heatmaps',
+  params: new URLSearchParams(),
+}));
+vi.mock('next/navigation', () => ({
+  useRouter: () => ({}),
+  usePathname: () => fixture.pathname,
+  useSearchParams: () => fixture.params,
+}));
+vi.mock('./context/useShare', () => ({ useShare: () => null }));
+
+import { useFilterParameters } from './useFilterParameters';
+import { useNavigation } from './useNavigation';
+
+function Probe() {
+  const nav = useNavigation();
+  const filters = useFilterParameters();
+  return (
+    <output data-test="probe">
+      {JSON.stringify({
+        path: nav.pathname,
+        query: nav.query,
+        filters,
+        href: nav.updateParams({ page: 3, search: '局部搜索' }),
+        countryHref: nav.updateParams({ country: 'eq.US' }),
+        dateHref: nav.updateParams({ date: '30day' }),
+      })}
+    </output>
+  );
+}
+function Scope({ leaf, activeLeaf }: { leaf: string; activeLeaf: string }) {
+  const [values, setValues] = useState<Record<string, unknown>>({});
+  return (
+    <ArchiveAnalysisContext.Provider
+      value={{ leaf, activeLeaf, embedded: true, values, setValues }}
+    >
+      <Probe />
+    </ArchiveAnalysisContext.Provider>
+  );
+}
+const read = () => JSON.parse(screen.getByTestId('probe').textContent || '{}');
+test('composed event leaf preserves native epf semantics without changing shared date or business filters', () => {
+  fixture.params = new URLSearchParams({
+    country: 'eq.CN',
+    region: 'eq.CN-BJ',
+    startAt: '1000',
+    endAt: '9000',
+    epf1: 'eq.color.red',
+    spf1: 'eq.kind.reader',
+    segment: 'synthetic-segment',
+    cohort: 'synthetic-cohort',
+    match: 'any',
+    search: 'heatmap-route-search',
+    page: '8',
+    analysisPage_events: '2',
+    analysisSearch_events: 'event-list-search',
+  });
+  const view = render(<Scope leaf="events" activeLeaf="heatmaps" />);
+  const event = read();
+  expect(event.path.endsWith('/events')).toBe(true);
+  expect(event.filters).toMatchObject({
+    country: 'eq.CN',
+    region: 'eq.CN-BJ',
+    epf1: 'eq.color.red',
+    spf1: 'eq.kind.reader',
+    segment: 'synthetic-segment',
+    cohort: 'synthetic-cohort',
+    match: 'any',
+    page: '2',
+    search: 'event-list-search',
+  });
+  expect(event.query).toMatchObject({ startAt: '1000', endAt: '9000' });
+  const link = new URL(event.href, 'http://localhost');
+  expect(link.pathname).toBe(fixture.pathname);
+  expect(link.searchParams.get('analysisPage_events')).toBe('3');
+  expect(link.searchParams.get('page')).toBe('8');
+  expect(link.searchParams.get('country')).toBe('eq.CN');
+  view.rerender(<Scope leaf="heatmaps" activeLeaf="heatmaps" />);
+  expect(read().filters.epf1).toBeUndefined();
+  expect(read().filters.spf1).toBe('eq.kind.reader');
+});
+test('uncomposed native navigation retains its real pathname and original query keys', () => {
+  fixture.params = new URLSearchParams({ page: '4', search: 'original', country: 'eq.US' });
+  render(<Probe />);
+  expect(read().path).toBe(fixture.pathname);
+  expect(read().query).toEqual({ page: '4', search: 'original', country: 'eq.US' });
+  const link = new URL(read().href, 'http://localhost');
+  expect(link.searchParams.get('page')).toBe('3');
+  expect([...link.searchParams.keys()].some(key => key.startsWith('analysis'))).toBe(false);
+});
+
+function Tool() {
+  const [value, setValue] = useArchiveInput('fixture.tool', '原链接选项');
+  return (
+    <input aria-label="工具选项" value={value} onChange={event => setValue(event.target.value)} />
+  );
+}
+function ToggleTool() {
+  const [values, setValues] = useState<Record<string, unknown>>({});
+  const [open, setOpen] = useState(true);
+  return (
+    <ArchiveAnalysisContext.Provider
+      value={{ leaf: 'journeys', activeLeaf: 'journeys', embedded: true, values, setValues }}
+    >
+      <button type="button" onClick={() => setOpen(!open)}>
+        切换工具
+      </button>
+      {open && <Tool />}
+    </ArchiveAnalysisContext.Provider>
+  );
+}
+test('collapsing a heavy tool preserves its original option and later entered input', () => {
+  render(<ToggleTool />);
+  fireEvent.click(screen.getByRole('button', { name: '切换工具' }));
+  fireEvent.click(screen.getByRole('button', { name: '切换工具' }));
+  expect(screen.getByRole('textbox', { name: '工具选项' })).toHaveValue('原链接选项');
+  fireEvent.change(screen.getByRole('textbox', { name: '工具选项' }), {
+    target: { value: '已输入的起点' },
+  });
+  fireEvent.click(screen.getByRole('button', { name: '切换工具' }));
+  fireEvent.click(screen.getByRole('button', { name: '切换工具' }));
+  expect(screen.getByRole('textbox', { name: '工具选项' })).toHaveValue('已输入的起点');
+});
+
+test('a shared country change on realtime resets the visible Sessions list, while an old URL restores its prior page', () => {
+  fixture.pathname =
+    '/teams/aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa/websites/bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb/realtime';
+  fixture.params = new URLSearchParams({
+    analysisPage_sessions: '4',
+    analysisSearch_sessions: 'readers',
+    analysisPage_events: '3',
+    page: '2',
+    search: 'raw-search',
+    date: '7day',
+  });
+  const priorUrl = fixture.params.toString();
+  const result = render(<Scope leaf="sessions" activeLeaf="realtime" />);
+  expect(read().filters.page).toBe('4');
+  const destination = new URL(read().countryHref, 'http://localhost');
+  expect(destination.searchParams.has('page')).toBe(false);
+  expect(destination.searchParams.has('analysisPage_sessions')).toBe(false);
+  expect(destination.searchParams.has('analysisPage_events')).toBe(false);
+  fixture.params = destination.searchParams;
+  result.rerender(<Scope leaf="sessions" activeLeaf="realtime" />);
+  expect(read().filters.page).toBeUndefined();
+  expect(read().filters.search).toBe('readers');
+  expect(read().filters.country).toBe('eq.US');
+  expect(read().query.date).toBe('7day');
+  fixture.params = new URLSearchParams(priorUrl);
+  result.rerender(<Scope leaf="sessions" activeLeaf="realtime" />);
