+  if (typeof name !== 'string') return undefined;
+  if (type === 'event')
+    return Object.hasOwn(CHINESE_EVENT_NAMES, name) ? CHINESE_EVENT_NAMES[name] : undefined;
+  if (type === 'region') return getChineseRegionName(name);
+  if (type !== 'city') return undefined;
+  return getChineseCityName(
+    name,
+    typeof value.country === 'string' ? value.country : undefined,
+    typeof value.region === 'string' ? value.region : undefined,
+  );
+}
