+import { DataGrid, type DataGridProps } from './DataGrid';
+
+function EmptyGrid({ embedded }: { embedded?: boolean }) {
+  const query = {
+    data: { data: [], count: 0, page: 1, pageSize: 20 },
+    isLoading: false,
+    isFetching: false,
+    error: null,
+  } as DataGridProps['query'];
+  const grid = (
+    <DataGrid query={query}>
+      <div>仅在有记录时展示</div>
+    </DataGrid>
+  );
+
+  return embedded === undefined ? (
+    grid
+  ) : (
+    <ArchiveAnalysisContext.Provider
+      value={{
+        leaf: 'segments',
+        activeLeaf: 'segments',
+        embedded,
+        values: {},
+        setValues: () => undefined,
+      }}
+    >
+      {grid}
+    </ArchiveAnalysisContext.Provider>
+  );
+}
+
+beforeEach(() => {
+  runtime.query = {};
+  runtime.push.mockClear();
+  localStorage.clear();
+});
+afterEach(cleanup);
+
+test('an embedded empty table renders its empty state without a 300px minimum height', () => {
+  const { container } = render(<EmptyGrid embedded />);
+  const root = container.firstElementChild;
+  // Real Zen maps the zero sizing preset to a class and literal pixel sizes to inline styles.
+  expect(root).toHaveClass('min-h-0');
+  expect(root).not.toHaveStyle({ minHeight: '300px' });
+  expect(screen.getByText('暂无数据')).toBeDefined();
+  expect(screen.queryByText('仅在有记录时展示')).toBeNull();
+  expect(screen.queryByRole('button')).toBeNull();
+  expect(runtime.push).not.toHaveBeenCalled();
+});
+
+test('a standalone table keeps its original 300px minimum height and empty state', () => {
+  const { container } = render(<EmptyGrid />);
+  expect(container.firstElementChild).toHaveStyle({ minHeight: '300px' });
+  expect(container.firstElementChild).not.toHaveClass('min-h-0');
+  expect(screen.getByText('暂无数据')).toBeDefined();
+  expect(runtime.push).not.toHaveBeenCalled();
+});
+
+test('a non-embedded analysis scope also retains the standalone minimum height', () => {
+  const { container } = render(<EmptyGrid embedded={false} />);
+  expect(container.firstElementChild).toHaveStyle({ minHeight: '300px' });
+  expect(container.firstElementChild).not.toHaveClass('min-h-0');
+  expect(screen.getByText('暂无数据')).toBeDefined();
+});
