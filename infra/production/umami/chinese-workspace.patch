+import { cleanup, render, screen } from '@testing-library/react';
+import type { ReactNode } from 'react';
+import { afterEach, beforeEach, expect, test, vi } from 'vitest';
+
+const state = vi.hoisted(() => ({
+  board: {
+    id: 'synthetic-board',
+    name: '',
+    description: '',
+    type: 'website',
+    parameters: { websiteId: 'synthetic-website' },
+  },
+  websiteName: '合成数据 · 中国省级访问与内容行为示例网站',
+  private: false,
+  renderUrl: vi.fn((url: string) => `/teams/synthetic${url}`),
+}));
+vi.mock('@/lib/archive-admin', () => ({
+  get archiveAdminMode() {
+    return state.private;
+  },
+}));
+vi.mock('@/components/common/LinkButton', () => ({
+  LinkButton: ({ href, children }: { href: string; children: ReactNode }) => (
+    <a href={href}>{children}</a>
+  ),
+}));
+vi.mock('@/components/common/Favicon', () => ({ Favicon: () => <span>网站</span> }));
+vi.mock('@/components/hooks', () => ({
+  useBoard: () => ({ board: state.board }),
+  useNavigation: () => ({ renderUrl: state.renderUrl }),
+  useMessages: () => ({ t: (value: string) => value, labels: { design: '设计', edit: '编辑' } }),
+}));
+vi.mock('@/components/icons', () => ({
+  Edit: () => null,
+  LayoutDashboard: () => null,
+  Grid2x2: () => null,
+  Link: () => null,
+}));
+vi.mock('../BoardCloneButton', () => ({
+  BoardCloneButton: ({ boardId, showLabel }: any) => (
+    <button data-board-id={boardId}>{showLabel ? '复制' : ''}</button>
+  ),
+}));
+vi.mock('../useBoardEntityBadgeProps', () => ({
+  useBoardEntityBadgeProps: () => ({
+    type: 'website',
+    name: state.websiteName,
+    domain: 'synthetic.example',
+  }),
+}));
+
+import { BoardViewHeader } from './BoardViewHeader';
+import { PageHeader } from '@/components/common/PageHeader';
+
+const legacyDescription =
+  'Umami 原生中国省级地图、省市排行与内容行为看板；IP 仅表示近似网络出口，本人、测试与开发活动在采集前排除。';
+beforeEach(() => {
+  state.private = false;
+  state.board.name = 'ArtVenn: 中国省市与内容行为';
+  state.board.description = legacyDescription;
+  state.renderUrl.mockClear();
+});
+afterEach(cleanup);
+
+test('long Board title, website badge and actions can wrap without character-stacked badge text', () => {
+  const { container } = render(<BoardViewHeader />);
+  const header = container.querySelector('[data-page-header]');
+  expect(header).toHaveStyle({ display: 'flex', flexWrap: 'wrap' });
+  expect(header?.firstElementChild).toHaveStyle({ minWidth: '0', maxWidth: '100%' });
+  expect(screen.getByRole('heading')).toHaveStyle({ overflowWrap: 'anywhere' });
+  const actions = screen.getByRole('group', { name: '看板操作' });
+  expect(actions).toHaveStyle({
+    flexWrap: 'wrap',
+    minWidth: '0',
+    maxWidth: '100%',
+    whiteSpace: 'nowrap',
+  });
+  const badge = screen.getByTitle(state.websiteName);
+  expect(badge).toHaveStyle({ whiteSpace: 'nowrap', minWidth: '0' });
+  expect(badge.parentElement).toHaveStyle({ maxWidth: 'min(100%, 20rem)', minWidth: '0' });
+  expect(screen.getByRole('link', { name: '设计' })).toHaveAttribute(
+    'href',
+    '/teams/synthetic/boards/synthetic-board/design',
+  );
+  expect(screen.getByRole('link', { name: '编辑' })).toHaveAttribute(
+    'href',
+    '/teams/synthetic/boards/synthetic-board/edit',
+  );
+  expect(state.renderUrl).toHaveBeenCalledWith('/boards/synthetic-board/design', false);
+  expect(screen.getByRole('button', { name: '复制' })).toHaveAttribute(
+    'data-board-id',
+    'synthetic-board',
+  );
+  expect(screen.getByText('查看省市分布、访问趋势和内容互动。IP 位置仅供参考。')).toBeDefined();
+  expect(state.board.description).toBe(legacyDescription);
+});
+
+test('existing visibility flags still hide actions and the website badge', () => {
+  render(<BoardViewHeader showActions={false} showEntityBadge={false} />);
+  expect(screen.queryByRole('link')).toBeNull();
+  expect(screen.queryByRole('button')).toBeNull();
+  expect(screen.queryByTitle(state.websiteName)).toBeNull();
+});
+
+test('custom Board descriptions are kept as supplied', () => {
+  state.board.description = '自定义业务说明';
+  const view = render(<BoardViewHeader />);
+  expect(screen.getByText('自定义业务说明')).toBeDefined();
+  state.board.name = '自定义看板';
+  state.board.description = legacyDescription;
+  view.rerender(<BoardViewHeader />);
+  expect(screen.getByText(legacyDescription)).toBeDefined();
+});
+
+test('other native PageHeaders retain their existing grid layout by default', () => {
+  const { container } = render(<PageHeader title="其他页面" />);
+  expect(container.querySelector('[data-page-header]')).toHaveClass('grid');
+  expect(container.querySelector('[data-page-header]')?.getAttribute('style')).toBeNull();
+  expect(container.querySelector('style')?.textContent).toContain('grid-template-columns: 1fr 1fr');
+});
+
+test('private Board keeps its read header without offering blocked design/edit/clone writes', () => {
+  state.private = true;
+  render(<BoardViewHeader />);
+  expect(screen.getByRole('heading', { name: 'ArtVenn: 中国省市与内容行为' })).toBeDefined();
+  expect(screen.getByTitle(state.websiteName)).toBeDefined();
+  expect(screen.getByText('只读看板 · 可筛选、查看详情与导出')).toBeDefined();
+  expect(screen.queryByRole('link', { name: '设计' })).toBeNull();
+  expect(screen.queryByRole('link', { name: '编辑' })).toBeNull();
+  expect(screen.queryByRole('button', { name: '复制' })).toBeNull();
+});
