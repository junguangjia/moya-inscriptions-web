+import { FILTER_COLUMNS } from './constants';
+
+export const ANALYSIS_GROUPS = [
+  {
+    id: 'overview',
+    label: '访问概况',
+    capabilities: ['overview', 'compare', 'performance', 'breakdown'],
+  },
+  {
+    id: 'visitors',
+    label: '访客动态',
+    capabilities: ['sessions', 'realtime', 'replays', 'segments', 'cohorts'],
+  },
+  { id: 'interaction', label: '内容互动', capabilities: ['events', 'heatmaps'] },
+  { id: 'goals', label: '目标与回访', capabilities: ['goals', 'funnel', 'journeys', 'retention'] },
+  { id: 'sources', label: '来源与收益', capabilities: ['utm', 'revenue', 'attribution'] },
+] as const;
+
+export type AnalysisCapability = (typeof ANALYSIS_GROUPS)[number]['capabilities'][number];
+export const CAPABILITY_LABELS: Record<AnalysisCapability, string> = {
+  overview: '访问总览',
+  compare: '时段比较',
+  performance: '加载表现',
+  breakdown: '自选维度',
+  sessions: '访问记录',
+  realtime: '实时动态',
+  replays: '访问回放',
+  segments: '访客分组',
+  cohorts: '同期访客条件',
+  events: '内容互动',
+  heatmaps: '点击与滚动',
+  goals: '目标完成',
+  funnel: '转化步骤',
+  journeys: '访问路径',
+  retention: '回访情况',
+  utm: '推广来源',
+  revenue: '收益',
+  attribution: '来源归因',
+};
+export function capabilityPath(id: AnalysisCapability) {
+  return id === 'overview' ? '' : id === 'funnel' ? '/funnels' : `/${id}`;
+}
+export function analysisCapability(pathname: string, websiteId: string): AnalysisCapability | null {
+  if (!pathname.includes(`/websites/${websiteId}`)) return null;
+  const tail = pathname.split(`/websites/${websiteId}`)[1]?.replace(/\/$/, '') ?? '';
+  return (
+    ANALYSIS_GROUPS.flatMap(group => [...group.capabilities]).find(
+      id => capabilityPath(id) === tail,
+    ) ?? null
+  );
+}
+export function analysisGroup(capability: AnalysisCapability) {
+  return (
+    ANALYSIS_GROUPS.find(group => (group.capabilities as readonly string[]).includes(capability)) ??
+    ANALYSIS_GROUPS[0]
+  );
+}
+
+/** Move only list presentation state when another section becomes the route target. */
+export function analysisNavigationParameters(
+  current: AnalysisCapability,
+  target: AnalysisCapability,
+  query: Record<string, string>,
+) {
+  return {
+    ...query,
+    ...(current !== target
+      ? {
+          [`analysisPage_${current}`]: query.page,
+          [`analysisSearch_${current}`]: query.search,
+          page: query[`analysisPage_${target}`],
+          search: query[`analysisSearch_${target}`],
+        }
+      : {}),
+    ...(current === 'compare' && !query.analysisMore && query.view
+      ? { analysisCompare: query.analysisCompare || query.view }
+      : {}),
+    view: undefined,
+    analysisMore: undefined,
+  };
+}
+
+const sharedListFields = new Set(['date', 'offset', 'segment', 'cohort', 'match', 'excludeBounce']);
+function listCriteria(query: Record<string, string | number>) {
+  const values: [string, string][] = [];
+  for (const [key, value] of Object.entries(query)) {
+    if (value === undefined || value === null || value === '') continue;
+    const field = key.replace(/\d+$/, '');
+    const indexedProperty = /^(?:epf|spf)\d+$/.test(key);
+    if (!Object.hasOwn(FILTER_COLUMNS, field) && !indexedProperty && !sharedListFields.has(key))
+      continue;
+    if ((key === 'match' && value === 'all') || (key === 'offset' && String(value) === '0'))
+      continue;
+    values.push([
+      indexedProperty || Object.hasOwn(FILTER_COLUMNS, field) ? field : key,
+      String(value),
+    ]);
+  }
+  return JSON.stringify(
+    values.sort(([ak, av], [bk, bv]) => ak.localeCompare(bk) || av.localeCompare(bv)),
+  );
+}
+
+/** Only a changed shared record scope invalidates the composed lists' page numbers. */
+export function resetArchiveListPages(
+  previous: Record<string, string | number>,
+  next: Record<string, string | number>,
+) {
+  if (listCriteria(previous) === listCriteria(next)) return next;
+  const result: Record<string, string | number> = { ...next, page: undefined };
+  for (const key of new Set([...Object.keys(previous), ...Object.keys(next)])) {
+    if (key.startsWith('analysisPage_')) result[key] = undefined;
+  }
+  return result;
+}
