[Unit]
Description=Yoyi production admin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yoyi-admin
Group=yoyi-admin
WorkingDirectory=/srv/yoyi/current/apps/admin
EnvironmentFile=/etc/yoyi/admin.env
# ExecStart fixes the listener; EnvironmentFile cannot publish the port externally.
ExecStart=/usr/bin/env NODE_ENV=production node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3002
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/yoyi/current/apps/admin/.next/cache
StateDirectory=yoyi-admin
ReadWritePaths=/var/lib/yoyi-admin
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
