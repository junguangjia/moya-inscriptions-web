[Unit]
Description=ArtVenn private bounded operations archive (archive only)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/yoyi/ops-archive.env

[Service]
Type=oneshot
User=root
Group=root
SupplementaryGroups=adm
UMask=0077
WorkingDirectory=/usr/local/lib/yoyi-ops-archive
ExecStart=/opt/node-v24.21.0-linux-x64/bin/node /usr/local/lib/yoyi-ops-archive/ops_archive.mjs --config /etc/yoyi/ops-archive.env
TimeoutStartSec=245
Nice=19
IOSchedulingClass=idle
CPUQuota=20%
MemoryMax=512M
MemorySwapMax=0
TasksMax=32
StateDirectory=yoyi-ops-archive
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/yoyi-ops-archive
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true

