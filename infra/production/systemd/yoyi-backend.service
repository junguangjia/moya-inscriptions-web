[Unit]
Description=Yoyi production backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yoyi-backend
Group=yoyi-backend
WorkingDirectory=/srv/yoyi/current
EnvironmentFile=/etc/yoyi/backend.env
# ExecStart fixes the listener; EnvironmentFile cannot publish the port externally.
ExecStart=/usr/bin/env NODE_ENV=production HOST=127.0.0.1 PORT=3001 node services/backend-production/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillSignal=SIGTERM
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# No writable path: media processing and its job workspace belong to
# yoyi-media-worker.service.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
