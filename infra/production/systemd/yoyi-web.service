[Unit]
Description=Yoyi production web
After=network-online.target yoyi-backend.service
Wants=network-online.target

[Service]
Type=simple
User=yoyi-web
Group=yoyi-web
WorkingDirectory=/srv/yoyi/current/apps/web
EnvironmentFile=/etc/yoyi/web.env
# ExecStart fixes the listener; EnvironmentFile cannot publish the port externally.
ExecStart=/usr/bin/env NODE_ENV=production node scripts/start-production.mts --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/yoyi/current/apps/web/.next/cache
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
