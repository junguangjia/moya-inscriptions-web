{
  "name": "moya-inscriptions-web",
  "version": "0.0.0",
  "private": true,
  "description": "Engineering foundation for \u7531\u827a (Yoyi), the inscription and calligraphy Catalog.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.9.0 <12"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:all": "node --env-file=.env.local node_modules/turbo/bin/turbo watch dev --filter=web --filter=admin --filter=@moya/backend-production",
    "build": "turbo run build",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:community": "node scripts/migrate-community.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:confidentiality && turbo run test",
    "test:e2e": "pnpm --filter @moya/tests test:e2e",
    "verify": "node scripts/verify.mjs",
    "test:e2e:smoke": "node scripts/verify.mjs e2e",
    "test:postgres": "pnpm --filter @moya/tests test:postgres",
    "generate:catalog-import-template": "pnpm --filter @moya/contracts build && node scripts/generate-catalog-import-template.mjs",
    "check:catalog-import-template": "pnpm --filter @moya/contracts build && node scripts/generate-catalog-import-template.mjs --check",
    "generate:catalog-import-v2-template": "pnpm --filter @moya/contracts build && node scripts/generate-catalog-import-template.mjs --version v2",
    "check:catalog-import-v2-template": "pnpm --filter @moya/contracts build && node scripts/generate-catalog-import-template.mjs --version v2 --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "confidentiality:install": "node scripts/install-confidentiality-hooks.mjs",
    "confidentiality:health": "node scripts/confidentiality-scan.mjs health",
    "confidentiality:staged": "node scripts/confidentiality-scan.mjs staged",
    "confidentiality:message": "node scripts/confidentiality-scan.mjs message",
    "confidentiality:outbound": "node scripts/confidentiality-scan.mjs outbound",
    "test:confidentiality": "node --test scripts/confidentiality-scan.test.mjs",
    "test:cms": "node scripts/editorial/verify-cms.mjs",
    "test:cms:browser": "node scripts/editorial/verify-owner-browser.mjs",
    "dev:db:up": "docker compose -f compose.dev.yml up -d --wait",
    "dev:db:down": "docker compose -f compose.dev.yml down",
    "dev:migrate": "turbo run build --filter=admin^... --filter=@moya/community-postgres && node --env-file=.env.local scripts/migrate.mjs --development && docker compose -f compose.dev.yml exec -T postgres psql -v ON_ERROR_STOP=1 -U yoyi_dev_owner -d yoyi_dev -f /opt/yoyi/grant-public-read.sql && node --env-file=.env.local scripts/migrate-community.mjs --development && docker compose -f compose.dev.yml exec -T postgres psql -v ON_ERROR_STOP=1 --single-transaction -U yoyi_dev_owner -d yoyi_dev -v app_role=yoyi_dev_app -f /opt/yoyi/grant-community-app.sql -f /opt/yoyi/grant-runtime.sql -f /opt/yoyi/community-development-accounts.sql",
    "dev:backend": "node --env-file=.env.local node_modules/turbo/bin/turbo watch dev --filter=@moya/backend-production",
    "test:cms:agent-connections": "node scripts/editorial/verify-agent-connections.mjs",
    "dev:task:prepare": "node scripts/task-resources.mjs prepare",
    "dev:task:inspect": "node scripts/task-resources.mjs inspect",
    "task:snapshot": "node scripts/task-context.mjs snapshot",
    "task:verify-context": "node scripts/task-context.mjs verify"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "exceljs": "4.4.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "turbo": "2.10.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
