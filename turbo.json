{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "interruptible": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@moya/tests#test": {
      "dependsOn": [
        "@moya/agent-authorization#build",
        "@moya/api#build",
        "@moya/backend-production#build",
        "@moya/backend-runtime#build",
        "@moya/catalog-importer#build",
        "@moya/catalog-postgres#build",
        "@moya/community-postgres#build",
        "@moya/contracts#build",
        "@moya/design-tokens#build",
        "@moya/image#build",
        "@moya/public-api#build",
        "@moya/search#build",
        "@moya/ui#build"
      ]
    },
    "web#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": [
        "MOYA_PUBLIC_API_BASE_URL",
        "MOYA_ALLOWED_DEV_ORIGINS",
        "CMS_INTERNAL_URL"
      ]
    },
    "admin#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": [
        "CMS_*",
        "DATABASE_IDLE_TIMEOUT_MS",
        "COMMUNITY_OPERATOR_BASE_URL",
        "COMMUNITY_OPERATOR_TOKEN"
      ]
    },
    "@moya/backend-production#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": [
        "NODE_ENV",
        "HOST",
        "PORT",
        "MOYA_CONTENT_SOURCE",
        "DATABASE_*",
        "APP_DATABASE_URL",
        "APP_DATABASE_SSL_CA_FILE",
        "COMMUNITY_OPERATOR_TOKEN",
        "CMS_STORAGE_MODE",
        "CMS_ENVIRONMENT",
        "CMS_DATABASE_URL",
        "CMS_DATABASE_SSL_CA_FILE",
        "CMS_MEDIA_DIR",
        "PUBLIC_MEDIA_BASE_URL",
        "WORK_MEDIA_STORE_DIR",
        "WORK_MEDIA_TOOLS_IMAGE",
        "WORK_MEDIA_WORK_DIR",
        "WORK_MEDIA_WORKER_CONCURRENCY"
      ]
    }
  },
  "globalDependencies": [".nvmrc", "tsconfig.base.json"],
  "globalEnv": ["MOYA_VERIFICATION_TOOLCHAIN"]
}
