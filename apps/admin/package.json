{
  "name": "admin",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "node scripts/build.mjs",
    "start": "next start --port 3002",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "cms:migrate": "node ../../scripts/migrate.mjs --expect=payload",
    "cms:migrate:create": "payload migrate:create",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
    "cms:legacy": "payload run scripts/migrate-legacy.ts --"
  },
  "dependencies": {
    "@moya/api": "workspace:*",
    "@moya/catalog-postgres": "workspace:*",
    "@moya/community-postgres": "workspace:*",
    "@moya/contracts": "workspace:*",
    "@moya/ui": "workspace:*",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-cloud-storage": "3.88.0",
    "@payloadcms/plugin-mcp": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "graphql": "16.11.0",
    "next": "16.3.5",
    "opencc": "1.4.1",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "zod": "4.4.3",
    "zod3": "npm:zod@3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "oidc-provider": "9.12.2",
    "typescript": "6.0.3"
  },
  "type": "module",
  "exports": {
    "./config": "./payload.config.ts",
    "./editorial": "./src/editorial/index.ts",
    "./media": "./src/media/collection.ts",
    "./media-snapshot": "./src/media/snapshot.ts",
    "./published": "./src/published/views.ts",
    "./published-search": "./src/published/search.ts",
    "./migration": "./src/migration/legacy.ts",
    "./preview": "./src/preview/index.ts",
    "./fields": "./src/fields/editorial-fields.ts",
    "./migration-runner": "./src/migration/run.ts",
    "./runtime-settings": "./src/runtime-settings.ts",
    "./migration-guard": "./src/migration/guard.ts",
    "./local-media-read": "./src/media/local-read.ts",
    "./community-endpoints": "./src/community/endpoints.ts",
    "./community-bulk-actions": "./src/community/bulk-actions.tsx",
    "./agent-admin-mcp": "./src/agent-admin/mcp-tools.ts",
    "./agent-connections": "./src/agent-connections/index.ts",
    "./agent-connections-admission": "./src/agent-connections/admission.ts",
    "./agent-connections-principal": "./src/agent-connections/principal.ts",
    "./agent-connections-client": "./src/agent-connections/connections-client.tsx",
    "./agent-connections-consent": "./src/agent-connections/consent.ts",
    "./agent-connections-decide": "./src/agent-connections/decide.ts",
    "./agent-connections-resource": "./src/agent-connections/resource.ts",
    "./editorial-content": "./src/editorial-content/index.ts",
    "./branding": "./src/branding/Brand.tsx",
    "./community-views": "./src/community/View.tsx",
    "./community-navigation": "./src/community/NavGroup.tsx",
    "./community-dashboard": "./src/community/DashboardCard.tsx"
  }
