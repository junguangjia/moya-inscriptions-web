{
  "name": "@moya/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./assets/*": "./src/assets/*",
    "./brand.css": "./src/brand.css",
    "./brand": {
      "types": "./src/components/brand.tsx",
      "import": "./dist/components/brand.js"
    }
  },
  "sideEffects": [
    "./src/styles.css",
    "./src/brand.css"
  ],
  "dependencies": {
    "@moya/design-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.2.8 <20",
    "react-dom": ">=19.2.8 <20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  }
}
