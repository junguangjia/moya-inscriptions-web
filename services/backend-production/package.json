{
  "name": "@moya/backend-production",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./internal/cos-https": {
      "types": "./src/storage/cos-https.ts",
      "import": "./dist/storage/cos-https.js"
    },
    "./internal/cos-signature": {
      "types": "./src/storage/cos-signature.ts",
      "import": "./dist/storage/cos-signature.js"
    },
    "./internal/pilot-cos": {
      "types": "./src/storage/pilot-cos.ts",
      "import": "./dist/storage/pilot-cos.js"
    },
    "./internal/production-cos": {
      "types": "./src/storage/production-cos.ts",
      "import": "./dist/storage/production-cos.js"
    },
    "./internal/cos-read": {
      "types": "./src/storage/cos-read.ts",
      "import": "./dist/storage/cos-read.js"
    },
    "./internal/cos-sdk": {
      "types": "./src/storage/cos-sdk.ts",
      "import": "./dist/storage/cos-sdk.js"
    },
    "./internal/local-media": {
      "types": "./src/storage/local-media.ts",
      "import": "./dist/storage/local-media.js"
    },
    "./internal/publishing-media-store": {
      "types": "./src/storage/publishing-media-store.ts",
      "import": "./dist/storage/publishing-media-store.js"
    },
    "./internal/publishing-processing": {
      "types": "./src/publishing/processing/index.ts",
      "import": "./dist/publishing/processing/index.js"
    },
    "./internal/publishing-config": {
      "types": "./src/publishing/config.ts",
      "import": "./dist/publishing/config.js"
    },
    "./internal/publishing-job-handlers": {
      "types": "./src/publishing/job-handlers.ts",
      "import": "./dist/publishing/job-handlers.js"
    },
    "./internal/publishing-worker": {
      "types": "./src/publishing/worker.ts",
      "import": "./dist/publishing/worker.js"
    },
    "./internal/publishing-sandbox": {
      "types": "./src/publishing/sandbox/index.ts",
      "import": "./dist/publishing/sandbox/index.js"
    },
    "./internal/publishing-catalog": {
      "types": "./src/publishing/catalog.ts",
      "import": "./dist/publishing/catalog.js"
    },
    "./internal/catalog-source": {
      "types": "./src/storage/catalog-source.ts",
      "import": "./dist/storage/catalog-source.js"
    },
    "./internal/media-worker": {
      "types": "./src/worker-composition.ts",
      "import": "./dist/worker-composition.js"
    },
    "./internal/auth": {
      "types": "./src/auth/index.ts",
      "import": "./dist/auth/index.js"
    },
    "./internal/auth-signing": {
      "types": "./src/auth/signing.ts",
      "import": "./dist/auth/signing.js"
    },
    "./internal/auth-transport": {
      "types": "./src/auth/transport.ts",
      "import": "./dist/auth/transport.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "worker": "node dist/worker-main.js",
    "pilot": "node dist/pilot-cli.js",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/main.ts",
    "dev:worker": "tsx src/worker-main.ts"
  },
  "dependencies": {
    "@moya/agent-authorization": "workspace:*",
    "@moya/backend-runtime": "workspace:*",
    "@moya/catalog-importer": "workspace:*",
    "@moya/catalog-postgres": "workspace:*",
    "@moya/community-postgres": "workspace:*",
    "@moya/image": "workspace:*",
    "cos-nodejs-sdk-v5": "3.0.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.22.4"
  }
}
