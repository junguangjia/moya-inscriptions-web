{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local incremental intake v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "targetId",
    "targetBaseline",
    "batchId",
    "assetIds",
    "captureSessionId"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "targetId": { "type": "string", "minLength": 1 },
    "targetBaseline": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "batchId": { "type": "string", "minLength": 1 },
    "assetIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "captureSessionId": { "type": ["string", "null"] }
  }
}
