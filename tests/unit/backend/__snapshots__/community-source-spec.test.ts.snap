  "texts": {
    "03163fbc9e67": "SELECT COUNT(*)::integer AS total FROM community.works w JOIN community.public_users u ON u.id=w.author_id LEFT JOIN community.work_revisions ar ON ar.id=w.author_revision_id AND ar.requested_visibility='public'
  WHERE ($1='' OR position(lower($1) in lower(w.id||' '||w.title||' '||w.text||' '||COALESCE(ar.title,'')||' '||COALESCE(ar.body,'')||' '||u.display_name||' '||u.handle))>0)
  AND ($2::text IS NULL OR (w.author_id=$2 AND w.deleted_at IS NULL AND EXISTS(SELECT 1 FROM community.work_revisions r WHERE r.work_id=w.id AND r.disposition<>'not_required')))
  AND ($3::text IS NULL OR w.id=$3)
  AND ($4::timestamptz IS NULL OR COALESCE(w.first_published_at,w.first_submitted_at,w.updated_at)>=$4::timestamptz)
  AND ($5::timestamptz IS NULL OR COALESCE(w.first_published_at,w.first_submitted_at,w.updated_at)<=$5::timestamptz)
  AND NOT ($6::boolean AND ((w.visibility='self' AND w.deleted_at IS NULL) OR (w.deleted_at IS NOT NULL AND (w.title<>'' OR w.text<>'' OR cardinality(w.media_ids)>0
    OR w.public_revision_id IS NOT NULL OR w.author_revision_id IS NOT NULL
    OR w.id IN (SELECT hc.work_id FROM community.work_revisions hc WHERE hc.work_id IS NOT NULL) OR w.id IN (SELECT hc.work_id FROM community.work_drafts hc WHERE hc.work_id IS NOT NULL) OR w.id IN (SELECT hc.work_id FROM community.work_draft_snapshots hc WHERE hc.work_id IS NOT NULL) OR w.id IN (SELECT hc.work_id FROM community.work_edit_drafts hc WHERE hc.work_id IS NOT NULL)))))",
    "032fc3ef0b41": "SELECT u.id,u.handle,u.display_name,u.bio,u.status,u.created_at,
        COALESCE(f.enabled,FALSE) AS recommended,COALESCE(f.version,0) AS recommendation_version,
        (SELECT COUNT(*)::integer FROM community.works w WHERE w.author_id=u.id AND w.deleted_at IS NULL
          AND NOT ($5::boolean AND ((w.visibility='self' AND w.deleted_at IS NULL) OR (w.deleted_at IS NOT NULL AND (w.title<>'' OR w.text<>'' OR cardinality(w.media_ids)>0
    OR w.public_revision_id IS NOT NULL OR w.author_revision_id IS NOT NULL
    OR EXISTS(SELECT 1 FROM community.work_revisions hc WHERE hc.work_id=w.id) OR EXISTS(SELECT 1 FROM community.work_drafts hc WHERE hc.work_id=w.id) OR EXISTS(SELECT 1 FROM community.work_draft_snapshots hc WHERE hc.work_id=w.id) OR EXISTS(SELECT 1 FROM community.work_edit_drafts hc WHERE hc.work_id=w.id)))))
          AND EXISTS(SELECT 1 FROM community.work_revisions r WHERE r.work_id=w.id AND r.disposition<>'not_required')) AS submitted_works,(SELECT COUNT(*)::integer FROM community.catalog_comments c WHERE c.author_id=u.id AND NOT (c.target_type='work' AND EXISTS(SELECT 1 FROM community.works so_w
    WHERE so_w.id=c.catalog_id AND ((so_w.visibility='self' AND so_w.deleted_at IS NULL) OR (so_w.deleted_at IS NOT NULL AND (so_w.title<>'' OR so_w.text<>'' OR cardinality(so_w.media_ids)>0
    OR so_w.public_revision_id IS NOT NULL OR so_w.author_revision_id IS NOT NULL
    OR EXISTS(SELECT 1 FROM community.work_revisions hc WHERE hc.work_id=so_w.id) OR EXISTS(SELECT 1 FROM community.work_drafts hc WHERE hc.work_id=so_w.id) OR EXISTS(SELECT 1 FROM community.work_draft_snapshots hc WHERE hc.work_id=so_w.id) OR EXISTS(SELECT 1 FROM community.work_edit_drafts hc WHERE hc.work_id=so_w.id)))))))
          +(SELECT COUNT(*)::integer FROM community.catalog_comment_replies r JOIN community.catalog_comments c ON c.id=r.root_comment_id WHERE r.author_id=u.id AND NOT (c.target_type='work' AND EXISTS(SELECT 1 FROM community.works so_w
    WHERE so_w.id=c.catalog_id AND ((so_w.visibility='self' AND so_w.deleted_at IS NULL) OR (so_w.deleted_at IS NOT NULL AND (so_w.title<>'' OR so_w.text<>'' OR cardinality(so_w.media_ids)>0
    OR so_w.public_revision_id IS NOT NULL OR so_w.author_revision_id IS NOT NULL
    OR EXISTS(SELECT 1 FROM community.work_revisions hc WHERE hc.work_id=so_w.id) OR EXISTS(SELECT 1 FROM community.work_drafts hc WHERE hc.work_id=so_w.id) OR EXISTS(SELECT 1 FROM community.work_draft_snapshots hc WHERE hc.work_id=so_w.id) OR EXISTS(SELECT 1 FROM community.work_edit_drafts hc WHERE hc.work_id=so_w.id))))))) AS comment_count,
        (SELECT COUNT(*)::integer FROM community.report_cases rc WHERE rc.affected_user_id=u.id AND NOT ((rc.target_type='work' AND EXISTS(SELECT 1 FROM community.works so_w
    WHERE so_w.id=rc.target_id AND ((so_w.visibility='self' AND so_w.deleted_at IS NULL) OR (so_w.deleted_at IS NOT NULL AND (so_w.title<>'' OR so_w.text<>'' OR cardinality(so_w.media_ids)>0
    OR so_w.public_revision_id IS NOT NULL OR so_w.author_revision_id IS NOT NULL
    OR EXISTS(SELECT 1 FROM community.work_revisions hc WHERE hc.work_id=so_w.id) OR EXISTS(SELECT 1 FROM community.work_drafts hc WHERE hc.work_id=so_w.id) OR EXISTS(SELECT 1 FROM community.work_draft_snapshots hc WHERE hc.work_id=so_w.id) OR EXISTS(SELECT 1 FROM community.work_edit_drafts hc WHERE hc.work_id=so_w.id))))))
    OR (rc.target_type='comment' AND (EXISTS(SELECT 1 FROM community.catalog_comments so_c
    JOIN community.works so_w ON so_w.id=so_c.catalog_id
    WHERE so_c.id=COALESCE(
      (SELECT so_r.root_comment_id FROM community.catalog_comment_replies so_r WHERE so_r.id=rc.target_id),
      rc.target_id)
    AND so_c.target_type='work' AND ((so_w.visibility='self' AND so_w.deleted_at IS NULL) OR (so_w.deleted_at IS NOT NULL AND (so_w.title<>'' OR so_w.text<>'' OR cardinality(so_w.media_ids)>0
    OR so_w.public_revision_id IS NOT NULL OR so_w.author_revision_id IS NOT NULL
    OR EXISTS(SELECT 1 FROM community.work_revisions hc WHERE hc.work_id=so_w.id) OR EXISTS(SELECT 1 FROM community.work_drafts hc WHERE hc.work_id=so_w.id) OR EXISTS(SELECT 1 FROM community.work_draft_snapshots hc WHERE hc.work_id=so_w.id) OR EXISTS(SELECT 1 FROM community.work_edit_drafts hc WHERE hc.work_id=so_w.id)))))
      OR (rc.snapshot->'post'->>'type'='work' AND EXISTS(SELECT 1 FROM community.works so_w
    WHERE so_w.id=rc.snapshot->'post'->>'id' AND ((so_w.visibility='self' AND so_w.deleted_at IS NULL) OR (so_w.deleted_at IS NOT NULL AND (so_w.title<>'' OR so_w.text<>'' OR cardinality(so_w.media_ids)>0
    OR so_w.public_revision_id IS NOT NULL OR so_w.author_revision_id IS NOT NULL
    OR EXISTS(SELECT 1 FROM community.work_revisions hc WHERE hc.work_id=so_w.id) OR EXISTS(SELECT 1 FROM community.work_drafts hc WHERE hc.work_id=so_w.id) OR EXISTS(SELECT 1 FROM community.work_draft_snapshots hc WHERE hc.work_id=so_w.id) OR EXISTS(SELECT 1 FROM community.work_edit_drafts hc WHERE hc.work_id=so_w.id)))))))))) AS report_count
        FROM community.public_users u LEFT JOIN community.featured_users f ON f.user_id=u.id WHERE ($1='' OR position(lower($1) in lower(u.id||' '||u.handle||' '||u.display_name))>0)
  AND ($2::text IS NULL OR u.id=$2)
        ORDER BY u.created_at DESC,u.id LIMIT $3 OFFSET $4",
    "07ed49d02f66": "SELECT count(*)::integer n FROM community.report_cases c WHERE ($1::text IS NULL OR c.status=$1)
    AND ($2::boolean IS NULL OR c.urgent=$2)
    AND ($3::boolean IS NULL OR c.status<>'resolved')
    AND ($4::text IS NULL OR c.target_type=$4)
    AND ($5::text IS NULL OR c.target_id=$5)
    AND ($6::text IS NULL OR c.affected_user_id=$6)
    AND ($7::text IS NULL OR c.reporter_id=$7)",
    "09faed418d59": "SET LOCAL statement_timeout='8s'",
    "10748d1b9b2b": "SELECT c.* FROM community.report_cases c WHERE ($1::text IS NULL OR c.status=$1)
    AND ($2::boolean IS NULL OR c.urgent=$2)
    AND ($3::boolean IS NULL OR c.status<>'resolved')
    AND ($4::text IS NULL OR c.target_type=$4)
    AND ($5::text IS NULL OR c.target_id=$5)
    AND ($6::text IS NULL OR c.affected_user_id=$6)
    AND ($7::text IS NULL OR c.reporter_id=$7) ORDER BY c.urgent DESC,c.created_at,c.id LIMIT $8 OFFSET $9",
    "230ed5f2a3b4": "SELECT COUNT(*)::integer AS total FROM community.public_users u WHERE ($1='' OR position(lower($1) in lower(u.id||' '||u.handle||' '||u.display_name))>0)
  AND ($2::text IS NULL OR u.id=$2)",
    "287f0843e19f": "SELECT r.disposition AS value,count(*)::integer AS count,min(r.submitted_at) AS oldest FROM community.work_revisions r
  JOIN community.works w ON w.id=r.work_id
  JOIN community.public_users u ON u.id=r.author_id
  WHERE r.disposition<>'not_required' AND w.deleted_at IS NULL AND r.origin='submission'
  AND ($1::text IS NULL OR r.disposition=$1::text)
  AND ($2::text IS NULL OR r.author_id=$2::text)
  AND ($3::text IS NULL OR r.work_id=$3::text)
  AND NOT ($4::boolean AND ((w.visibility='self' AND w.deleted_at IS NULL) OR (w.deleted_at IS NOT NULL AND (w.title<>'' OR w.text<>'' OR cardinality(w.media_ids)>0
    OR w.public_revision_id IS NOT NULL OR w.author_revision_id IS NOT NULL
    OR EXISTS(SELECT 1 FROM community.work_revisions hc WHERE hc.work_id=w.id) OR EXISTS(SELECT 1 FROM community.work_drafts hc WHERE hc.work_id=w.id) OR EXISTS(SELECT 1 FROM community.work_draft_snapshots hc WHERE hc.work_id=w.id) OR EXISTS(SELECT 1 FROM community.work_edit_drafts hc WHERE hc.work_id=w.id)))))
                 GROUP BY 1 ORDER BY count DESC,value ASC NULLS LAST",
    "468fca9197ec": "SELECT c.status AS value,count(*)::integer AS count,min(c.created_at) AS oldest FROM community.report_cases c WHERE ($1::text IS NULL OR c.status=$1)
    AND ($2::boolean IS NULL OR c.urgent=$2)
    AND ($3::boolean IS NULL OR c.status<>'resolved')
    AND ($4::text IS NULL OR c.target_type=$4)
    AND ($5::text IS NULL OR c.target_id=$5)
    AND ($6::text IS NULL OR c.affected_user_id=$6)
    AND ($7::text IS NULL OR c.reporter_id=$7)
                 GROUP BY 1 ORDER BY count DESC,value ASC NULLS LAST",
    "490d6e154cd7": "SELECT count(*)::integer AS count,min(COALESCE(w.first_published_at,w.first_submitted_at,w.updated_at)) AS oldest FROM community.works w JOIN community.public_users u ON u.id=w.author_id LEFT JOIN community.work_revisions ar ON ar.id=w.author_revision_id AND ar.requested_visibility='public'
  WHERE ($1='' OR position(lower($1) in lower(w.id||' '||w.title||' '||w.text||' '||COALESCE(ar.title,'')||' '||COALESCE(ar.body,'')||' '||u.display_name||' '||u.handle))>0)
  AND ($2::text IS NULL OR (w.author_id=$2 AND w.deleted_at IS NULL AND EXISTS(SELECT 1 FROM community.work_revisions r WHERE r.work_id=w.id AND r.disposition<>'not_required')))
  AND ($3::text IS NULL OR w.id=$3)
  AND ($4::timestamptz IS NULL OR COALESCE(w.first_published_at,w.first_submitted_at,w.updated_at)>=$4::timestamptz)
  AND ($5::timestamptz IS NULL OR COALESCE(w.first_published_at,w.first_submitted_at,w.updated_at)<=$5::timestamptz)
  AND NOT ($6::boolean AND ((w.visibility='self' AND w.deleted_at IS NULL) OR (w.deleted_at IS NOT NULL AND (w.title<>'' OR w.text<>'' OR cardinality(w.media_ids)>0
    OR w.public_revision_id IS NOT NULL OR w.author_revision_id IS NOT NULL
    OR w.id IN (SELECT hc.work_id FROM community.work_revisions hc WHERE hc.work_id IS NOT NULL) OR w.id IN (SELECT hc.work_id FROM community.work_drafts hc WHERE hc.work_id IS NOT NULL) OR w.id IN (SELECT hc.work_id FROM community.work_draft_snapshots hc WHERE hc.work_id IS NOT NULL) OR w.id IN (SELECT hc.work_id FROM community.work_edit_drafts hc WHERE hc.work_id IS NOT NULL)))))",
    "4cda471641f3": "
  SELECT entries.moderation, COUNT(*)::text AS total
  FROM (
  SELECT c.id, 'comment' AS kind, c.catalog_id,c.target_type,c.body_deleted_at,c.thread_removed_at, NULL::text AS root_comment_id,
         NULL::text AS reply_to_reply_id,
         c.text, c.created_at, c.moderation, CASE WHEN c.body_deleted_at IS NOT NULL  THEN '[]'::jsonb ELSE COALESCE((
    SELECT jsonb_agg(jsonb_strip_nulls(jsonb_build_object('id',i.id,'offset',(ref.value->>'offset')::integer,
      'width',d.width,'height',d.height,'thumbSrc','/api/community-moderation/comment-media/'||c.id||'/'||i.id||'/'||'thumb','src','/api/community-moderation/comment-media/'||c.id||'/'||i.id||'/'||'display',
      'fullSrc',CASE WHEN EXISTS (SELECT 1 FROM community.media_renditions f JOIN community.media_blobs fb ON fb.id=f.blob_id AND fb.state='committed'
        WHERE f.item_id=i.id AND f.role='full' AND f.edit_key='base' AND f.state='ready' AND f.content_type='image/webp' AND (f.role<>'full' OR GREATEST(f.width,f.height)<=8192 OR (GREATEST(f.width,f.height)+0.5>2.5*(LEAST(f.width,f.height)-0.5) AND GREATEST(f.width,f.height)<=16000 AND (f.width-0.5)*(f.height-0.5)<=40000000))) THEN '/api/community-moderation/comment-media/'||c.id||'/'||i.id||'/'||'full' END)) ORDER BY ref.ordinality)
    FROM jsonb_array_elements(c.image_refs) WITH ORDINALITY ref(value,ordinality)
    JOIN community.media_items i ON i.id=ref.value->>'itemId' AND i.owner_id=c.author_id AND i.purpose='comment'
      AND i.state='ready' AND i.cancelled_at IS NULL AND i.purged_at IS NULL
    JOIN community.media_renditions d ON d.item_id=i.id AND d.role='display' AND d.edit_key='base' AND d.state='ready' AND d.content_type='image/webp'
    JOIN community.media_blobs b ON b.id=d.blob_id AND b.state='committed'
    WHERE EXISTS (SELECT 1 FROM community.media_renditions t JOIN community.media_blobs tb ON tb.id=t.blob_id AND tb.state='committed'
      WHERE t.item_id=i.id AND t.role='thumb' AND t.edit_key='base' AND t.state='ready' AND t.content_type='image/webp')
  ),'[]'::jsonb) END AS images,
         u.id AS author_id, u.handle AS author_handle,
         u.display_name AS author_display_name, u.status AS author_status
  FROM community.catalog_comments c
  JOIN community.public_users u ON u.id = c.author_id
  UNION ALL
  SELECT r.id, 'reply' AS kind, c.catalog_id,c.target_type,r.body_deleted_at,c.thread_removed_at,r.root_comment_id,
         r.reply_to_reply_id,
         r.text, r.created_at, r.moderation, CASE WHEN r.body_deleted_at IS NOT NULL  THEN '[]'::jsonb ELSE COALESCE((
    SELECT jsonb_agg(jsonb_strip_nulls(jsonb_build_object('id',i.id,'offset',(ref.value->>'offset')::integer,
      'width',d.width,'height',d.height,'thumbSrc','/api/community-moderation/comment-media/'||r.id||'/'||i.id||'/'||'thumb','src','/api/community-moderation/comment-media/'||r.id||'/'||i.id||'/'||'display',
      'fullSrc',CASE WHEN EXISTS (SELECT 1 FROM community.media_renditions f JOIN community.media_blobs fb ON fb.id=f.blob_id AND fb.state='committed'
        WHERE f.item_id=i.id AND f.role='full' AND f.edit_key='base' AND f.state='ready' AND f.content_type='image/webp' AND (f.role<>'full' OR GREATEST(f.width,f.height)<=8192 OR (GREATEST(f.width,f.height)+0.5>2.5*(LEAST(f.width,f.height)-0.5) AND GREATEST(f.width,f.height)<=16000 AND (f.width-0.5)*(f.height-0.5)<=40000000))) THEN '/api/community-moderation/comment-media/'||r.id||'/'||i.id||'/'||'full' END)) ORDER BY ref.ordinality)
    FROM jsonb_array_elements(r.image_refs) WITH ORDINALITY ref(value,ordinality)
    JOIN community.media_items i ON i.id=ref.value->>'itemId' AND i.owner_id=r.author_id AND i.purpose='comment'
      AND i.state='ready' AND i.cancelled_at IS NULL AND i.purged_at IS NULL
    JOIN community.media_renditions d ON d.item_id=i.id AND d.role='display' AND d.edit_key='base' AND d.state='ready' AND d.content_type='image/webp'
    JOIN community.media_blobs b ON b.id=d.blob_id AND b.state='committed'
    WHERE EXISTS (SELECT 1 FROM community.media_renditions t JOIN community.media_blobs tb ON tb.id=t.blob_id AND tb.state='committed'
      WHERE t.item_id=i.id AND t.role='thumb' AND t.edit_key='base' AND t.state='ready' AND t.content_type='image/webp')
  ),'[]'::jsonb) END AS images,
         u.id AS author_id, u.handle AS author_handle,
         u.display_name AS author_display_name, u.status AS author_status
  FROM community.catalog_comment_replies r
  JOIN community.catalog_comments c ON c.id = r.root_comment_id
  JOIN community.public_users u ON u.id = r.author_id
) entries
  
  WHERE ($1::text IS NULL OR entries.moderation = $1::text)
    AND ($2::text IS NULL OR entries.kind = $2::text)
    AND ($3::text IS NULL OR entries.catalog_id = $3::text)
    AND (
      $4::text IS NULL
      OR entries.text ILIKE $4::text ESCAPE '\\'
      OR entries.author_handle ILIKE $4::text ESCAPE '\\'
      OR entries.author_display_name ILIKE $4::text ESCAPE '\\'
    )
    AND ($5::text IS NULL OR entries.author_id = $5::text)
    AND ($6::timestamptz IS NULL OR entries.created_at >= $6::timestamptz)
    AND ($7::timestamptz IS NULL OR entries.created_at <= $7::timestamptz)
    AND NOT (
      $8::boolean
      AND entries.target_type = 'work'
      AND entries.catalog_id IN (SELECT so_w.id FROM community.works so_w WHERE ((so_w.visibility='self' AND so_w.deleted_at IS NULL) OR (so_w.deleted_at IS NOT NULL AND (so_w.title<>'' OR so_w.text<>'' OR cardinality(so_w.media_ids)>0
    OR so_w.public_revision_id IS NOT NULL OR so_w.author_revision_id IS NOT NULL
    OR so_w.id IN (SELECT hc.work_id FROM community.work_revisions hc WHERE hc.work_id IS NOT NULL) OR so_w.id IN (SELECT hc.work_id FROM community.work_drafts hc WHERE hc.work_id IS NOT NULL) OR so_w.id IN (SELECT hc.work_id FROM community.work_draft_snapshots hc WHERE hc.work_id IS NOT NULL) OR so_w.id IN (SELECT hc.work_id FROM community.work_edit_drafts hc WHERE hc.work_id IS NOT NULL)))))
    )

  GROUP BY entries.moderation
",
    "4e0487ab5003": "SELECT entries.target_type AS value,count(*)::integer AS count,min(entries.created_at) AS oldest FROM (
  SELECT c.id, 'comment' AS kind, c.catalog_id,c.target_type,c.body_deleted_at,c.thread_removed_at, NULL::text AS root_comment_id,
         NULL::text AS reply_to_reply_id,
         c.text, c.created_at, c.moderation, CASE WHEN c.body_deleted_at IS NOT NULL  THEN '[]'::jsonb ELSE COALESCE((
    SELECT jsonb_agg(jsonb_strip_nulls(jsonb_build_object('id',i.id,'offset',(ref.value->>'offset')::integer,
      'width',d.width,'height',d.height,'thumbSrc','/api/community-moderation/comment-media/'||c.id||'/'||i.id||'/'||'thumb','src','/api/community-moderation/comment-media/'||c.id||'/'||i.id||'/'||'display',
      'fullSrc',CASE WHEN EXISTS (SELECT 1 FROM community.media_renditions f JOIN community.media_blobs fb ON fb.id=f.blob_id AND fb.state='committed'
        WHERE f.item_id=i.id AND f.role='full' AND f.edit_key='base' AND f.state='ready' AND f.content_type='image/webp' AND (f.role<>'full' OR GREATEST(f.width,f.height)<=8192 OR (GREATEST(f.width,f.height)+0.5>2.5*(LEAST(f.width,f.height)-0.5) AND GREATEST(f.width,f.height)<=16000 AND (f.width-0.5)*(f.height-0.5)<=40000000))) THEN '/api/community-moderation/comment-media/'||c.id||'/'||i.id||'/'||'full' END)) ORDER BY ref.ordinality)
    FROM jsonb_array_elements(c.image_refs) WITH ORDINALITY ref(value,ordinality)
    JOIN community.media_items i ON i.id=ref.value->>'itemId' AND i.owner_id=c.author_id AND i.purpose='comment'
      AND i.state='ready' AND i.cancelled_at IS NULL AND i.purged_at IS NULL
    JOIN community.media_renditions d ON d.item_id=i.id AND d.role='display' AND d.edit_key='base' AND d.state='ready' AND d.content_type='image/webp'
    JOIN community.media_blobs b ON b.id=d.blob_id AND b.state='committed'
    WHERE EXISTS (SELECT 1 FROM community.media_renditions t JOIN community.media_blobs tb ON tb.id=t.blob_id AND tb.state='committed'
      WHERE t.item_id=i.id AND t.role='thumb' AND t.edit_key='base' AND t.state='ready' AND t.content_type='image/webp')
  ),'[]'::jsonb) END AS images,
         u.id AS author_id, u.handle AS author_handle,
         u.display_name AS author_display_name, u.status AS author_status
  FROM community.catalog_comments c
  JOIN community.public_users u ON u.id = c.author_id
  UNION ALL
  SELECT r.id, 'reply' AS kind, c.catalog_id,c.target_type,r.body_deleted_at,c.thread_removed_at,r.root_comment_id,
         r.reply_to_reply_id,
         r.text, r.created_at, r.moderation, CASE WHEN r.body_deleted_at IS NOT NULL  THEN '[]'::jsonb ELSE COALESCE((
    SELECT jsonb_agg(jsonb_strip_nulls(jsonb_build_object('id',i.id,'offset',(ref.value->>'offset')::integer,
      'width',d.width,'height',d.height,'thumbSrc','/api/community-moderation/comment-media/'||r.id||'/'||i.id||'/'||'thumb','src','/api/community-moderation/comment-media/'||r.id||'/'||i.id||'/'||'display',
      'fullSrc',CASE WHEN EXISTS (SELECT 1 FROM community.media_renditions f JOIN community.media_blobs fb ON fb.id=f.blob_id AND fb.state='committed'
        WHERE f.item_id=i.id AND f.role='full' AND f.edit_key='base' AND f.state='ready' AND f.content_type='image/webp' AND (f.role<>'full' OR GREATEST(f.width,f.height)<=8192 OR (GREATEST(f.width,f.height)+0.5>2.5*(LEAST(f.width,f.height)-0.5) AND GREATEST(f.width,f.height)<=16000 AND (f.width-0.5)*(f.height-0.5)<=40000000))) THEN '/api/community-moderation/comment-media/'||r.id||'/'||i.id||'/'||'full' END)) ORDER BY ref.ordinality)
    FROM jsonb_array_elements(r.image_refs) WITH ORDINALITY ref(value,ordinality)
    JOIN community.media_items i ON i.id=ref.value->>'itemId' AND i.owner_id=r.author_id AND i.purpose='comment'
      AND i.state='ready' AND i.cancelled_at IS NULL AND i.purged_at IS NULL
    JOIN community.media_renditions d ON d.item_id=i.id AND d.role='display' AND d.edit_key='base' AND d.state='ready' AND d.content_type='image/webp'
    JOIN community.media_blobs b ON b.id=d.blob_id AND b.state='committed'
    WHERE EXISTS (SELECT 1 FROM community.media_renditions t JOIN community.media_blobs tb ON tb.id=t.blob_id AND tb.state='committed'
      WHERE t.item_id=i.id AND t.role='thumb' AND t.edit_key='base' AND t.state='ready' AND t.content_type='image/webp')
  ),'[]'::jsonb) END AS images,
         u.id AS author_id, u.handle AS author_handle,
         u.display_name AS author_display_name, u.status AS author_status
  FROM community.catalog_comment_replies r
  JOIN community.catalog_comments c ON c.id = r.root_comment_id
  JOIN community.public_users u ON u.id = r.author_id
) entries 
  WHERE ($1::text IS NULL OR entries.moderation = $1::text)
    AND ($2::text IS NULL OR entries.kind = $2::text)
    AND ($3::text IS NULL OR entries.catalog_id = $3::text)
    AND (
      $4::text IS NULL
      OR entries.text ILIKE $4::text ESCAPE '\\'
      OR entries.author_handle ILIKE $4::text ESCAPE '\\'
      OR entries.author_display_name ILIKE $4::text ESCAPE '\\'
    )
    AND ($5::text IS NULL OR entries.author_id = $5::text)
    AND ($6::timestamptz IS NULL OR entries.created_at >= $6::timestamptz)
    AND ($7::timestamptz IS NULL OR entries.created_at <= $7::timestamptz)
    AND NOT (
      $8::boolean
      AND entries.target_type = 'work'
      AND entries.catalog_id IN (SELECT so_w.id FROM community.works so_w WHERE ((so_w.visibility='self' AND so_w.deleted_at IS NULL) OR (so_w.deleted_at IS NOT NULL AND (so_w.title<>'' OR so_w.text<>'' OR cardinality(so_w.media_ids)>0
    OR so_w.public_revision_id IS NOT NULL OR so_w.author_revision_id IS NOT NULL
    OR so_w.id IN (SELECT hc.work_id FROM community.work_revisions hc WHERE hc.work_id IS NOT NULL) OR so_w.id IN (SELECT hc.work_id FROM community.work_drafts hc WHERE hc.work_id IS NOT NULL) OR so_w.id IN (SELECT hc.work_id FROM community.work_draft_snapshots hc WHERE hc.work_id IS NOT NULL) OR so_w.id IN (SELECT hc.work_id FROM community.work_edit_drafts hc WHERE hc.work_id IS NOT NULL)))))
    )

                 GROUP BY 1 ORDER BY count DESC,value ASC NULLS LAST",
    "58c33bdb887c": "SELECT entries.kind AS value,count(*)::integer AS count,min(entries.created_at) AS oldest FROM (
  SELECT c.id, 'comment' AS kind, c.catalog_id,c.target_type,c.body_deleted_at,c.thread_removed_at, NULL::text AS root_comment_id,
         NULL::text AS reply_to_reply_id,
         c.text, c.created_at, c.moderation, CASE WHEN c.body_deleted_at IS NOT NULL  THEN '[]'::jsonb ELSE COALESCE((
    SELECT jsonb_agg(jsonb_strip_nulls(jsonb_build_object('id',i.id,'offset',(ref.value->>'offset')::integer,
      'width',d.width,'height',d.height,'thumbSrc','/api/community-moderation/comment-media/'||c.id||'/'||i.id||'/'||'thumb','src','/api/community-moderation/comment-media/'||c.id||'/'||i.id||'/'||'display',
      'fullSrc',CASE WHEN EXISTS (SELECT 1 FROM community.media_renditions f JOIN community.media_blobs fb ON fb.id=f.blob_id AND fb.state='committed'
        WHERE f.item_id=i.id AND f.role='full' AND f.edit_key='base' AND f.state='ready' AND f.content_type='image/webp' AND (f.role<>'full' OR GREATEST(f.width,f.height)<=8192 OR (GREATEST(f.width,f.height)+0.5>2.5*(LEAST(f.width,f.height)-0.5) AND GREATEST(f.width,f.height)<=16000 AND (f.width-0.5)*(f.height-0.5)<=40000000))) THEN '/api/community-moderation/comment-media/'||c.id||'/'||i.id||'/'||'full' END)) ORDER BY ref.ordinality)
    FROM jsonb_array_elements(c.image_refs) WITH ORDINALITY ref(value,ordinality)
    JOIN community.media_items i ON i.id=ref.value->>'itemId' AND i.owner_id=c.author_id AND i.purpose='comment'
      AND i.state='ready' AND i.cancelled_at IS NULL AND i.purged_at IS NULL
    JOIN community.media_renditions d ON d.item_id=i.id AND d.role='display' AND d.edit_key='base' AND d.state='ready' AND d.content_type='image/webp'
    JOIN community.media_blobs b ON b.id=d.blob_id AND b.state='committed'
    WHERE EXISTS (SELECT 1 FROM community.media_renditions t JOIN community.media_blobs tb ON tb.id=t.blob_id AND tb.state='committed'
      WHERE t.item_id=i.id AND t.role='thumb' AND t.edit_key='base' AND t.state='ready' AND t.content_type='image/webp')
  ),'[]'::jsonb) END AS images,
