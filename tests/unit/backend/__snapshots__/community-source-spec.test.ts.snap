      AND entries.catalog_id IN (SELECT so_w.id FROM community.works so_w WHERE ((so_w.visibility='self' AND so_w.deleted_at IS NULL) OR (so_w.deleted_at IS NOT NULL AND (so_w.title<>'' OR so_w.text<>'' OR cardinality(so_w.media_ids)>0
    OR so_w.public_revision_id IS NOT NULL OR so_w.author_revision_id IS NOT NULL
    OR so_w.id IN (SELECT hc.work_id FROM community.work_revisions hc WHERE hc.work_id IS NOT NULL) OR so_w.id IN (SELECT hc.work_id FROM community.work_drafts hc WHERE hc.work_id IS NOT NULL) OR so_w.id IN (SELECT hc.work_id FROM community.work_draft_snapshots hc WHERE hc.work_id IS NOT NULL) OR so_w.id IN (SELECT hc.work_id FROM community.work_edit_drafts hc WHERE hc.work_id IS NOT NULL)))))
    )
",
    "685e45fffd9f": "
  SELECT action, COUNT(*)::text AS total
  FROM community.moderation_events
  WHERE occurred_at >= $1::timestamptz AND occurred_at < $2::timestamptz
    AND NOT (
      $3::boolean
      AND subject_kind IN ('comment', 'reply')
      AND EXISTS(SELECT 1 FROM community.catalog_comments so_c
    JOIN community.works so_w ON so_w.id=so_c.catalog_id
    WHERE so_c.id=COALESCE(
      (SELECT so_r.root_comment_id FROM community.catalog_comment_replies so_r WHERE so_r.id=subject_id),
      subject_id)
    AND so_c.target_type='work' AND ((so_w.visibility='self' AND so_w.deleted_at IS NULL) OR (so_w.deleted_at IS NOT NULL AND (so_w.title<>'' OR so_w.text<>'' OR cardinality(so_w.media_ids)>0
    OR so_w.public_revision_id IS NOT NULL OR so_w.author_revision_id IS NOT NULL
    OR EXISTS(SELECT 1 FROM community.work_revisions hc WHERE hc.work_id=so_w.id) OR EXISTS(SELECT 1 FROM community.work_drafts hc WHERE hc.work_id=so_w.id) OR EXISTS(SELECT 1 FROM community.work_draft_snapshots hc WHERE hc.work_id=so_w.id) OR EXISTS(SELECT 1 FROM community.work_edit_drafts hc WHERE hc.work_id=so_w.id)))))
    )
  GROUP BY action
",
