      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "A Catalog image as WebP of at most 512 KiB, sizes in the text. {kind:"catalog_thumb",mediaId:"..."}; catalog_original with region:{left,top,width,height} shows one passage at full pixels. Save a transcription only from text you can read; else say so.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "catalog_thumb",
            "catalog_original",
          ],
          "type": "string",
        },
        "maxEdge": {
          "maximum": 2048,
          "minimum": 64,
          "type": "integer",
        },
        "mediaId": {
          "type": "string",
        },
        "region": {
          "additionalProperties": false,
          "properties": {
            "height": {
              "exclusiveMinimum": 0,
              "type": "integer",
            },
            "left": {
              "minimum": 0,
              "type": "integer",
            },
            "top": {
              "minimum": 0,
              "type": "integer",
            },
            "width": {
              "exclusiveMinimum": 0,
              "type": "integer",
            },
          },
          "required": [
            "left",
            "top",
            "width",
            "height",
          ],
          "type": "object",
        },
      },
      "required": [
        "kind",
        "mediaId",
      ],
      "type": "object",
    },
    "name": "admin_view_media",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "How far media work an op queued has got. Copy {kind:"settlement",refs} from a QUEUED answer's next. ok:true once no job is open or failed; else QUEUED or MEDIA_JOB_FAILED.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "settlement",
          "type": "string",
        },
        "refs": {
          "items": {
            "type": "object",
          },
          "maxItems": 50,
          "type": "array",
        },
      },
      "required": [
        "kind",
        "refs",
      ],
      "type": "object",
    },
    "name": "admin_job",
    "outputSchema": {
      "properties": {
        "code": {
          "type": "string",
        },
        "next": {
          "type": "object",
        },
        "ok": {
          "type": "boolean",
        },
      },
      "required": [
        "ok",
        "code",
        "untrusted",
        "meta",
      ],
      "type": "object",
    },
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Freeze a write before it runs: past 100 targets, or irreversible. {requestId,op,input?,targets,expectedCount?}; more as {requestId,previewId,chunkSeq,appendTargets}. Runs nothing; answers count, conflicts and needsOwnerConfirmation. Then admin_execute or admin_execute_irreversible, as class says, with {requestId,previewId}.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "appendTargets": {
          "items": {
            "type": "object",
          },
          "type": "array",
        },
        "chunkSeq": {
          "type": "integer",
        },
        "continuePlanning": {
          "type": "boolean",
        },
        "expectedCount": {
          "type": "integer",
        },
        "input": {
          "type": "object",
        },
        "op": {
          "type": "string",
        },
        "previewId": {
          "type": "string",
        },
        "requestId": {
          "type": "string",
        },
        "selector": {
          "type": "object",
        },
        "targets": {
          "items": {
            "type": "object",
          },
          "type": "array",
        },
      },
      "required": [
        "requestId",
      ],
      "type": "object",
    },
    "name": "admin_preview",
    "outputSchema": {
      "properties": {
        "code": {
          "type": "string",
        },
        "next": {
          "type": "object",
        },
        "ok": {
          "type": "boolean",
        },
      },
      "required": [
        "ok",
        "code",
        "untrusted",
        "meta",
      ],
      "type": "object",
    },
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Run one reversible write, or one op on up to 100 targets: {requestId,op:"editorial.publish-approved",input:{approvalId},targets:[{id:7},{id:8}]}; each merges over input. Or a run admin_preview sealed: {requestId,previewId}. A new requestId per intention; the same one replays, never repeats: retry it after OUTCOME_UNKNOWN. ok:true means every target completed; else data names each state.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "type": "object",
        },
        "op": {
          "type": "string",
        },
        "previewId": {
          "type": "string",
        },
        "priorIncomplete": {
          "const": true,
          "type": "boolean",
        },
        "requestId": {
          "type": "string",
        },
        "runId": {
          "type": "string",
        },
        "startAt": {
          "description": "Run from this target on. The answer covers only these: done is this call's own count.",
          "minimum": 0,
          "type": "integer",
        },
        "targets": {
          "items": {
            "type": "object",
          },
          "maxItems": 100,
          "type": "array",
        },
      },
      "required": [
        "requestId",
      ],
      "type": "object",
    },
    "name": "admin_execute",
    "outputSchema": {
      "properties": {
        "code": {
          "type": "string",
        },
        "next": {
          "type": "object",
        },
        "ok": {
          "type": "boolean",
        },
      },
      "required": [
        "ok",
        "code",
        "untrusted",
        "meta",
      ],
      "type": "object",
    },
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Run an irreversible run admin_preview sealed: {requestId,previewId}, or {requestId,runId} to go on. Nothing else travels, so what runs is what was previewed. Past the Owner's threshold it answers AWAITING_OWNER until the Owner confirms; then call again. ok:true only when every target completed.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "previewId": {
          "type": "string",
        },
        "requestId": {
          "type": "string",
        },
        "runId": {
          "type": "string",
        },
      },
      "required": [
        "requestId",
      ],
      "type": "object",
    },
    "name": "admin_execute_irreversible",
    "outputSchema": {
      "properties": {
        "code": {
          "type": "string",
        },
        "next": {
          "type": "object",
        },
        "ok": {
          "type": "boolean",
        },
      },
      "required": [
        "ok",
        "code",
        "untrusted",
        "meta",
      ],
      "type": "object",
    },
  },
]
`;

