      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Op catalog. No arguments: an index by tool, rows as name(required,fields). {ops:[up to 5]}: each op's JSON Schema, class, recovery, completion and example. {tool}: that tool's worked examples. Inputs refuse unknown fields.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
        },
        "ops": {
          "items": {
            "type": "string",
