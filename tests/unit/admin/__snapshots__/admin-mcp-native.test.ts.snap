          "type": "string",
        },
        "tz": {
          "type": "string",
        },
        "umamiSessionId": {
          "type": "string",
        },
        "visitorId": {
          "type": "string",
        },
      },
      "required": [
        "report",
      ],
      "type": "object",
    },
    "name": "admin_analytics",
    "outputSchema": {
      "properties": {
        "code": {
          "type": "string",
        },
        "next": {
          "type": "object",
        },
        "ok": {
