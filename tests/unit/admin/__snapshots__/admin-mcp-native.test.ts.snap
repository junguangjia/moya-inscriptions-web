[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Who this key is, what it can call now, when it expires. Call it first, and again when an admin_ tool is reported missing: a client may hold a stale tool list.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object",
    },
    "name": "admin_whoami",
    "outputSchema": {
      "properties": {
        "code": {
          "type": "string",
        },
        "next": {
          "type": "object",
        },
        "ok": {
          "type": "boolean",
        },
      },
      "required": [
        "ok",
        "code",
        "untrusted",
        "meta",
      ],
      "type": "object",
    },
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Resolve a reference in one call: id, pasted public or Admin link, @handle, sourceId, or free text. {query:"/catalog/abc"}, {query:"https://.../?articleId=article-..."}, {query:"兰亭序",type:"catalog"}. resolution says exact, candidates or none. Use resolution.ref for a mutation, never the first candidate. A branch that did not answer is named in meta.sources, never read as zero. Neither none nor a short candidate list proves absence: a draft Catalog is matched on its title only, as typed and by one simplified-traditional conversion, so another form of a character and any draft alias are missed. Community text is matched as stored, with no such conversion. Retry in the other form before saying it does not exist.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "maximum": 25,
          "minimum": 1,
          "type": "integer",
        },
        "query": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string",
        },
        "skip": {
          "maximum": 200,
          "minimum": 0,
          "type": "integer",
        },
        "type": {
          "enum": [
            "catalog",
            "article",
            "collection",
            "media",
            "user",
            "work",
            "comment",
            "thread",
            "report",
            "feedback",
            "publishing_job",
            "work_revision",
            "media_item",
            "invitation",
          ],
          "type": "string",
        },
      },
      "required": [
        "query",
      ],
      "type": "object",
    },
    "name": "admin_find",
    "outputSchema": {
      "properties": {
        "code": {
          "type": "string",
        },
        "next": {
          "type": "object",
        },
        "ok": {
          "type": "boolean",
        },
      },
      "required": [
        "ok",
        "code",
        "untrusted",
        "meta",
      ],
      "type": "object",
    },
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Read one record, and always say which version was read. Default outline: per-field state, length, hash, no long text. {type:"catalog",id:7}, {type:"report",id:"report-..."}. Long text in windows, offsets in code points: {type,id,field:"transcription",offset}. Inside one field: {type,id,field:"transcription",find:{text:"..."}}. view also full, published, preview, history, diff; a community record has outline, full and field only.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "exclusiveMinimum": 0,
          "type": "integer",
        },
        "field": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "fields": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 40,
          "minItems": 1,
          "type": "array",
        },
        "find": {
          "additionalProperties": false,
          "properties": {
            "context": {
              "maximum": 200,
              "minimum": 0,
              "type": "integer",
            },
            "mode": {
              "enum": [
                "raw",
                "normalized",
              ],
              "type": "string",
            },
            "text": {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string",
            },
          },
          "required": [
            "text",
          ],
          "type": "object",
        },
        "from": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
