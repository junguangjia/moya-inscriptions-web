  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Op catalog for admin_read and the execute tools. No arguments: an index by tool, rows as name(required,fields). {ops:[up to 5 names]}: each op's JSON Schema, class, recovery, completion and an example. Inputs refuse unknown fields.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "ops": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 5,
          "minItems": 1,
          "type": "array",
        },
      },
      "type": "object",
    },
    "name": "admin_actions",
    "outputSchema": {
      "properties": {
        "code": {
          "type": "string",
        },
        "next": {
          "type": "object",
        },
        "ok": {
          "type": "boolean",
        },
      },
      "required": [
        "ok",
        "code",
        "untrusted",
        "meta",
      ],
      "type": "object",
    },
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "See a Catalog image as a WebP of at most 512 KiB, with original and rendered size in the text. {kind:"catalog_thumb",mediaId:"..."}. One passage of the original, in its pixels: {kind:"catalog_original",mediaId:"...",region:{left,top,width,height}}. Only save a transcription from text you can read; if you cannot read it, say so.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "catalog_thumb",
            "catalog_original",
          ],
          "type": "string",
        },
        "maxEdge": {
          "maximum": 2048,
          "minimum": 64,
          "type": "integer",
        },
        "mediaId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
        "region": {
          "additionalProperties": false,
          "properties": {
            "height": {
              "exclusiveMinimum": 0,
              "type": "integer",
            },
            "left": {
              "minimum": 0,
              "type": "integer",
            },
            "top": {
              "minimum": 0,
              "type": "integer",
            },
            "width": {
              "exclusiveMinimum": 0,
              "type": "integer",
            },
          },
          "required": [
            "left",
            "top",
            "width",
            "height",
          ],
          "type": "object",
        },
      },
      "required": [
        "kind",
        "mediaId",
      ],
      "type": "object",
    },
    "name": "admin_view_media",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "How far the media work an op queued has got, without repeating the op. Copy {kind:"settlement",refs} from a QUEUED answer's next. ok:true once no job is open or failed; else QUEUED or MEDIA_JOB_FAILED.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "settlement",
          "type": "string",
        },
        "refs": {
          "items": {
            "type": "object",
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array",
        },
      },
      "required": [
        "kind",
        "refs",
      ],
      "type": "object",
    },
    "name": "admin_job",
    "outputSchema": {
      "properties": {
        "code": {
          "type": "string",
        },
        "next": {
          "type": "object",
        },
        "ok": {
          "type": "boolean",
        },
      },
      "required": [
        "ok",
        "code",
        "untrusted",
        "meta",
      ],
      "type": "object",
    },
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Run one reversible write, or the same one on up to 100 targets, in order, each with its own outcome. One: {requestId,op:"editorial.save-draft",input:{id,expectedRevision,content}}. Many: {requestId,op:"editorial.publish-approved",input:{approvalId},targets:[{id:7},{id:8}]}; each target merges over input. A new requestId per intention: the same requestId replays and never repeats, and it is what to retry after OUTCOME_UNKNOWN. ok:true means every target's whole effect completed. Anything else names each target's state in data and gives next when you can go on. admin_actions gives each op's input.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "type": "object",
        },
        "op": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "priorIncomplete": {
          "const": true,
          "type": "boolean",
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string",
        },
        "startAt": {
          "description": "Run from this target on. The answer covers only these: done is this call's own count.",
          "minimum": 0,
          "type": "integer",
        },
        "targets": {
          "items": {
            "type": "object",
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array",
        },
      },
      "required": [
        "requestId",
        "op",
      ],
      "type": "object",
    },
    "name": "admin_execute",
    "outputSchema": {
      "properties": {
        "code": {
          "type": "string",
        },
        "next": {
          "type": "object",
        },
        "ok": {
          "type": "boolean",
        },
      },
      "required": [
        "ok",
        "code",
        "untrusted",
        "meta",
      ],
      "type": "object",
    },
  },
]
`;

