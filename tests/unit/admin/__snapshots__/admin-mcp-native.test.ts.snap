            "today",
            "yesterday",
            "last_7_days",
            "last_30_days",
            "this_week",
            "last_week",
          ],
          "type": "string",
        },
        "report": {
          "type": "string",
        },
        "sameTarget": {
          "type": "boolean",
        },
        "sessionId": {
          "type": "string",
        },
        "step": {
          "type": "string",
        },
        "steps": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "to": {
          "type": "string",
        },
        "tz": {
          "type": "string",
        },
        "umamiSessionId": {
          "type": "string",
        },
        "visitorId": {
          "type": "string",
        },
      },
