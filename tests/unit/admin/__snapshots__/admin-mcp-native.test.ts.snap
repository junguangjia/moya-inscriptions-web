          "type": "boolean",
        },
      },
      "required": [
        "ok",
        "code",
        "untrusted",
        "meta",
      ],
      "type": "object",
    },
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Read a queue or page by op. Rows are compact; long text is only ever state, length and hash. {op:"list.catalogs",input:{filter:{missing:["transcription"]}}}. {op:"list.reports",input:{status:"open"}}. Count in SQL with no rows: {op:"list.catalogs",view:"count",groupBy:"dynasty",input:{filter:{missing:["transcription"]}}}. {op:"list.reports",view:"count",groupBy:"kind",input:{unresolved:"true"}}. Project with fields:[...], continue with next. admin_actions gives each op's filter.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "fields": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 40,
          "minItems": 1,
          "type": "array",
