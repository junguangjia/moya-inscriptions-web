              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer",
            },
            "top": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer",
            },
            "width": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
          },
          "required": [
            "left",
            "top",
            "width",
            "height",
          ],
          "type": "object",
        },
      },
      "required": [
        "kind",
        "mediaId",
      ],
      "type": "object",
    },
    "name": "admin_view_media",
  },
]
