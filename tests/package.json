{
  "name": "@moya/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project e2e/tsconfig.json",
    "test": "vitest run --exclude 'integration/postgres/**' --exclude 'e2e/**' --exclude 'cms/**'",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:postgres": "pnpm -w exec turbo run build --filter=@moya/tests^... --filter=!admin --cache-dir=.turbo/library-cache --no-daemon && vitest run integration/postgres",
    "test:cms": "vitest run cms --no-file-parallelism --testTimeout=30000 --hookTimeout=60000"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@moya/agent-authorization": "workspace:*",
    "@moya/api": "workspace:*",
    "@moya/backend-production": "workspace:*",
    "@moya/backend-runtime": "workspace:*",
    "@moya/catalog-importer": "workspace:*",
    "@moya/catalog-postgres": "workspace:*",
    "@moya/community-postgres": "workspace:*",
    "@moya/contracts": "workspace:*",
    "@moya/design-tokens": "workspace:*",
    "@moya/image": "workspace:*",
    "@moya/public-api": "workspace:*",
    "@moya/search": "workspace:*",
    "@moya/ui": "workspace:*",
    "@payloadcms/db-postgres": "3.88.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "admin": "workspace:*",
    "exceljs": "4.4.0",
    "jsdom": "29.1.1",
    "jszip": "3.10.1",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  }
}
